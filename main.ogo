// Command obeam is a BEAM on a Propeller 2: it runs the image package image
// holds, which obeam pack made of modules Erlang's compiler compiled, on
// seven scheduler cogs, and prints what they print on the serial line the
// program was loaded through.
//
// This cog is the eighth: it starts the schedulers, drives the pins for them,
// since a pin driven by several cogs is the OR of what they drive, and prints
// the figures when the entry process has ended.

import (
	"p2"

	"modernc.org/obeam/core"
	"modernc.org/obeam/image"
	"modernc.org/obeam/vm"
)

const schedulers = 7

// servePins does what the VM's ring of pins holds, so that every pin is
// driven by this cog.
func servePins() {
	for {
		op, pin, v, ok := vm.NextPin()
		if !ok {
			return
		}
		switch op {
		case vm.PinHighOp:
			p2.PinHigh(pin)
		case vm.PinLowOp:
			p2.PinLow(pin)
		case vm.PinToggleOp:
			p2.PinToggle(pin)
		case vm.PinFloatOp:
			p2.PinFloat(pin)
		case vm.PinWriteOp:
			p2.PinWrite(pin, v)
		case vm.PinInOp:
			vm.PinRead(p2.PinIn(pin))
		}
	}
}

// say writes a string to the serial line, and num a number. The VM's figures
// are written with them rather than printf, whose formatter, floats and all,
// was hub RAM the program has better uses for.
func say(str string) {
	for i := 0; i < len(str); i++ {
		p2.WriteByte(str[i])
	}
}

func num(v uint64) {
	var d [20]byte
	i := len(d)
	for {
		i--
		d[i] = byte('0' + v%10)
		v /= 10
		if v == 0 {
			break
		}
	}
	for ; i < len(d); i++ {
		p2.WriteByte(d[i])
	}
}

func main() {
	vm.CRLF = true
	vm.PinsServed = true
	vm.Core = core.Run

	if image.TableID != vm.TableID {
		say("obeam: the image was packed for other tables than the VM's: make image\r\n")
		return
	}
	vm.Load(image.Code[:], image.Literals[:], image.Atoms[:], image.Funcs[:], image.Funs[:], image.Lines[:], image.Files[:], image.Structs[:])
	say("obeam: ")
	say(image.EntryName)
	say(", ")
	num(uint64(len(image.Code)))
	say(" longs of code, ")
	num(schedulers)
	say(" schedulers\r\n\r\n")
	t := p2.GetMs()
	if !vm.Start(image.Entry, schedulers) {
		say("no room for the first process\r\n")
		return
	}
	for !vm.Finished() {
		servePins()
	}
	for vm.Running() > 0 {
		servePins()
	}
	t = p2.GetMs() - t
	say("\r\n")
	num(uint64(vm.Steps()))
	say(" instructions in ")
	num(uint64(t))
	say(" ms")
	if t > 0 {
		say(", ")
		num(uint64(vm.Steps()) * 1000 / uint64(t))
		say(" a second")
	}
	say(", ")
	num(uint64(vm.Collections()))
	say(" collections, the core run ")
	num(uint64(vm.CoreRuns()))
	say(" times")
	if !vm.Succeeded() {
		say("; the process failed")
	}
	say("\r\n")
}
