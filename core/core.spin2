' select_val V F N pairs: a value that is no structure equals a case's only
' as the same word.
.op_select_val
        rdlong  q_v, ptrb[1]
        mov     q_t, q_v
        and     q_t, #7
        cmp     q_t, #7 wz
 if_z   test    q_v, #8 wc
 if_z   shr     q_v, #4
 if_c_and_z add q_v, q_stop
 if_c_and_z add q_v, #1
 if_z   shl     q_v, #2
 if_c_and_z add q_v, q_arena
 if_nc_and_z add q_v, q_x
 if_z   rdlong  q_v, q_v
        mov     q_t, q_v
        and     q_t, #3
        cmp     q_t, #1 wz
 if_nz  cmp     q_t, #2 wz
 if_z   jmp     #.back
        rdlong  q_n, ptrb[3]
        shr     q_n, #1 wz
        mov     q_d, ptrb
        add     q_d, #16
 if_z   jmp     #.selno
.sell   rdlong  q_t, q_d
        cmp     q_t, q_v wz
 if_z   jmp     #.selyes
        add     q_d, #8
        djnz    q_n, #.sell
.selno  rdlong  q_t, ptrb[2]
        jmp     #.jump
.selyes add     q_d, #4
        rdlong  q_t, q_d
        jmp     #.jump

