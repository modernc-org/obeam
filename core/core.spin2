 if_z   shl     q_v, #2
 if_c_and_z add q_v, q_arena
 if_nc_and_z add q_v, q_x
 if_z   rdlong  q_v, q_v
        test    q_a, #3 wz
 if_z   test    q_v, #3 wz
 if_nz  jmp     #.back
        cmp     q_a, q_v wz
 if_nz  jmp     #.fail
        add     ptrb, #16
        rdlong  q_w, ptrb
        getbyte q_t, q_w, #1
        cmp     q_t, #0 wz
 if_z   jmp     #.out
        add     q_steps, #1
        shl     q_t, #2
        add     q_t, q_tab
        rdlong  q_t, q_t
        jmp     q_t

.op_is_ne
        rdlong  q_v, ptrb[2]
        mov     q_t, q_v
        and     q_t, #7
        cmp     q_t, #7 wz
 if_z   test    q_v, #8 wc
 if_z   shr     q_v, #4
 if_c_and_z add q_v, q_stop
 if_c_and_z add q_v, #1
 if_z   shl     q_v, #2
 if_c_and_z add q_v, q_arena
 if_nc_and_z add q_v, q_x
 if_z   rdlong  q_v, q_v
        mov     q_a, q_v
        rdlong  q_v, ptrb[3]
        mov     q_t, q_v
        and     q_t, #7
        cmp     q_t, #7 wz
 if_z   test    q_v, #8 wc
 if_z   shr     q_v, #4
 if_c_and_z add q_v, q_stop
 if_c_and_z add q_v, #1
 if_z   shl     q_v, #2
 if_c_and_z add q_v, q_arena
 if_nc_and_z add q_v, q_x
 if_z   rdlong  q_v, q_v
        test    q_a, #3 wz
 if_z   test    q_v, #3 wz
 if_nz  jmp     #.back
        cmp     q_a, q_v wz
 if_z   jmp     #.fail
        add     ptrb, #16
        rdlong  q_w, ptrb
        getbyte q_t, q_w, #1
        cmp     q_t, #0 wz
 if_z   jmp     #.out
        add     q_steps, #1
        shl     q_t, #2
        add     q_t, q_tab
        rdlong  q_t, q_t
        jmp     q_t

' The exact comparisons: the same word is the same term, and different words
' are different terms but of two structures of one kind, which are OctoGo's.
.op_is_eq_exact
        rdlong  q_v, ptrb[2]
        mov     q_t, q_v
        and     q_t, #7
        cmp     q_t, #7 wz
 if_z   test    q_v, #8 wc
 if_z   shr     q_v, #4
 if_c_and_z add q_v, q_stop
 if_c_and_z add q_v, #1
 if_z   shl     q_v, #2
 if_c_and_z add q_v, q_arena
 if_nc_and_z add q_v, q_x
 if_z   rdlong  q_v, q_v
        mov     q_a, q_v
        rdlong  q_v, ptrb[3]
        mov     q_t, q_v
        and     q_t, #7
        cmp     q_t, #7 wz
 if_z   test    q_v, #8 wc
 if_z   shr     q_v, #4
 if_c_and_z add q_v, q_stop
 if_c_and_z add q_v, #1
 if_z   shl     q_v, #2
 if_c_and_z add q_v, q_arena
 if_nc_and_z add q_v, q_x
 if_z   rdlong  q_v, q_v
        cmp     q_a, q_v wz
 if_z   jmp     #.pass2
        mov     q_t, q_a
        xor     q_t, q_v
        and     q_t, #3
        mov     q_n, q_a
        and     q_n, #3
        mov     q_w, q_n
        shr     q_w, #1
        xor     q_n, q_w
        and     q_n, #1
        cmp     q_t, #0 wz
 if_nz  mov     q_n, #0
        cmp     q_n, #0 wz
 if_nz  jmp     #.back
        jmp     #.fail

.op_is_ne_exact
        rdlong  q_v, ptrb[2]
        mov     q_t, q_v
        and     q_t, #7
        cmp     q_t, #7 wz
 if_z   test    q_v, #8 wc
 if_z   shr     q_v, #4
 if_c_and_z add q_v, q_stop
 if_c_and_z add q_v, #1
 if_z   shl     q_v, #2
 if_c_and_z add q_v, q_arena
 if_nc_and_z add q_v, q_x
 if_z   rdlong  q_v, q_v
        mov     q_a, q_v
        rdlong  q_v, ptrb[3]
        mov     q_t, q_v
        and     q_t, #7
        cmp     q_t, #7 wz
 if_z   test    q_v, #8 wc
 if_z   shr     q_v, #4
 if_c_and_z add q_v, q_stop
 if_c_and_z add q_v, #1
 if_z   shl     q_v, #2
 if_c_and_z add q_v, q_arena
 if_nc_and_z add q_v, q_x
 if_z   rdlong  q_v, q_v
        cmp     q_a, q_v wz
 if_z   jmp     #.fail
        mov     q_t, q_a
        xor     q_t, q_v
        and     q_t, #3
        mov     q_n, q_a
        and     q_n, #3
        mov     q_w, q_n
        shr     q_w, #1
        xor     q_n, q_w
        and     q_n, #1
        cmp     q_t, #0 wz
 if_nz  mov     q_n, #0
        cmp     q_n, #0 wz
 if_nz  jmp     #.back
