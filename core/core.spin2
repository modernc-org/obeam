' A boxed term may be an integer of 64 bits: OctoGo's.
.op_is_integer
        rdlong  q_v, ptrb[2]
        mov     q_t, q_v
        and     q_t, #7
        cmp     q_t, #7 wz
 if_z   test    q_v, #8 wc
 if_z   shr     q_v, #4
 if_c_and_z add q_v, q_stop
 if_c_and_z add q_v, #1
 if_z   shl     q_v, #2
 if_c_and_z add q_v, q_arena
 if_nc_and_z add q_v, q_x
 if_z   rdlong  q_v, q_v
        test    q_v, #3 wz
 if_z   jmp     #.pass1
        and     q_v, #3
        cmp     q_v, #2 wz
 if_z   jmp     #.back
        jmp     #.fail

' A tuple's header is its arity above 000111.
.op_is_tuple
        rdlong  q_v, ptrb[2]
        mov     q_t, q_v
        and     q_t, #7
        cmp     q_t, #7 wz
 if_z   test    q_v, #8 wc
 if_z   shr     q_v, #4
 if_c_and_z add q_v, q_stop
 if_c_and_z add q_v, #1
 if_z   shl     q_v, #2
 if_c_and_z add q_v, q_arena
 if_nc_and_z add q_v, q_x
 if_z   rdlong  q_v, q_v
        mov     q_t, q_v
        and     q_t, #3
        cmp     q_t, #2 wz
 if_nz  jmp     #.fail
        andn    q_v, #3
        add     q_v, q_arena
        rdlong  q_v, q_v
        and     q_v, #$3f
        cmp     q_v, #7 wz
 if_nz  jmp     #.fail
        add     ptrb, #12
        rdlong  q_w, ptrb
        getbyte q_t, q_w, #1
        cmp     q_t, #0 wz
 if_z   jmp     #.out
        add     q_steps, #1
        shl     q_t, #2
        add     q_t, q_tab
        rdlong  q_t, q_t
        jmp     q_t

.op_test_arity
        rdlong  q_v, ptrb[2]
        mov     q_t, q_v
        and     q_t, #7
        cmp     q_t, #7 wz
 if_z   test    q_v, #8 wc
 if_z   shr     q_v, #4
 if_c_and_z add q_v, q_stop
 if_c_and_z add q_v, #1
 if_z   shl     q_v, #2
 if_c_and_z add q_v, q_arena
 if_nc_and_z add q_v, q_x
 if_z   rdlong  q_v, q_v
        mov     q_t, q_v
        and     q_t, #3
        cmp     q_t, #2 wz
 if_nz  jmp     #.fail
        andn    q_v, #3
        add     q_v, q_arena
        rdlong  q_v, q_v
        rdlong  q_t, ptrb[3]
        shl     q_t, #6
        or      q_t, #7
        cmp     q_v, q_t wz
 if_nz  jmp     #.fail
        add     ptrb, #16
        rdlong  q_w, ptrb
        getbyte q_t, q_w, #1
        cmp     q_t, #0 wz
 if_z   jmp     #.out
        add     q_steps, #1
        shl     q_t, #2
        add     q_t, q_tab
        rdlong  q_t, q_t
        jmp     q_t

.op_is_tagged_tuple
        rdlong  q_v, ptrb[2]
        mov     q_t, q_v
        and     q_t, #7
        cmp     q_t, #7 wz
 if_z   test    q_v, #8 wc
 if_z   shr     q_v, #4
 if_c_and_z add q_v, q_stop
 if_c_and_z add q_v, #1
 if_z   shl     q_v, #2
 if_c_and_z add q_v, q_arena
 if_nc_and_z add q_v, q_x
 if_z   rdlong  q_v, q_v
        mov     q_t, q_v
        and     q_t, #3
        cmp     q_t, #2 wz
 if_nz  jmp     #.fail
        andn    q_v, #3
        add     q_v, q_arena
        rdlong  q_a, q_v
        rdlong  q_t, ptrb[3]
        shl     q_t, #6
        or      q_t, #7
        cmp     q_a, q_t wz
 if_nz  jmp     #.fail
        add     q_v, #4
        rdlong  q_a, q_v
        rdlong  q_t, ptrb[4]
        cmp     q_a, q_t wz
 if_nz  jmp     #.fail
        add     ptrb, #20
        rdlong  q_w, ptrb
        getbyte q_t, q_w, #1
        cmp     q_t, #0 wz
 if_z   jmp     #.out
        add     q_steps, #1
        shl     q_t, #2
        add     q_t, q_tab
        rdlong  q_t, q_t
        jmp     q_t

' The lists and tuples.
.op_get_list
        rdlong  q_v, ptrb[1]
        mov     q_t, q_v
        and     q_t, #7
        cmp     q_t, #7 wz
 if_z   test    q_v, #8 wc
 if_z   shr     q_v, #4
 if_c_and_z add q_v, q_stop
 if_c_and_z add q_v, #1
 if_z   shl     q_v, #2
 if_c_and_z add q_v, q_arena
 if_nc_and_z add q_v, q_x
 if_z   rdlong  q_v, q_v
        andn    q_v, #3
        add     q_v, q_arena
        mov     q_a, q_v
        rdlong  q_v, q_a
        rdlong  q_d, ptrb[2]
        test    q_d, #8 wc
        shr     q_d, #4
 if_c   add     q_d, q_stop
 if_c   add     q_d, #1
        shl     q_d, #2
 if_c   add     q_d, q_arena
 if_nc  add     q_d, q_x
        wrlong  q_v, q_d
        add     q_a, #4
        rdlong  q_v, q_a
        rdlong  q_d, ptrb[3]
        test    q_d, #8 wc
        shr     q_d, #4
 if_c   add     q_d, q_stop
 if_c   add     q_d, #1
        shl     q_d, #2
 if_c   add     q_d, q_arena
 if_nc  add     q_d, q_x
        wrlong  q_v, q_d
        add     ptrb, #16
        rdlong  q_w, ptrb
        getbyte q_t, q_w, #1
        cmp     q_t, #0 wz
 if_z   jmp     #.out
        add     q_steps, #1
        shl     q_t, #2
        add     q_t, q_tab
        rdlong  q_t, q_t
        jmp     q_t

.op_get_hd
        rdlong  q_v, ptrb[1]
        mov     q_t, q_v
        and     q_t, #7
        cmp     q_t, #7 wz
 if_z   test    q_v, #8 wc
 if_z   shr     q_v, #4
 if_c_and_z add q_v, q_stop
 if_c_and_z add q_v, #1
 if_z   shl     q_v, #2
 if_c_and_z add q_v, q_arena
 if_nc_and_z add q_v, q_x
 if_z   rdlong  q_v, q_v
        andn    q_v, #3
        add     q_v, q_arena
        rdlong  q_v, q_v
        rdlong  q_d, ptrb[2]
        test    q_d, #8 wc
        shr     q_d, #4
 if_c   add     q_d, q_stop
 if_c   add     q_d, #1
        shl     q_d, #2
 if_c   add     q_d, q_arena
 if_nc  add     q_d, q_x
        wrlong  q_v, q_d
        add     ptrb, #12
        rdlong  q_w, ptrb
        getbyte q_t, q_w, #1
        cmp     q_t, #0 wz
 if_z   jmp     #.out
        add     q_steps, #1
        shl     q_t, #2
        add     q_t, q_tab
        rdlong  q_t, q_t
        jmp     q_t

.op_get_tl
        rdlong  q_v, ptrb[1]
        mov     q_t, q_v
        and     q_t, #7
        cmp     q_t, #7 wz
 if_z   test    q_v, #8 wc
 if_z   shr     q_v, #4
 if_c_and_z add q_v, q_stop
 if_c_and_z add q_v, #1
 if_z   shl     q_v, #2
 if_c_and_z add q_v, q_arena
 if_nc_and_z add q_v, q_x
 if_z   rdlong  q_v, q_v
        andn    q_v, #3
        add     q_v, q_arena
        add     q_v, #4
        rdlong  q_v, q_v
        rdlong  q_d, ptrb[2]
        test    q_d, #8 wc
        shr     q_d, #4
 if_c   add     q_d, q_stop
 if_c   add     q_d, #1
        shl     q_d, #2
 if_c   add     q_d, q_arena
 if_nc  add     q_d, q_x
        wrlong  q_v, q_d
        add     ptrb, #12
        rdlong  q_w, ptrb
        getbyte q_t, q_w, #1
        cmp     q_t, #0 wz
 if_z   jmp     #.out
        add     q_steps, #1
        shl     q_t, #2
        add     q_t, q_tab
        rdlong  q_t, q_t
        jmp     q_t

.op_put_list
        mov     q_a, q_htop
        shl     q_a, #2
        add     q_a, q_arena
        rdlong  q_v, ptrb[1]
        mov     q_t, q_v
        and     q_t, #7
        cmp     q_t, #7 wz
 if_z   test    q_v, #8 wc
 if_z   shr     q_v, #4
 if_c_and_z add q_v, q_stop
 if_c_and_z add q_v, #1
 if_z   shl     q_v, #2
 if_c_and_z add q_v, q_arena
 if_nc_and_z add q_v, q_x
 if_z   rdlong  q_v, q_v
        wrlong  q_v, q_a
        add     q_a, #4
        rdlong  q_v, ptrb[2]
        mov     q_t, q_v
        and     q_t, #7
        cmp     q_t, #7 wz
 if_z   test    q_v, #8 wc
 if_z   shr     q_v, #4
 if_c_and_z add q_v, q_stop
 if_c_and_z add q_v, #1
 if_z   shl     q_v, #2
 if_c_and_z add q_v, q_arena
 if_nc_and_z add q_v, q_x
 if_z   rdlong  q_v, q_v
        wrlong  q_v, q_a
        mov     q_v, q_htop
        shl     q_v, #2
        or      q_v, #1
        add     q_htop, #2
        rdlong  q_d, ptrb[3]
        test    q_d, #8 wc
        shr     q_d, #4
 if_c   add     q_d, q_stop
 if_c   add     q_d, #1
        shl     q_d, #2
 if_c   add     q_d, q_arena
 if_nc  add     q_d, q_x
        wrlong  q_v, q_d
        add     ptrb, #16
        rdlong  q_w, ptrb
        getbyte q_t, q_w, #1
        cmp     q_t, #0 wz
 if_z   jmp     #.out
        add     q_steps, #1
        shl     q_t, #2
        add     q_t, q_tab
        rdlong  q_t, q_t
        jmp     q_t

' put_tuple2 D N e...: the header, the elements, the term to D.
.op_put_tuple2
        rdlong  q_n, ptrb[2]
        mov     q_a, q_htop
        shl     q_a, #2
        add     q_a, q_arena
        mov     q_t, q_n
        shl     q_t, #6
        or      q_t, #7
        wrlong  q_t, q_a
        mov     q_w, q_htop
        add     q_htop, q_n
        add     q_htop, #1
        mov     q_d, ptrb
        add     q_d, #12
        cmp     q_n, #0 wz
 if_z   jmp     #.ptdone
.ptl    add     q_a, #4
        rdlong  q_v, q_d
        mov     q_t, q_v
        and     q_t, #7
        cmp     q_t, #7 wz
 if_z   test    q_v, #8 wc
 if_z   shr     q_v, #4
 if_c_and_z add q_v, q_stop
 if_c_and_z add q_v, #1
 if_z   shl     q_v, #2
 if_c_and_z add q_v, q_arena
 if_nc_and_z add q_v, q_x
 if_z   rdlong  q_v, q_v
        wrlong  q_v, q_a
        add     q_d, #4
        djnz    q_n, #.ptl
.ptdone mov     q_n, q_d
        mov     q_v, q_w
        shl     q_v, #2
        or      q_v, #2
        rdlong  q_d, ptrb[1]
        test    q_d, #8 wc
        shr     q_d, #4
 if_c   add     q_d, q_stop
 if_c   add     q_d, #1
        shl     q_d, #2
 if_c   add     q_d, q_arena
 if_nc  add     q_d, q_x
        wrlong  q_v, q_d
        mov     ptrb, q_n
        rdlong  q_w, ptrb
        getbyte q_t, q_w, #1
        cmp     q_t, #0 wz
 if_z   jmp     #.out
        add     q_steps, #1
        shl     q_t, #2
        add     q_t, q_tab
        rdlong  q_t, q_t
        jmp     q_t

.op_get_tuple_element
        rdlong  q_v, ptrb[1]
        mov     q_t, q_v
        and     q_t, #7
        cmp     q_t, #7 wz
 if_z   test    q_v, #8 wc
 if_z   shr     q_v, #4
 if_c_and_z add q_v, q_stop
 if_c_and_z add q_v, #1
 if_z   shl     q_v, #2
 if_c_and_z add q_v, q_arena
 if_nc_and_z add q_v, q_x
 if_z   rdlong  q_v, q_v
        andn    q_v, #3
        add     q_v, q_arena
        rdlong  q_t, ptrb[2]
        add     q_t, #1
        shl     q_t, #2
        add     q_v, q_t
        rdlong  q_v, q_v
        rdlong  q_d, ptrb[3]
        test    q_d, #8 wc
        shr     q_d, #4
 if_c   add     q_d, q_stop
 if_c   add     q_d, #1
        shl     q_d, #2
 if_c   add     q_d, q_arena
 if_nc  add     q_d, q_x
        wrlong  q_v, q_d
        add     ptrb, #16
        rdlong  q_w, ptrb
        getbyte q_t, q_w, #1
        cmp     q_t, #0 wz
 if_z   jmp     #.out
        add     q_steps, #1
        shl     q_t, #2
        add     q_t, q_tab
        rdlong  q_t, q_t
        jmp     q_t

' The way out: .back leaves the instruction at PTRA to OctoGo, uncounted.
.back   sub     q_steps, #1
.out    mov     q_t, ptrb
        sub     q_t, q_code
        shr     q_t, #2
        mov     r, q_t
        mov     ptrb, blk
        wrlong  q_t, ptrb[0]
        wrlong  q_stop, ptrb[4]
        wrlong  q_htop, ptrb[5]
        wrlong  q_cp, ptrb[6]
        wrlong  q_reds, ptrb[7]
        wrlong  q_steps, ptrb[9]
        mov     ptrb, q_sp
  end
