// Floats: the board's 32-bit floats, boxed with one long of payload, the
// float instructions over the scheduler's float registers, and the BIFs of
// arithmetic, conversion and the math module. The float64 the code computes
// in is 32 bits wide on the board and 64 on the host, so a value that is not
// exact in 32 bits may differ in its last digits between the two; the corpus
// keeps to values that are.

import (
	"math"
	"unsafe"
)

const maxFR = 8 // float registers

// floatBits returns a float's IEEE bits, and floatOf a float of its bits.
func floatBits(f float32) uint32 {
	return *(*uint32)(unsafe.Pointer(&f))
}

func floatOf(u uint32) float32 {
	return *(*float32)(unsafe.Pointer(&u))
}

// mkFloat boxes a float on the heap; the caller has made room for two longs.
func mkFloat(s *sched, f float32) uint32 {
	i := s.cur.htop
	arena[i] = mkHeader(hdrFloat, 1)
	arena[i+1] = floatBits(f)
	s.cur.htop += 2
	return mkBoxed(i)
}

// floatResult boxes a float, making room, and fails with badarith for one
// that is not a number.
func floatResult(s *sched, f float64) uint32 {
	if math.IsNaN(f) || math.IsInf(f, 0) {
		return badarith(s)
	}
	if !ensure(s, 2, s.curLive) {
		return nonValue
	}
	return mkFloat(s, float32(f))
}

// numVal returns a number as a float64.
func numVal(t uint32) float64 {
	if isFloat(t) {
		return float64(floatVal(t))
	}
	return float64(intVal(t))
}

// The float instructions. A register operand is its number; fmove boxes or
// unboxes as its operands say, fconv takes any number.

func hFmove(s *sched, pc uint32) uint32 {
	a, b := code[pc+1], code[pc+2]
	if b&7 == 7 { // to a register: the source is a float register
		if !ensure(s, 2, int32(maxX)) {
			return raiseAtom(s, atomError, atomSystemLimit)
		}
		store(s, b, mkFloat(s, s.fr[a]))
		return pc + 3
	}
	s.fr[b] = floatVal(src(s, a))
	return pc + 3
}

func hFconv(s *sched, pc uint32) uint32 {
	v := src(s, code[pc+1])
	if !isNumber(v) {
		return raiseAtom(s, atomError, atomBadarith)
	}
	s.fr[code[pc+2]] = float32(numVal(v))
	return pc + 3
}

// farith does fadd, fsub, fmul and fdiv: Fail FR1 FR2 FRd; a result that is
// no number is badarith.
func farith(s *sched, pc uint32, op byte) uint32 {
	a, b := float64(s.fr[code[pc+2]]), float64(s.fr[code[pc+3]])
	var r float64
	switch op {
	case '+':
		r = a + b
	case '-':
		r = a - b
	case '*':
		r = a * b
	default:
		if b == 0 {
			return raiseAtom(s, atomError, atomBadarith)
		}
		r = a / b
	}
	f := float32(r)
	if math.IsNaN(float64(f)) || math.IsInf(float64(f), 0) {
		return raiseAtom(s, atomError, atomBadarith)
	}
	s.fr[code[pc+4]] = f
	return pc + 5
}

func hFadd(s *sched, pc uint32) uint32 { return farith(s, pc, '+') }
func hFsub(s *sched, pc uint32) uint32 { return farith(s, pc, '-') }
func hFmul(s *sched, pc uint32) uint32 { return farith(s, pc, '*') }
func hFdiv(s *sched, pc uint32) uint32 { return farith(s, pc, '/') }

func hFnegate(s *sched, pc uint32) uint32 {
	s.fr[code[pc+3]] = -s.fr[code[pc+2]]
	return pc + 4
}

// The BIFs.

// bifFdiv is /, which is a float however its arguments are.
func bifFdiv(s *sched, n uint32) uint32 {
	a, b := s.bargs[0], s.bargs[1]
	if !isNumber(a) || !isNumber(b) {
		return badarith(s)
	}
	d := numVal(b)
	if d == 0 {
		return badarith(s)
	}
	return floatResult(s, numVal(a)/d)
}

func bifFloat(s *sched, n uint32) uint32 {
	a := s.bargs[0]
	if !isNumber(a) {
		return badarg(s)
	}
	if isFloat(a) {
		return a
	}
	return floatResult(s, float64(intVal(a)))
}

// bifTrunc, bifRound, bifFloor and bifCeil: an integer is itself; a float
// past 63 bits is system_limit, where Erlang has a bignum. Floor and ceil go
// from trunc, one down or up.
func bifTrunc(s *sched, n uint32) uint32 { return toInt(s, 't') }
func bifRound(s *sched, n uint32) uint32 { return toInt(s, 'r') }
func bifFloor(s *sched, n uint32) uint32 { return toInt(s, 'f') }
func bifCeil(s *sched, n uint32) uint32  { return toInt(s, 'c') }

func toInt(s *sched, how byte) uint32 {
	a := s.bargs[0]
	if !isNumber(a) {
		return badarg(s)
	}
	if !isFloat(a) {
		return a
	}
	x := float64(floatVal(a))
	t := math.Trunc(x)
	switch {
	case how == 'r':
		t = math.Round(x)
	case how == 'f' && t > x:
		t--
	case how == 'c' && t < x:
		t++
	}
	return floatToInt(s, t)
}

func floatToInt(s *sched, f float64) uint32 {
	if f >= 9223372036854775807 || f <= -9223372036854775808 {
		return failAtom(s, atomSystemLimit)
	}
	return intResult(s, int64(f))
}

// The math module, over OctoGo's, which is 32-bit on the board.

func mathArg(s *sched) (float64, bool) {
	if !isNumber(s.bargs[0]) {
		return 0, false
	}
	return numVal(s.bargs[0]), true
}

func bifMathSqrt(s *sched, n uint32) uint32 {
	x, ok := mathArg(s)
	if !ok || x < 0 {
		return badarith(s)
	}
	return floatResult(s, math.Sqrt(x))
}

func bifMathPow(s *sched, n uint32) uint32 {
	if !isNumber(s.bargs[0]) || !isNumber(s.bargs[1]) {
		return badarith(s)
	}
	return floatResult(s, math.Pow(numVal(s.bargs[0]), numVal(s.bargs[1])))
}

func bifMathPi(s *sched, n uint32) uint32 { return floatResult(s, math.Pi) }

// Writing floats as Erlang's ~w does: the fewest digits that read back as
// the same float, in the shorter of the plain form, 123.45, and the exponent
// form, 1.2345e2, the plain one on a tie. The digits are found in exact
// integers: the board's float64 is 32 bits wide, and scaling a float by
// tens in it loses what the digits are meant to keep.

// natLen longs hold every integer the digit search meets: a 32-bit float's
// value times a power of ten of the same size stays below 2^200.
const natLen = 7

// A nat is a natural number of natLen longs, the low one first.
type nat struct {
	w [natLen]uint32
}

func natSet(z *nat, v uint32) {
	for i := range z.w {
		z.w[i] = 0
	}
	z.w[0] = v
}

// natShl shifts z left by n bits.
func natShl(z *nat, n uint32) {
	for n >= 32 {
		for i := natLen - 1; i > 0; i-- {
			z.w[i] = z.w[i-1]
		}
		z.w[0] = 0
		n -= 32
	}
	if n == 0 {
		return
	}
	for i := natLen - 1; i > 0; i-- {
		z.w[i] = z.w[i]<<n | z.w[i-1]>>(32-n)
	}
	z.w[0] <<= n
}

// natMul10 sets z to ten times z, and a more.
func natMul10(z *nat, a uint32) {
	carry := uint64(a)
	for i := 0; i < natLen; i++ {
		t := uint64(z.w[i])*10 + carry
		z.w[i] = uint32(t)
		carry = t >> 32
	}
}

// natAdd sets z to x + y.
func natAdd(z, x, y *nat) {
	carry := uint64(0)
	for i := 0; i < natLen; i++ {
		t := uint64(x.w[i]) + uint64(y.w[i]) + carry
		z.w[i] = uint32(t)
		carry = t >> 32
	}
}

// natSub subtracts x from z, which is not less than x.
func natSub(z, x *nat) {
	borrow := uint64(0)
	for i := 0; i < natLen; i++ {
		t := uint64(z.w[i]) - uint64(x.w[i]) - borrow
		z.w[i] = uint32(t)
		borrow = t >> 63
	}
}

func natCmp(x, y *nat) int {
	for i := natLen - 1; i >= 0; i-- {
		if x.w[i] != y.w[i] {
			if x.w[i] < y.w[i] {
				return -1
			}
			return 1
		}
	}
	return 0
}

// shortest finds the fewest decimal digits that read back as the positive
// 32-bit float of the bits u, by the free-format algorithm of Steele and
// White as Burger and Dybvig give it: d gets the digits, and it answers how
// many and the decimal exponent of the first. The value lies between r - m-
// and r + m+ over s, scaled so that its first digit comes out first; a
// boundary counts as the float's when its mantissa is even, as rounding to
// even reads it back.
func shortest(s *sched, u uint32, d *[12]byte) (int, int) {
	f, e := floatParts(u)
	even := f&1 == 0
	r, sc, mp, mm, t := &s.dr, &s.ds, &s.dmp, &s.dmm, &s.dt
	pow2 := f == 0x800000 && e > -149 // the gap below is half the gap above
	if e >= 0 {
		natSet(r, f)
		natSet(mp, 1)
		natSet(mm, 1)
		natShl(mm, uint32(e))
		if pow2 {
			natShl(r, uint32(e)+2)
			natSet(sc, 4)
			natShl(mp, uint32(e)+1)
		} else {
			natShl(r, uint32(e)+1)
			natSet(sc, 2)
			natShl(mp, uint32(e))
		}
	} else {
		natSet(r, f)
		natSet(sc, 1)
		natSet(mm, 1)
		if pow2 {
			natShl(r, 2)
			natShl(sc, uint32(2-e))
			natSet(mp, 2)
		} else {
			natShl(r, 1)
			natShl(sc, uint32(1-e))
			natSet(mp, 1)
		}
	}
	k := 0
	for {
		natAdd(t, r, mp)
		c := natCmp(t, sc)
		if c < 0 || c == 0 && !even {
			break
		}
		natMul10(sc, 0)
		k++
	}
	for {
		natAdd(t, r, mp)
		natMul10(t, 0)
		c := natCmp(t, sc)
		if c > 0 || c == 0 && even {
			break
		}
		natMul10(r, 0)
		natMul10(mp, 0)
		natMul10(mm, 0)
		k--
	}
	n := 0
	for n < len(d) {
		natMul10(r, 0)
		natMul10(mp, 0)
		natMul10(mm, 0)
		dig := byte(0)
		for natCmp(r, sc) >= 0 {
			natSub(r, sc)
			dig++
		}
		c1 := natCmp(r, mm)
		low := c1 < 0 || c1 == 0 && even
		natAdd(t, r, mp)
		c2 := natCmp(t, sc)
		high := c2 > 0 || c2 == 0 && even
		if !low && !high {
			d[n] = '0' + dig
			n++
			continue
		}
		if low && high {
			// The nearer of the two, and the even one on a tie, as Go's
			// strconv and Erlang's own printing choose.
			natAdd(t, r, r)
			if c := natCmp(t, sc); c > 0 || c == 0 && dig&1 != 0 {
				dig++
			}
		} else if high {
			dig++
		}
		d[n] = '0' + dig
		n++
		break
	}
	return n, k - 1
}

// writeFloat writes a float as ~w does.
func writeFloat(s *sched, f float32) {
	u := floatBits(f)
	if u&0x7fffffff == 0 {
		if u != 0 {
			emit(s, '-')
		}
		emits(s, "0.0")
		return
	}
	if u>>31 != 0 {
		emit(s, '-')
	}
	var d [12]byte
	n, e := shortest(s, u&0x7fffffff, &d)
	// The plain form's length against the exponent form's.
	plain := 0
	if e >= 0 {
		plain = e + 1
		if n > e+1 {
			plain += 1 + n - (e + 1)
		} else {
			plain += 2
		}
	} else {
		plain = 2 + (-e - 1) + n
	}
	expo := 1 + 1 + 2 + n - 1
	if n == 1 {
		expo = 5
	}
	ex := e
	if ex < 0 {
		ex = -ex
		expo++
	}
	for ex >= 10 {
		expo++
		ex /= 10
	}
	if plain <= expo {
		if e >= 0 {
			for k := 0; k <= e; k++ {
				if k < n {
					emit(s, d[k])
				} else {
					emit(s, '0')
				}
			}
			emit(s, '.')
			if n > e+1 {
				for k := e + 1; k < n; k++ {
					emit(s, d[k])
				}
			} else {
				emit(s, '0')
			}
		} else {
			emits(s, "0.")
			for k := 0; k < -e-1; k++ {
				emit(s, '0')
			}
			for k := 0; k < n; k++ {
				emit(s, d[k])
			}
		}
		return
	}
	emit(s, d[0])
	emit(s, '.')
	if n > 1 {
		for k := 1; k < n; k++ {
			emit(s, d[k])
		}
	} else {
		emit(s, '0')
	}
	emit(s, 'e')
	writeInt(s, int64(e))
}

// ~e, ~f and ~g, as OTP's io_lib_format writes them: from the 21 significant
// digits float_to_list/1 writes, rounded half up again to as many as the
// directive asks for, and 0s past the 21st. A float exact in 32 bits is the
// same number in 64, so the board and erl write the same for it.

// fdLen is how many significant digits float_to_list/1 writes.
const fdLen = 21

// floatParts answers the mantissa and the exponent of the positive float of
// the bits u: its value is f times 2^e.
func floatParts(u uint32) (uint32, int) {
	if u>>23 == 0 {
		return u, -149
	}
	return u&0x7fffff | 0x800000, int(u>>23) - 150
}

// natScale sets the scheduler's r over sc to f times 2^e, f not 0, scaled by
// tens until it is from 0.1 up to 1, and answers k: the value is r/sc times
// 10^k.
func natScale(s *sched, f uint32, e int) int {
	r, sc, t := &s.dr, &s.ds, &s.dt
	natSet(r, f)
	natSet(sc, 1)
	if e >= 0 {
		natShl(r, uint32(e))
	} else {
		natShl(sc, uint32(-e))
	}
	k := 0
	for natCmp(r, sc) >= 0 {
		natMul10(sc, 0)
		k++
	}
	for {
		*t = *r
		natMul10(t, 0)
		if natCmp(t, sc) >= 0 {
			return k
		}
		*r = *t
		k--
	}
}

// natDigit answers the next decimal digit of r over sc, leaving the rest.
func natDigit(s *sched) byte {
	r, sc := &s.dr, &s.ds
	natMul10(r, 0)
	d := byte(0)
	for natCmp(r, sc) >= 0 {
		natSub(r, sc)
		d++
	}
	return d
}

// fdigits writes the first fdLen significant digits of the magnitude of a
// float into d, rounded half to even from its exact value, as C's printf
// rounds them for OTP's float_to_list/1, and answers the decimal exponent of
// the first: 1.5 is 15000... and 0, and zero is all 0s and 0.
func fdigits(s *sched, f float32, d *[fdLen]byte) int {
	u := floatBits(f) & 0x7fffffff
	if u == 0 {
		for i := range d {
			d[i] = 0
		}
		return 0
	}
	m, e := floatParts(u)
	k := natScale(s, m, e)
	for i := 0; i < fdLen; i++ {
		d[i] = natDigit(s)
	}
	natAdd(&s.dt, &s.dr, &s.dr)
	if c := natCmp(&s.dt, &s.ds); c > 0 || c == 0 && d[fdLen-1]&1 != 0 {
		i := fdLen - 1
		for i >= 0 && d[i] == 9 {
			d[i] = 0
			i--
		}
		if i < 0 {
			d[0] = 1
			k++
		} else {
			d[i]++
		}
	}
	return k - 1
}

// fdig answers digit i of d with z 0s before them and 0s after.
func fdig(d *[fdLen]byte, z, i int) byte {
	i -= z
	if i < 0 || i >= fdLen {
		return 0
	}
	return d[i]
}

// writeMant writes ip+dp digits of d with z 0s before them, a point after the
// first ip, rounded half up on the next digit, as OTP's float_man does. When
// the rounding carries out of the first digit, they are all 0s, a 1 is
// written before them, or in the first one's place when one is set, and it
// answers true.
func writeMant(s *sched, d *[fdLen]byte, z, ip, dp int, one bool) bool {
	n := ip + dp
	up := fdig(d, z, n) >= 5
	last := n - 1
	for up && last >= 0 && fdig(d, z, last) == 9 {
		last--
	}
	carry := up && last < 0
	if carry && !one {
		emit(s, '1')
	}
	for i := 0; i < n; i++ {
		if i == ip {
			emit(s, '.')
		}
		c := fdig(d, z, i)
		if up && i > last {
			c = 0
		} else if up && i == last {
			c++
		}
		if carry && one && i == 0 {
			c = 1
		}
		emit(s, '0'+c)
	}
	return carry
}

// writeSign writes the minus of a negative float, -0.0's too, as OTP does.
func writeSign(s *sched, f float32) {
	if floatBits(f)>>31 != 0 {
		emit(s, '-')
	}
}

// writeFixed writes a float with prec digits after the point, as ~f does.
func writeFixed(s *sched, f float32, prec int) {
	var d [fdLen]byte
	writeSign(s, f)
	x := fdigits(s, f, &d) + 1
	z := 0
	if x <= 0 {
		z = 1 - x
		x = 1
	}
	writeMant(s, &d, z, x, prec, false)
}

// writeExp writes a float with prec significant digits in the exponent form,
// as ~e does: 1.00000e+1.
func writeExp(s *sched, f float32, prec int) {
	var d [fdLen]byte
	writeSign(s, f)
	e := fdigits(s, f, &d)
	if writeMant(s, &d, 0, 1, prec-1, true) {
		e++
	}
	emit(s, 'e')
	if e >= 0 {
		emit(s, '+')
	}
	writeInt(s, int64(e))
}

// writeGeneral writes as ~g does: ~f with prec significant digits from 0.1
// up to 10000, ~e otherwise, by io_lib_format's rule.
func writeGeneral(s *sched, f float32, prec int) {
	a := f
	if a < 0 {
		a = -a
	}
	e := 4 // from 10000 up
	switch {
	case a < 0.1:
		e = -2
	case a < 1:
		e = -1
	case a < 10:
		e = 0
	case a < 100:
		e = 1
	case a < 1000:
		e = 2
	case a < 10000:
		e = 3
	}
	switch {
	case prec <= 1 && e == -1 || prec-1 > e && e >= -1 && e < 4:
		writeFixed(s, f, prec-1-e)
	case prec <= 1:
		writeExp(s, f, 2)
	default:
		writeExp(s, f, prec)
	}
}

// Reading a float, list_to_float/1's, which erlang.erl's shim parses: the
// largest float not past the decimal is found by halving the range of the
// floats' bits, a float compared with the decimal digit by digit, as fdigits
// writes them, and then the decimal with the midpoint above that float, a
// tie going to the even one. It is exact for any number of digits, and slow:
// thirty-one comparisons.

// cmpDec compares f times 2^e with the decimal 0.D times 10^k, D the digits
// of the list t, the first not 0: less than 0, 0 or more as the first is
// less, equal or greater.
func cmpDec(s *sched, f uint32, e int, t uint32, k int) int {
	if f == 0 {
		return -1
	}
	if c := natScale(s, f, e) - k; c != 0 {
		return c
	}
	for ; isCons(t); t = arena[consIdx(t)+1] {
		if c := int(natDigit(s)) - int(smallVal(arena[consIdx(t)])-'0'); c != 0 {
			return c
		}
	}
	for _, w := range s.dr.w {
		if w != 0 {
			return 1 // a rest past the decimal's digits
		}
	}
	return 0
}

// bifFloatOf is erlang:'$float'/2, which erlang.erl's list_to_float/1 calls
// with the significant digits, a list of characters the first not 0, and k:
// the float nearest 0.D times 10^k, or badarg past the largest. What is no
// list of digits makes a float of no meaning, and no harm.
func bifFloatOf(s *sched, n uint32) uint32 {
	k := s.bargs[1]
	if !isSmall(k) {
		return badarg(s)
	}
	u, ok := readFloat(s, s.bargs[0], int(smallVal(k)))
	if !ok {
		return badarg(s)
	}
	if !ensure(s, 2, s.curLive) {
		return nonValue
	}
	return mkFloat(s, floatOf(u))
}

// readFloat answers the bits of the float nearest 0.D times 10^k, ties to
// even, or false past the largest float.
func readFloat(s *sched, t uint32, k int) (uint32, bool) {
	u := uint32(0)
	if !isCons(t) {
		return u, true
	}
	hi := uint32(0x7f800000) // the infinity, past every decimal
	for hi-u > 1 {
		mid := u + (hi-u)/2
		if f, e := floatParts(mid); cmpDec(s, f, e, t, k) <= 0 {
			u = mid
		} else {
			hi = mid
		}
	}
	f, e := floatParts(u)
	if c := cmpDec(s, 2*f+1, e-1, t, k); c < 0 || c == 0 && u&1 != 0 {
		u++
	}
	return u, u != 0x7f800000
}
