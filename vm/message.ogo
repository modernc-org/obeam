// Messages: a term is copied into a fragment, a block of the pool, which is
// appended to the receiver's mailbox; the receiver reads it there, and the
// fragment goes to the heap at the receiver's next collection. A fragment's
// first longs are the link to the next, its order, and the message. The copy
// shares nothing but the literals, as Erlang's does.

const fragHead = 3

const msgDepth = 128

// termSize returns how many longs a copy of a term takes, counting a shared
// part once for each reference, as the copy does. It is -1 for a term nested
// deeper than the stack goes.
func termSize(s *sched, t uint32) int32 {
	size := int32(0)
	sp := 0
	for {
		for {
			if t&3 == tagList {
				i := consIdx(t)
				if i < litEnd {
					break
				}
				size += 2
				if sp == msgDepth {
					return -1
				}
				s.msgStack[sp] = arena[i]
				sp++
				t = arena[i+1]
				continue
			}
			if t&3 == tagBoxed {
				i := boxIdx(t)
				if i < litEnd {
					break
				}
				h := arena[i]
				n := hdrSize(h)
				size += int32(1 + n)
				first := uint32(1)
				if hdrKind(h) == hdrFun {
					first = 1 + funHeadLongs
				}
				if hdrKind(h) == hdrTuple || hdrKind(h) == hdrFun {
					for k := first; k <= n; k++ {
						if sp == msgDepth {
							return -1
						}
						s.msgStack[sp] = arena[i+k]
						sp++
					}
				}
			}
			break
		}
		if sp == 0 {
			return size
		}
		sp--
		t = s.msgStack[sp]
	}
}

// copyTerm copies a term to the longs from dst on, the room having been made
// by termSize, and returns the copy's term and the long after it. What is in
// the literal heap is shared, nothing else.
func copyTerm(s *sched, t, dst uint32) (uint32, uint32) {
	s.cpTo = dst
	root := copyObj(s, t)
	for scan := dst; scan < s.cpTo; {
		w := arena[scan]
		if w&7 == 7 {
			switch hdrKind(w) {
			case hdrTuple:
				scan++
			case hdrFun:
				scan += 1 + funHeadLongs
			default:
				scan += 1 + hdrSize(w)
			}
			continue
		}
		arena[scan] = copyObj(s, w)
		scan++
	}
	return root, s.cpTo
}

// copyObj copies the one object a term points to, if it is not a literal,
// and returns the term of the copy.
func copyObj(s *sched, t uint32) uint32 {
	switch t & 3 {
	case tagList:
		i := consIdx(t)
		if i < litEnd {
			return t
		}
		n := s.cpTo
		arena[n] = arena[i]
		arena[n+1] = arena[i+1]
		s.cpTo += 2
		return mkCons(n)
	case tagBoxed:
		i := boxIdx(t)
		if i < litEnd {
			return t
		}
		size := hdrSize(arena[i]) + 1
		n := s.cpTo
		for k := uint32(0); k < size; k++ {
			arena[n+k] = arena[i+k]
		}
		s.cpTo += size
		return mkBoxed(n)
	}
	return t
}

// sendMsg sends a message to a pid, or to the process registered under an
// atom: it is copied into a fragment and appended to the receiver's mailbox,
// and the receiver is woken if it waits. A message to a process that is gone
// is dropped. It fails for what is no pid and no registered name, and for a
// message there is no room for.
func sendMsg(s *sched, to, msg uint32) bool {
	if isAtom(to) {
		pid, ok := whereis(to)
		if !ok {
			badarg(s)
			return false
		}
		to = pid
	}
	if !isPid(to) {
		badarg(s)
		return false
	}
	if !deliver(s, to, msg, kindMessage) {
		failAtom(s, atomSystemLimit)
		return false
	}
	return true
}

// fragAlloc takes a block for a fragment; it also says whether the pool has
// run low. A cache of the smallest blocks, one per scheduler, was tried and
// taken out: the blocks it held, scattered through the arena, kept their
// buddies from joining, and the pool, nearly three quarters free, had no
// block above 256 longs left.
func fragAlloc(s *sched, order uint32) (uint32, bool) {
	return allocBlockLow(order)
}

// fragFree gives a fragment's block back to the pool.
func fragFree(s *sched, b, order uint32) {
	freeBlock(b, order)
}

// freeFragments gives a list of fragments back to the pool.
func freeFragments(s *sched, b uint32) {
	for b != noBlock {
		next := arena[b]
		fragFree(s, b, fragOrder(b))
		b = next
	}
}

// takeMessage takes the message a receive is looking at out of the mailbox:
// its fragment goes to the pending list, and the receive begins again at the
// head.
func takeMessage(s *sched) {
	p := s.cur
	lock(stripe(p))
	c := p.mboxCur
	next := arena[c]
	if p.mboxPrev == noBlock {
		p.mboxHead = next
	} else {
		arena[p.mboxPrev] = next
	}
	if p.mboxTail == c {
		p.mboxTail = p.mboxPrev
	}
	p.mboxCur = p.mboxHead
	p.mboxPrev = noBlock
	p.timed = false
	low := p.lowMem
	p.lowMem = false
	unlock(stripe(p))
	arena[c] = p.pending
	p.pending = c
	p.npending++
	if p.npending >= maxPending || low {
		p.forceGC = true
	}
}

// inPending reports whether an arena index is in one of the running
// process's pending fragments.
func inPending(s *sched, i uint32) bool {
	for b := s.cur.pending; b != noBlock; b = arena[b] {
		if i >= b && i < b+1<<fragOrder(b) {
			return true
		}
	}
	return false
}
