// Exceptions and their reports. There is no catch yet: an exception ends the
// process, after a report in the shape Erlang's shell prints. A reason of the
// shape {Tag, Value} is not built as a term, nothing being there to catch it;
// the report writes the two.

const noTag = 0xffffffff

// failWith fails a BIF with a class and a reason.
func failWith(s *sched, class, reason uint32) uint32 {
	s.bifClass = class
	s.bifReason = reason
	s.bifTag = noTag
	return nonValue
}

func failAtom(s *sched, reason uint32) uint32 { return failWith(s, atomError, mkAtom(reason)) }
func badarg(s *sched) uint32                  { return failAtom(s, atomBadarg) }
func badarith(s *sched) uint32                { return failAtom(s, atomBadarith) }

// raise ends the running process with an exception of a class, an atom
// index, and a reason; raiseAtom with an atom reason, raiseTagged with a
// reason {Tag, V}.
func raise(s *sched, class, reason uint32) {
	s.bifTag = noTag
	report(s, class, reason)
	s.cur.exit(procFailed)
	s.left = leftFail
}

func raiseAtom(s *sched, class, reason uint32) { raise(s, mkAtom(class), mkAtom(reason)) }

func raiseTagged(s *sched, class, tag, v uint32) {
	s.bifTag = tag
	report(s, mkAtom(class), v)
	s.cur.exit(procFailed)
	s.left = leftFail
}

// report writes what the shell would: the class, the reason explained, and
// the function and line the process was in, under the output's lock.
func report(s *sched, class, reason uint32) {
	lock(lockOut)
	outString("** exception ")
	outString(atomName(class))
	outString(": ")
	explain(s, reason)
	m, f, a, ok := funcAt(s.cur.pc)
	if ok {
		outString("\n     in function  ")
		writeAtom(m)
		out(':')
		writeAtom(f)
		out('/')
		writeInt(int64(a))
		if file, line, ok := lineAt(s.cur.pc); ok {
			outString(" (")
			outString(file)
			outString(", line ")
			writeInt(int64(line))
			out(')')
		}
	}
	out('\n')
	unlock(lockOut)
}

// explain writes a reason as the shell explains the ones it knows; bifTag
// says whether it is {Tag, reason}.
func explain(s *sched, reason uint32) {
	if s.bifTag != noTag {
		switch s.bifTag {
		case atomBadmatch:
			outString("no match of right hand side value ")
		case atomCaseClause:
			outString("no case clause matching ")
		case atomBadfun:
			outString("bad function ")
		case atomBadrecord:
			outString("bad record ")
		case atomBadarity:
			outString("bad arity ")
		default:
			out('{')
			writeAtom(mkAtom(s.bifTag))
			out(',')
			writeTerm(s, reason, false)
			out('}')
			return
		}
		writeTerm(s, reason, false)
		return
	}
	if isAtom(reason) {
		switch atomIdx(reason) {
		case atomBadarg:
			outString("bad argument")
			return
		case atomBadarith:
			outString("an error occurred when evaluating an arithmetic expression")
			return
		case atomFunctionClause:
			outString("no function clause matching")
			return
		case atomIfClause:
			outString("no true branch found when evaluating an if expression")
			return
		case atomUndef:
			outString("undefined function")
			return
		case atomSystemLimit:
			outString("a system limit has been reached")
			return
		}
	}
	writeTerm(s, reason, false)
}

// funcAt finds the function a code offset is in: its module and function
// atoms and its arity.
func funcAt(pc uint32) (m, f, a uint32, ok bool) {
	lo, hi := 0, len(funcs)/4
	for lo < hi {
		mid := (lo + hi) / 2
		if funcs[4*mid] <= pc {
			lo = mid + 1
		} else {
			hi = mid
		}
	}
	if lo == 0 {
		return 0, 0, 0, false
	}
	k := 4 * (lo - 1)
	return mkAtom(funcs[k+1]), mkAtom(funcs[k+2]), funcs[k+3] & 0xff, true
}

// lineAt finds the source line a code offset was compiled from.
func lineAt(pc uint32) (file string, line uint32, ok bool) {
	lo, hi := 0, len(lines)/3
	for lo < hi {
		mid := (lo + hi) / 2
		if lines[3*mid] <= pc {
			lo = mid + 1
		} else {
			hi = mid
		}
	}
	if lo == 0 {
		return "", 0, false
	}
	k := 3 * (lo - 1)
	f := lines[k+1]
	if f >= uint32(len(files)) {
		return "", 0, false
	}
	return files[f], lines[k+2], true
}
