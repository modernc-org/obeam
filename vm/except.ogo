// Exceptions: raised by the instructions and the BIFs, caught by try and
// catch, or reported and fatal to the process. A catch is a tag in a y
// register of the frame that holds it, ending in 1111 with the handler's
// code offset above, beside the continuations, which end in 0111; neither is
// a term and the collector passes over both. An exception unwinds the stack
// to the innermost tag and goes on at its handler with x1 the class, x2 the
// reason and x3 the raw stacktrace, which is {Class, [Offset, ...]}, the
// code offsets of the frames, built into Erlang's list only when asked.

const noTag = 0xffffffff

const traceDepth = 8 // frames a stacktrace keeps, as Erlang's default

func mkCP(off uint32) uint32    { return off<<4 | 0x7 }
func cpOf(w uint32) uint32      { return w >> 4 }
func mkCatch(off uint32) uint32 { return off<<4 | 0xf }
func isCP(w uint32) bool        { return w&0xf == 0x7 }
func isCatch(w uint32) bool     { return w&0xf == 0xf }

// failWith fails a BIF with a class and a reason.
func failWith(s *sched, class, reason uint32) uint32 {
	s.bifClass = class
	s.bifReason = reason
	s.bifTag = noTag
	return nonValue
}

// failTagged fails a BIF with an error whose reason is {Tag, V}, which the
// handler builds if it raises it: a BIF that may not allocate fails so too.
func failTagged(s *sched, tag, v uint32) uint32 {
	s.bifClass = atomError
	s.bifReason = v
	s.bifTag = tag
	return nonValue
}

// bifRaise raises what a BIF failed with.
func bifRaise(s *sched) uint32 {
	if tag := s.bifTag; tag != noTag {
		s.bifTag = noTag
		return raiseTagged(s, s.bifClass, tag, s.bifReason)
	}
	return raise(s, mkAtom(s.bifClass), s.bifReason)
}

func failAtom(s *sched, reason uint32) uint32 { return failWith(s, atomError, mkAtom(reason)) }
func badarg(s *sched) uint32                  { return failAtom(s, atomBadarg) }
func badarith(s *sched) uint32                { return failAtom(s, atomBadarith) }

// isClass reports whether a term is one of the three classes.
func isClass(t uint32) bool {
	return t == mkAtom(atomError) || t == mkAtom(atomExit) || t == mkAtom(atomThrow)
}

// raise raises an exception of a class, an atom term, and a reason in the
// running process, and answers where the process goes on: at the handler of
// its innermost catch, or nowhere, 0, the process having ended after a
// report. raiseAtom takes the class and the reason as atom indexes, and
// raiseTagged a reason {Tag, V}, which it builds.
func raise(s *sched, class, reason uint32) uint32 { return throw(s, class, reason, 0) }

func raiseAtom(s *sched, class, reason uint32) uint32 {
	return throw(s, mkAtom(class), mkAtom(reason), 0)
}

func raiseTagged(s *sched, class, tag, v uint32) uint32 {
	s.bargs[0] = v
	s.nbargs = 1
	if !ensure(s, 3, 0) {
		s.nbargs = 0
		return throw(s, mkAtom(atomError), mkAtom(atomSystemLimit), 0)
	}
	v = s.bargs[0]
	s.nbargs = 0
	i := s.cur.htop
	arena[i] = mkHeader(hdrTuple, 2)
	arena[i+1] = mkAtom(tag)
	arena[i+2] = v
	s.cur.htop += 3
	return throw(s, mkAtom(class), mkBoxed(i), 0)
}

// throw delivers an exception, with a raw stacktrace given or, for 0, the
// stack's as it is.
func throw(s *sched, class, reason, raw uint32) uint32 {
	p := s.cur
	if raw == 0 {
		s.bargs[0] = reason
		s.nbargs = 1
		raw = buildRaw(s, class)
		reason = s.bargs[0]
		s.nbargs = 0
		if raw == nonValue {
			raw = nilTerm
		}
	}
	if p.catches == 0 {
		// An exit nothing catches is how a process ends, which Erlang does
		// not log; an error or a throw is a crash, which it does, as the
		// shell does for its own process, whose part the entry process has.
		if class != mkAtom(atomExit) || p == entryProc {
			report(s, class, reason, raw)
		}
		endProc(s, exitReason(s, class, reason, raw))
		s.left = leftFail
		return 0
	}
	end := p.blockEnd()
	prev := p.stop
	for i := p.stop; i < end; i++ {
		w := arena[i]
		if w&7 != 7 {
			continue
		}
		if isCatch(w) {
			p.stop = prev
			s.x[0] = nonValue
			s.x[1] = class
			s.x[2] = reason
			s.x[3] = raw
			return cpOf(w)
		}
		prev = i
	}
	panic("vm: a catch counted and not on the stack")
}

// frames collects the code offsets of the running process's frames: where it
// is, then the continuation it holds unless the frame holds it already, then
// the stack's, traceDepth at most.
func frames(s *sched, offs *[traceDepth]uint32) int {
	p := s.cur
	n := 0
	offs[n] = p.pc
	n++
	end := p.blockEnd()
	first := uint32(0)
	for i := p.stop; i < end; i++ {
		if isCP(arena[i]) {
			first = cpOf(arena[i])
			break
		}
	}
	if p.cp != 0 && p.cp != first && n < traceDepth {
		offs[n] = p.cp
		n++
	}
	for i := p.stop; i < end && n < traceDepth; i++ {
		if w := arena[i]; isCP(w) && cpOf(w) != 0 {
			offs[n] = cpOf(w)
			n++
		}
	}
	return n
}

// buildRaw makes the raw stacktrace of where the process is, {Class, [Offset,
// ...]}, on its heap, or answers nonValue when there is no room.
func buildRaw(s *sched, class uint32) uint32 {
	if !ensure(s, 3+2*traceDepth, 0) {
		return nonValue
	}
	var offs [traceDepth]uint32
	n := frames(s, &offs)
	p := s.cur
	l := uint32(nilTerm)
	for k := n - 1; k >= 0; k-- {
		i := p.htop
		arena[i] = mkSmall(int32(offs[k]))
		arena[i+1] = l
		p.htop += 2
		l = mkCons(i)
	}
	i := p.htop
	arena[i] = mkHeader(hdrTuple, 2)
	arena[i+1] = class
	arena[i+2] = l
	p.htop += 3
	return mkBoxed(i)
}

// rawClass returns the class of a raw stacktrace, and whether the term is
// one.
func rawClass(raw uint32) (uint32, bool) {
	if !isTuple(raw) || tupleArity(raw) != 2 || !isClass(tupleElem(raw, 1)) {
		return 0, false
	}
	return tupleElem(raw, 1), true
}

// frameLine answers the file and line of a frame: the first frame's offset
// is an instruction, a later one's a return address, whose call is the
// instruction before it.
func frameLine(off uint32, first bool) (uint32, uint32, bool) {
	if !first && off > 0 {
		off--
	}
	return lineAt(off)
}

// stackList turns a raw stacktrace into Erlang's list of {M, F, A, [{file,
// F}, {line, L}]}, on the heap, with live X registers and the caller's bargs
// as roots; a stacktrace that is a list already is answered as it is, and
// nonValue says there was no room. It keeps the stacktrace in the bargs
// after the caller's while it makes room, and leaves the caller's as they
// were.
func stackList(s *sched, raw uint32, live int32) uint32 {
	if !isTuple(raw) || tupleArity(raw) != 2 {
		return raw
	}
	offs := tupleElem(raw, 2)
	if !isCons(offs) || !isSmall(arena[consIdx(offs)]) {
		return offs
	}
	need := uint32(0)
	first := true
	for t := offs; isCons(t); t = arena[consIdx(t)+1] {
		off := uint32(smallVal(arena[consIdx(t)]))
		need += 5 + 2 + 2 + 3 + 2 + 3
		if file, _, ok := frameLine(off, first); ok {
			need += 2 * uint32(nameLen(file))
		}
		first = false
	}
	k := s.nbargs
	s.bargs[k] = raw
	s.nbargs = k + 1
	if !ensure(s, need, live) {
		s.nbargs = k
		return nonValue
	}
	raw = s.bargs[k]
	s.nbargs = k
	var o [traceDepth]uint32
	n := 0
	for t := tupleElem(raw, 2); isCons(t) && n < traceDepth; t = arena[consIdx(t)+1] {
		o[n] = uint32(smallVal(arena[consIdx(t)]))
		n++
	}
	p := s.cur
	l := uint32(nilTerm)
	for k := n - 1; k >= 0; k-- {
		m, f, a, ok := funcAt(o[k])
		if !ok {
			continue
		}
		loc := uint32(nilTerm)
		if file, line, ok := frameLine(o[k], k == 0); ok {
			// [{file, "f.erl"}, {line, N}]
			i := p.htop
			arena[i] = mkHeader(hdrTuple, 2)
			arena[i+1] = mkAtom(atomLine)
			arena[i+2] = mkSmall(int32(line))
			p.htop += 3
			lineT := mkBoxed(i)
			str := nameList(s, file)
			i = p.htop
			arena[i] = mkHeader(hdrTuple, 2)
			arena[i+1] = mkAtom(atomFile)
			arena[i+2] = str
			p.htop += 3
			fileT := mkBoxed(i)
			i = p.htop
			arena[i] = lineT
			arena[i+1] = nilTerm
			arena[i+2] = fileT
			arena[i+3] = mkCons(i)
			p.htop += 4
			loc = mkCons(i + 2)
		}
		i := p.htop
		arena[i] = mkHeader(hdrTuple, 4)
		arena[i+1] = m
		arena[i+2] = f
		arena[i+3] = mkSmall(int32(a))
		arena[i+4] = loc
		p.htop += 5
		arena[i+5] = mkBoxed(i)
		arena[i+6] = l
		p.htop += 2
		l = mkCons(i + 5)
	}
	return l
}

// nameList makes a list of a name's bytes on the heap; the room is made.
func nameList(s *sched, nm uint32) uint32 {
	p := s.cur
	l := uint32(nilTerm)
	for k := nameLen(nm) - 1; k >= 0; k-- {
		i := p.htop
		arena[i] = mkSmall(int32(nameAt(nm, k)))
		arena[i+1] = l
		p.htop += 2
		l = mkCons(i)
	}
	return l
}

// report writes what the shell would of an exception nothing caught: the
// class, the reason explained, and the frames, under the output's lock.
func report(s *sched, class, reason, raw uint32) {
	lock(lockOut)
	emits(s, "** exception ")
	emitName(s, atomName(class))
	emits(s, ": ")
	explain(s, reason)
	if isTuple(raw) && tupleArity(raw) == 2 {
		first := true
		for t := tupleElem(raw, 2); isCons(t); t = arena[consIdx(t)+1] {
			off := uint32(smallVal(arena[consIdx(t)]))
			m, f, a, ok := funcAt(off)
			if !ok {
				continue
			}
			if first {
				emits(s, "\n     in function  ")
			} else {
				emits(s, "\n     in call from ")
			}
			writeAtom(s, m)
			emit(s, ':')
			writeAtom(s, f)
			emit(s, '/')
			writeInt(s, int64(a))
			if file, line, ok := frameLine(off, first); ok {
				emits(s, " (")
				emitName(s, file)
				emits(s, ", line ")
				writeInt(s, int64(line))
				emit(s, ')')
			}
			first = false
		}
	}
	emit(s, '\n')
	unlock(lockOut)
}

// explain writes a reason as the shell explains the ones it knows.
func explain(s *sched, reason uint32) {
	if isAtom(reason) {
		switch atomIdx(reason) {
		case atomBadarg:
			emits(s, "bad argument")
			return
		case atomBadarith:
			emits(s, "an error occurred when evaluating an arithmetic expression")
			return
		case atomFunctionClause:
			emits(s, "no function clause matching")
			return
		case atomIfClause:
			emits(s, "no true branch found when evaluating an if expression")
			return
		case atomUndef:
			emits(s, "undefined function")
			return
		case atomSystemLimit:
			emits(s, "a system limit has been reached")
			return
		}
	}
	if isTuple(reason) && tupleArity(reason) == 2 && isAtom(tupleElem(reason, 1)) {
		v := tupleElem(reason, 2)
		switch atomIdx(tupleElem(reason, 1)) {
		case atomBadmatch:
			emits(s, "no match of right hand side value ")
			writeTerm(s, v, false)
			return
		case atomCaseClause:
			emits(s, "no case clause matching ")
			writeTerm(s, v, false)
			return
		case atomTryClause:
			emits(s, "no try clause matching ")
			writeTerm(s, v, false)
			return
		case atomBadfun:
			emits(s, "bad function ")
			writeTerm(s, v, false)
			return
		case atomBadrecord:
			emits(s, "bad record ")
			writeTerm(s, v, false)
			return
		case atomBadarity:
			emits(s, "bad arity ")
			writeTerm(s, v, false)
			return
		case atomNocatch:
			writeTerm(s, v, false)
			return
		}
	}
	writeTerm(s, reason, false)
}

// funcAt finds the function a code offset is in: its module and function
// atoms and its arity.
func funcAt(pc uint32) (m, f, a uint32, ok bool) {
	lo, hi := 0, len(funcs)/4
	for lo < hi {
		mid := (lo + hi) / 2
		if funcs[4*mid] <= pc {
			lo = mid + 1
		} else {
			hi = mid
		}
	}
	if lo == 0 {
		return 0, 0, 0, false
	}
	k := 4 * (lo - 1)
	return mkAtom(funcs[k+1]), mkAtom(funcs[k+2]), funcs[k+3] & 0xff, true
}

// lineAt finds the source line a code offset was compiled from.
func lineAt(pc uint32) (file, line uint32, ok bool) {
	lo, hi := 0, len(lines)/3
	for lo < hi {
		mid := (lo + hi) / 2
		if lines[3*mid] <= pc {
			lo = mid + 1
		} else {
			hi = mid
		}
	}
	if lo == 0 {
		return 0, 0, false
	}
	k := 3 * (lo - 1)
	f := lines[k+1]
	if f >= uint32(len(files)) {
		return 0, 0, false
	}
	return files[f], lines[k+2], true
}
