// Exceptions and their reports. There is no catch yet: an exception ends the
// process, after a report in the shape Erlang's shell prints. A reason of the
// shape {Tag, Value} is not built as a term, nothing being there to catch it;
// the report writes the two.

// What a failing BIF failed with, for the handler to raise or to skip to the
// fail label.
var (
	bifClass  uint32 // an atom index
	bifReason uint32 // a term
	bifTag    uint32 // an atom index when the reason is {Tag, bifReason}, else 0xffffffff
)

const noTag = 0xffffffff

// failWith fails a BIF with a class and a reason.
func failWith(class, reason uint32) uint32 {
	bifClass = class
	bifReason = reason
	bifTag = noTag
	return nonValue
}

func failAtom(reason uint32) uint32 { return failWith(atomError, mkAtom(reason)) }
func badarg() uint32                { return failAtom(atomBadarg) }
func badarith() uint32              { return failAtom(atomBadarith) }

// raise ends the running process with an exception of a class, an atom
// index, and a reason; raiseAtom with an atom reason, raiseTagged with a
// reason {Tag, V}.
func raise(class, reason uint32) {
	bifTag = noTag
	report(class, reason)
	cur.exit(procFailed)
}

func raiseAtom(class, reason uint32) { raise(mkAtom(class), mkAtom(reason)) }

func raiseTagged(class, tag, v uint32) {
	bifTag = tag
	report(mkAtom(class), v)
	cur.exit(procFailed)
}

// report writes what the shell would: the class, the reason explained, and
// the function and line the process was in.
func report(class, reason uint32) {
	outString("** exception ")
	outString(atomName(class))
	outString(": ")
	explain(reason)
	m, f, a, ok := funcAt(cur.pc)
	if ok {
		outString("\n     in function  ")
		writeAtom(m)
		out(':')
		writeAtom(f)
		out('/')
		writeInt(int64(a))
		if file, line, ok := lineAt(cur.pc); ok {
			outString(" (")
			outString(file)
			outString(", line ")
			writeInt(int64(line))
			out(')')
		}
	}
	out('\n')
}

// explain writes a reason as the shell explains the ones it knows; bifTag
// says whether it is {Tag, reason}.
func explain(reason uint32) {
	if bifTag != noTag {
		switch bifTag {
		case atomBadmatch:
			outString("no match of right hand side value ")
		case atomCaseClause:
			outString("no case clause matching ")
		case atomBadfun:
			outString("bad function ")
		case atomBadrecord:
			outString("bad record ")
		case atomBadarity:
			outString("bad arity ")
		default:
			out('{')
			writeAtom(mkAtom(bifTag))
			out(',')
			writeTerm(reason, false)
			out('}')
			return
		}
		writeTerm(reason, false)
		return
	}
	if isAtom(reason) {
		switch atomIdx(reason) {
		case atomBadarg:
			outString("bad argument")
			return
		case atomBadarith:
			outString("an error occurred when evaluating an arithmetic expression")
			return
		case atomFunctionClause:
			outString("no function clause matching")
			return
		case atomIfClause:
			outString("no true branch found when evaluating an if expression")
			return
		case atomUndef:
			outString("undefined function")
			return
		case atomSystemLimit:
			outString("a system limit has been reached")
			return
		}
	}
	writeTerm(reason, false)
}

// funcAt finds the function a code offset is in: its module and function
// atoms and its arity.
func funcAt(pc uint32) (m, f, a uint32, ok bool) {
	lo, hi := 0, len(funcs)/4
	for lo < hi {
		mid := (lo + hi) / 2
		if funcs[4*mid] <= pc {
			lo = mid + 1
		} else {
			hi = mid
		}
	}
	if lo == 0 {
		return 0, 0, 0, false
	}
	k := 4 * (lo - 1)
	return mkAtom(funcs[k+1]), mkAtom(funcs[k+2]), funcs[k+3] & 0xff, true
}

// lineAt finds the source line a code offset was compiled from.
func lineAt(pc uint32) (file string, line uint32, ok bool) {
	lo, hi := 0, len(lines)/3
	for lo < hi {
		mid := (lo + hi) / 2
		if lines[3*mid] <= pc {
			lo = mid + 1
		} else {
			hi = mid
		}
	}
	if lo == 0 {
		return "", 0, false
	}
	k := 3 * (lo - 1)
	f := lines[k+1]
	if f >= uint32(len(files)) {
		return "", 0, false
	}
	return files[f], lines[k+2], true
}
