// The interpreter: a loop over the instruction stream, each instruction's
// handler reading its operands from the longs after the opcode and answering
// where to go on. A handler answers 0 to stop: the process has ended, or an
// exception has.
//
// An operand is as the packer resolved it: a number where the instruction
// wants a count, a label's code offset, an x or y register as a marker ending
// in 0111 or 1111 with the number above, and otherwise a term; src reads the
// one and the other.

type handler func(s *sched, pc uint32) uint32

var handlers = [256]handler{
	opHalt:              hHalt,
	opFuncInfo:          hFuncInfo,
	opCall:              hCall,
	opCallLast:          hCallLast,
	opCallOnly:          hCallOnly,
	opCallBif:           hCallBif,
	opBif0:              hBif0,
	opBif1:              hBif1,
	opBif2:              hBif2,
	opGcBif1:            hGcBif1,
	opGcBif2:            hGcBif2,
	opGcBif3:            hGcBif3,
	opAllocate:          hAllocate,
	opAllocateHeap:      hAllocateHeap,
	opDeallocate:        hDeallocate,
	opInitYregs:         hInitYregs,
	opTrim:              hTrim,
	opSwap:              hSwap,
	opTestHeap:          hTestHeap,
	opReturn:            hReturn,
	opMove:              hMove,
	opJump:              hJump,
	opSelectVal:         hSelectVal,
	opSelectTupleArity:  hSelectTupleArity,
	opIsLt:              hIsLt,
	opIsGe:              hIsGe,
	opIsEq:              hIsEq,
	opIsNe:              hIsNe,
	opIsEqExact:         hIsEqExact,
	opIsNeExact:         hIsNeExact,
	opIsInteger:         hIsInteger,
	opIsFloat:           hIsFloat,
	opIsNumber:          hIsNumber,
	opIsAtom:            hIsAtom,
	opIsPid:             hIsPid,
	opIsReference:       hIsReference,
	opIsPort:            hIsPort,
	opIsNil:             hIsNil,
	opIsBinary:          hIsBinary,
	opIsBitstr:          hIsBinary,
	opIsList:            hIsList,
	opIsNonemptyList:    hIsNonemptyList,
	opIsTuple:           hIsTuple,
	opTestArity:         hTestArity,
	opIsTaggedTuple:     hIsTaggedTuple,
	opIsBoolean:         hIsBoolean,
	opIsFunction:        hIsFunction,
	opIsFunction2:       hIsFunction2,
	opIsMap:             hIsMap,
	opGetList:           hGetList,
	opGetHd:             hGetHd,
	opGetTl:             hGetTl,
	opPutList:           hPutList,
	opPutTuple2:         hPutTuple2,
	opGetTupleElement:   hGetTupleElement,
	opSetTupleElement:   hSetTupleElement,
	opUpdateRecord:      hUpdateRecord,
	opMakeFun3:          hMakeFun3,
	opCallFun:           hCallFun,
	opCallFun2:          hCallFun2,
	opSend:              hSend,
	opLoopRec:           hLoopRec,
	opLoopRecEnd:        hLoopRecEnd,
	opWait:              hWait,
	opWaitTimeout:       hWaitTimeout,
	opTimeout:           hTimeout,
	opRemoveMessage:     hRemoveMessage,
	opRecvMarkerBind:    hRecvMarkerBind,
	opRecvMarkerClear:   hRecvMarkerClear,
	opRecvMarkerReserve: hRecvMarkerReserve,
	opRecvMarkerUse:     hRecvMarkerUse,
	opTry:               hTry,
	opTryEnd:            hTryEnd,
	opTryCase:           hTryCase,
	opTryCaseEnd:        hTryCaseEnd,
	opCatch:             hCatch,
	opCatchEnd:          hCatchEnd,
	opRaise:             hRaise,
	opBuildStacktrace:   hBuildStacktrace,
	opRawRaise:          hRawRaise,
	opFmove:             hFmove,
	opFconv:             hFconv,
	opFadd:              hFadd,
	opFsub:              hFsub,
	opFmul:              hFmul,
	opFdiv:              hFdiv,
	opFnegate:           hFnegate,
	opBadmatch:          hBadmatch,
	opCaseEnd:           hCaseEnd,
	opIfEnd:             hIfEnd,
	opBadrecord:         hBadrecord,
}

// run interprets a process from where it continues until it ends, waits
// for a message, or has used its reductions, and reports whether it ended.
func run(s *sched, p *Proc) bool {
	pc, ok := turnStart(s, p)
	if !ok {
		return true
	}
	steps := uint32(0)
	core := Core != nil
	for pc != 0 {
		if core && code[pc]&0xff00 != 0 {
			pc = coreRun(s, p, pc)
		}
		op := code[pc] & 0xff
		h := handlers[op]
		p.pc = pc
		pc = h(s, pc)
		if pc == slowPath {
			pc = slow[op](s, p.pc)
		}
		steps++
	}
	s.steps += steps
	return turnEnd(s, p)
}

// turnStart begins a process's turn: it is running, its saved X registers
// are back, and an exit signal waiting for it is dealt with. It answers where
// the process goes on, and false when a signal has ended it.
func turnStart(s *sched, p *Proc) (uint32, bool) {
	s.cur = p
	lock(stripe(p))
	p.state = procRunning
	sig := p.signaled
	unlock(stripe(p))
	for i := uint32(0); i < p.nsave; i++ {
		s.x[i] = p.xsave[i]
	}
	s.left = leftEnd
	if sig && !signals(s) {
		return 0, false
	}
	return p.pc, true
}

// turnEnd ends a process's turn, as the last instruction said it ended, and
// reports whether the process has ended.
func turnEnd(s *sched, p *Proc) bool {
	switch s.left {
	case leftEnd:
		endProc(s, mkAtom(atomNormal))
		return true
	case leftFail:
		return true
	}
	return false
}

func hHalt(s *sched, pc uint32) uint32 { return 0 }

// hFuncInfo is where a call lands when no clause of the function matched.
func hFuncInfo(s *sched, pc uint32) uint32 {
	return raiseAtom(s, atomError, atomFunctionClause)
}

func hCall(s *sched, pc uint32) uint32 {
	s.cur.cp = pc + 3
	return jump(s, code[pc+2], code[pc+1])
}

func hCallLast(s *sched, pc uint32) uint32 {
	n := code[pc+3]
	s.cur.cp = cpOf(arena[s.cur.stop])
	s.cur.stop += n + 1
	return jump(s, code[pc+2], code[pc+1])
}

func hCallOnly(s *sched, pc uint32) uint32 {
	return jump(s, code[pc+2], code[pc+1])
}

// jump is a call's last step: it costs a reduction, and when the process has
// none left its turn ends here, with live X registers saved.
func jump(s *sched, target, live uint32) uint32 {
	s.cur.reds--
	if s.cur.reds <= 0 {
		return yield(s, target, live)
	}
	return target
}

// hReturn goes on at the continuation, which it clears: a function that has
// returned leaves no return address behind to be taken for a frame.
func hReturn(s *sched, pc uint32) uint32 {
	r := s.cur.cp
	s.cur.cp = 0
	return r
}

func hAllocate(s *sched, pc uint32) uint32 {
	n, live := code[pc+1], code[pc+2]
	if s.cur.stop-(n+1) < s.cur.htop && !gc(s, live, 0, n+1) {
		return raiseAtom(s, atomError, atomSystemLimit)
	}
	return pushFrame(s, n, pc+3)
}

func hAllocateHeap(s *sched, pc uint32) uint32 {
	n, need, live := code[pc+1], code[pc+2], code[pc+3]
	if s.cur.stop-(n+1) < s.cur.htop+need && !gc(s, live, need, n+1) {
		return raiseAtom(s, atomError, atomSystemLimit)
	}
	return pushFrame(s, n, pc+4)
}

// pushFrame makes a frame of n y registers, the continuation below them.
func pushFrame(s *sched, n, next uint32) uint32 {
	s.cur.stop -= n + 1
	arena[s.cur.stop] = mkCP(s.cur.cp)
	for i := uint32(1); i <= n; i++ {
		arena[s.cur.stop+i] = 0
	}
	return next
}

func hDeallocate(s *sched, pc uint32) uint32 {
	n := code[pc+1]
	s.cur.cp = cpOf(arena[s.cur.stop])
	s.cur.stop += n + 1
	return pc + 2
}

func hInitYregs(s *sched, pc uint32) uint32 {
	n := code[pc+1]
	for i := uint32(0); i < n; i++ {
		store(s, code[pc+2+i], nilTerm)
	}
	return pc + 2 + n
}

func hTrim(s *sched, pc uint32) uint32 {
	n := code[pc+1]
	cp := arena[s.cur.stop]
	s.cur.stop += n
	arena[s.cur.stop] = cp
	return pc + 3
}

func hSwap(s *sched, pc uint32) uint32 {
	a, b := code[pc+1], code[pc+2]
	va, vb := src(s, a), src(s, b)
	store(s, a, vb)
	store(s, b, va)
	return pc + 3
}

func hTestHeap(s *sched, pc uint32) uint32 {
	need, live := code[pc+1], code[pc+2]
	if (s.cur.htop+need > s.cur.stop || s.cur.forceGC) && !gc(s, live, need, 0) {
		return raiseAtom(s, atomError, atomSystemLimit)
	}
	return pc + 3
}

func hMove(s *sched, pc uint32) uint32 {
	store(s, code[pc+2], src(s, code[pc+1]))
	return pc + 3
}

func hJump(s *sched, pc uint32) uint32 { return code[pc+1] }

func hSelectVal(s *sched, pc uint32) uint32 {
	v := src(s, code[pc+1])
	n := code[pc+3]
	for i := uint32(0); i < n; i += 2 {
		if eqExact(s, v, code[pc+4+i]) {
			return code[pc+5+i]
		}
	}
	return code[pc+2]
}

func hSelectTupleArity(s *sched, pc uint32) uint32 {
	a := tupleArity(src(s, code[pc+1]))
	n := code[pc+3]
	for i := uint32(0); i < n; i += 2 {
		if a == code[pc+4+i] {
			return code[pc+5+i]
		}
	}
	return code[pc+2]
}

// test answers where a test instruction of a fail label and two operands
// goes: on past them if it held, to the label if not.
func test(pc uint32, held bool, operands uint32) uint32 {
	if held {
		return pc + 2 + operands
	}
	return code[pc+1]
}

func hIsLt(s *sched, pc uint32) uint32 {
	return test(pc, cmp(s, src(s, code[pc+2]), src(s, code[pc+3])) < 0, 2)
}

func hIsGe(s *sched, pc uint32) uint32 {
	return test(pc, cmp(s, src(s, code[pc+2]), src(s, code[pc+3])) >= 0, 2)
}

func hIsEq(s *sched, pc uint32) uint32 {
	return test(pc, cmp(s, src(s, code[pc+2]), src(s, code[pc+3])) == 0, 2)
}

func hIsNe(s *sched, pc uint32) uint32 {
	return test(pc, cmp(s, src(s, code[pc+2]), src(s, code[pc+3])) != 0, 2)
}

func hIsEqExact(s *sched, pc uint32) uint32 {
	return test(pc, eqExact(s, src(s, code[pc+2]), src(s, code[pc+3])), 2)
}

func hIsNeExact(s *sched, pc uint32) uint32 {
	return test(pc, !eqExact(s, src(s, code[pc+2]), src(s, code[pc+3])), 2)
}

func hIsInteger(s *sched, pc uint32) uint32   { return test(pc, isInteger(src(s, code[pc+2])), 1) }
func hIsFloat(s *sched, pc uint32) uint32     { return test(pc, isFloat(src(s, code[pc+2])), 1) }
func hIsNumber(s *sched, pc uint32) uint32    { return test(pc, isNumber(src(s, code[pc+2])), 1) }
func hIsAtom(s *sched, pc uint32) uint32      { return test(pc, isAtom(src(s, code[pc+2])), 1) }
func hIsPid(s *sched, pc uint32) uint32       { return test(pc, isPid(src(s, code[pc+2])), 1) }
func hIsReference(s *sched, pc uint32) uint32 { return test(pc, isRef(src(s, code[pc+2])), 1) }
func hIsPort(s *sched, pc uint32) uint32      { return test(pc, false, 1) }
func hIsNil(s *sched, pc uint32) uint32       { return test(pc, src(s, code[pc+2]) == nilTerm, 1) }
func hIsBinary(s *sched, pc uint32) uint32    { return test(pc, isBinary(src(s, code[pc+2])), 1) }
func hIsList(s *sched, pc uint32) uint32      { return test(pc, isList(src(s, code[pc+2])), 1) }
func hIsNonemptyList(s *sched, pc uint32) uint32 {
	return test(pc, isCons(src(s, code[pc+2])), 1)
}
func hIsTuple(s *sched, pc uint32) uint32   { return test(pc, isTuple(src(s, code[pc+2])), 1) }
func hIsBoolean(s *sched, pc uint32) uint32 { return test(pc, isBool(src(s, code[pc+2])), 1) }
func hIsFunction(s *sched, pc uint32) uint32 {
	return test(pc, isFun(src(s, code[pc+2])), 1)
}
func hIsMap(s *sched, pc uint32) uint32 { return test(pc, false, 1) }

func hTestArity(s *sched, pc uint32) uint32 {
	t := src(s, code[pc+2])
	return test(pc, isTuple(t) && tupleArity(t) == code[pc+3], 2)
}

func hIsTaggedTuple(s *sched, pc uint32) uint32 {
	t := src(s, code[pc+2])
	return test(pc, isTuple(t) && tupleArity(t) == code[pc+3] && tupleElem(t, 1) == code[pc+4], 3)
}

func hIsFunction2(s *sched, pc uint32) uint32 {
	t := src(s, code[pc+2])
	a := src(s, code[pc+3])
	return test(pc, isFun(t) && isSmall(a) && funArity(t) == uint32(smallVal(a)), 2)
}

func hGetList(s *sched, pc uint32) uint32 {
	i := consIdx(src(s, code[pc+1]))
	store(s, code[pc+2], arena[i])
	store(s, code[pc+3], arena[i+1])
	return pc + 4
}

func hGetHd(s *sched, pc uint32) uint32 {
	store(s, code[pc+2], arena[consIdx(src(s, code[pc+1]))])
	return pc + 3
}

func hGetTl(s *sched, pc uint32) uint32 {
	store(s, code[pc+2], arena[consIdx(src(s, code[pc+1]))+1])
	return pc + 3
}

func hPutList(s *sched, pc uint32) uint32 {
	i := s.cur.htop
	arena[i] = src(s, code[pc+1])
	arena[i+1] = src(s, code[pc+2])
	s.cur.htop += 2
	store(s, code[pc+3], mkCons(i))
	return pc + 4
}

func hPutTuple2(s *sched, pc uint32) uint32 {
	n := code[pc+2]
	i := s.cur.htop
	arena[i] = mkHeader(hdrTuple, n)
	for k := uint32(0); k < n; k++ {
		arena[i+1+k] = src(s, code[pc+3+k])
	}
	s.cur.htop += n + 1
	store(s, code[pc+1], mkBoxed(i))
	return pc + 3 + n
}

func hGetTupleElement(s *sched, pc uint32) uint32 {
	store(s, code[pc+3], arena[boxIdx(src(s, code[pc+1]))+1+code[pc+2]])
	return pc + 4
}

func hSetTupleElement(s *sched, pc uint32) uint32 {
	arena[boxIdx(src(s, code[pc+2]))+1+code[pc+3]] = src(s, code[pc+1])
	return pc + 4
}

// hUpdateRecord copies a tuple with some elements replaced: the hint, the
// size, the source, the destination, then pairs of an index from 1 and a
// value.
func hUpdateRecord(s *sched, pc uint32) uint32 {
	size := code[pc+2]
	from := boxIdx(src(s, code[pc+3]))
	i := s.cur.htop
	for k := uint32(0); k <= size; k++ {
		arena[i+k] = arena[from+k]
	}
	s.cur.htop += size + 1
	n := code[pc+5]
	for k := uint32(0); k < n; k += 2 {
		arena[i+code[pc+6+k]] = src(s, code[pc+7+k])
	}
	store(s, code[pc+4], mkBoxed(i))
	return pc + 6 + n
}

// hMakeFun3 makes a fun: the fun table's index, the destination, then the
// environment's values.
func hMakeFun3(s *sched, pc uint32) uint32 {
	f := 3 * code[pc+1]
	n := code[pc+3]
	i := s.cur.htop
	arena[i] = mkHeader(hdrFun, funHeadLongs+n)
	arena[i+1] = funs[f]
	arena[i+2] = funs[f+1] - funs[f+2] | funs[f+2]<<16
	for k := uint32(0); k < n; k++ {
		arena[i+3+k] = src(s, code[pc+4+k])
	}
	s.cur.htop += 1 + funHeadLongs + n
	store(s, code[pc+2], mkBoxed(i))
	return pc + 4 + n
}

func hCallFun(s *sched, pc uint32) uint32 {
	arity := code[pc+1]
	return callFun(s, arity, s.x[arity], pc+2)
}

func hCallFun2(s *sched, pc uint32) uint32 {
	return callFun(s, code[pc+2], src(s, code[pc+3]), pc+4)
}

// callFun calls a fun with its arguments in x0 and up: a local or external
// one by putting its environment after them and jumping, a BIF's by calling
// the BIF.
func callFun(s *sched, arity, f, next uint32) uint32 {
	if !isFun(f) {
		return raiseTagged(s, atomError, atomBadfun, f)
	}
	if funArity(f) != arity {
		return raiseTagged(s, atomError, atomBadarity, f)
	}
	if funKind(f) == funBif {
		for i := uint32(0); i < arity; i++ {
			s.bargs[i] = s.x[i]
		}
		s.nbargs = arity
		s.curLive = int32(arity)
		r := bifs[funCode(f)].f(s, arity)
		s.nbargs = 0
		if r == nonValue {
			return raise(s, mkAtom(s.bifClass), s.bifReason)
		}
		s.x[0] = r
		return next
	}
	n := funFree(f)
	i := boxIdx(f) + 1 + funHeadLongs
	for k := uint32(0); k < n; k++ {
		s.x[arity+k] = arena[i+k]
	}
	s.cur.cp = next
	return jump(s, funCode(f), arity+n)
}

func hBadmatch(s *sched, pc uint32) uint32 {
	return raiseTagged(s, atomError, atomBadmatch, src(s, code[pc+1]))
}

func hCaseEnd(s *sched, pc uint32) uint32 {
	return raiseTagged(s, atomError, atomCaseClause, src(s, code[pc+1]))
}

func hIfEnd(s *sched, pc uint32) uint32 {
	return raiseAtom(s, atomError, atomIfClause)
}

func hBadrecord(s *sched, pc uint32) uint32 {
	return raiseTagged(s, atomError, atomBadrecord, src(s, code[pc+1]))
}

// The BIF instructions. bif0, bif1 and bif2 may not allocate; the gc_bifs
// say how many X registers are live, and call_bif's are its arguments.

func hCallBif(s *sched, pc uint32) uint32 {
	arity, b := code[pc+1], code[pc+2]
	for i := uint32(0); i < arity; i++ {
		s.bargs[i] = s.x[i]
	}
	s.nbargs = arity
	s.curLive = int32(arity)
	r := bifs[b].f(s, arity)
	s.nbargs = 0
	if r == nonValue {
		return raise(s, mkAtom(s.bifClass), s.bifReason)
	}
	if r == jumpValue {
		// apply: the BIF set x0 and up and left where to go in bifJump.
		s.cur.cp = pc + 3
		return jump(s, s.bifJump, s.bifLive)
	}
	s.x[0] = r
	return pc + 3
}

// The messages. send's pid is in x0 and its message in x1; the receive
// instructions walk the mailbox from where the last one stopped.

func hSend(s *sched, pc uint32) uint32 {
	if !sendMsg(s, s.x[0], s.x[1]) {
		return raise(s, mkAtom(s.bifClass), s.bifReason)
	}
	s.x[0] = s.x[1]
	return pc + 1
}

// hLoopRec puts the message a receive is looking at in its destination, or
// goes to the fail label when there is none. The mailbox is read under its
// lock, a sender writing the same words.
func hLoopRec(s *sched, pc uint32) uint32 {
	p := s.cur
	lock(stripe(p))
	sig := p.signaled
	c := p.mboxCur
	unlock(stripe(p))
	if sig {
		if !signals(s) {
			return 0
		}
		lock(stripe(p))
		c = p.mboxCur
		unlock(stripe(p))
	}
	if c == noBlock {
		return code[pc+1]
	}
	store(s, code[pc+2], arena[c+2])
	return pc + 3
}

// hLoopRecEnd looks at the next message and goes back to the receive.
func hLoopRecEnd(s *sched, pc uint32) uint32 {
	p := s.cur
	lock(stripe(p))
	p.mboxPrev = p.mboxCur
	p.mboxCur = arena[p.mboxCur]
	unlock(stripe(p))
	return code[pc+1]
}

func hRemoveMessage(s *sched, pc uint32) uint32 {
	takeMessage(s)
	return pc + 1
}

func hWait(s *sched, pc uint32) uint32 {
	return sleep(s, code[pc+1], false, 0, 0)
}

// hWaitTimeout waits for a message or for a time in milliseconds, infinity
// being no time.
func hWaitTimeout(s *sched, pc uint32) uint32 {
	t := src(s, code[pc+2])
	if t == mkAtom(atomInfinity) {
		return sleep(s, code[pc+1], false, 0, 0)
	}
	if !isSmall(t) || smallVal(t) < 0 {
		return raiseAtom(s, atomError, atomTimeoutValue)
	}
	return sleep(s, code[pc+1], true, uint32(smallVal(t)), pc+3)
}

// hTimeout is where a timed-out receive goes on: the mailbox is looked at
// from its head again.
func hTimeout(s *sched, pc uint32) uint32 {
	p := s.cur
	lock(stripe(p))
	p.mboxCur = p.mboxHead
	p.mboxPrev = noBlock
	unlock(stripe(p))
	return pc + 1
}

// The receive markers shortcut the mailbox scan of a receive that waits for
// a fresh reference; without them the scan is only longer.
func hRecvMarkerBind(s *sched, pc uint32) uint32  { return pc + 3 }
func hRecvMarkerClear(s *sched, pc uint32) uint32 { return pc + 2 }
func hRecvMarkerUse(s *sched, pc uint32) uint32   { return pc + 2 }
func hRecvMarkerReserve(s *sched, pc uint32) uint32 {
	store(s, code[pc+1], mkSmall(0))
	return pc + 2
}

func hBif0(s *sched, pc uint32) uint32 {
	s.nbargs = 0
	s.curLive = -1
	r := bifs[code[pc+1]].f(s, 0)
	if r == nonValue {
		return raise(s, mkAtom(s.bifClass), s.bifReason)
	}
	store(s, code[pc+2], r)
	return pc + 3
}

func hBif1(s *sched, pc uint32) uint32 {
	s.bargs[0] = src(s, code[pc+3])
	s.nbargs = 1
	s.curLive = -1
	r := bifs[code[pc+2]].f(s, 1)
	s.nbargs = 0
	return bifDone(s, pc, r, code[pc+4], pc+5)
}

func hBif2(s *sched, pc uint32) uint32 {
	s.bargs[0] = src(s, code[pc+3])
	s.bargs[1] = src(s, code[pc+4])
	s.nbargs = 2
	s.curLive = -1
	r := bifs[code[pc+2]].f(s, 2)
	s.nbargs = 0
	return bifDone(s, pc, r, code[pc+5], pc+6)
}

func hGcBif1(s *sched, pc uint32) uint32 {
	s.bargs[0] = src(s, code[pc+4])
	s.nbargs = 1
	s.curLive = int32(code[pc+2])
	r := bifs[code[pc+3]].f(s, 1)
	s.nbargs = 0
	return bifDone(s, pc, r, code[pc+5], pc+6)
}

func hGcBif2(s *sched, pc uint32) uint32 {
	s.bargs[0] = src(s, code[pc+4])
	s.bargs[1] = src(s, code[pc+5])
	s.nbargs = 2
	s.curLive = int32(code[pc+2])
	r := bifs[code[pc+3]].f(s, 2)
	s.nbargs = 0
	return bifDone(s, pc, r, code[pc+6], pc+7)
}

func hGcBif3(s *sched, pc uint32) uint32 {
	s.bargs[0] = src(s, code[pc+4])
	s.bargs[1] = src(s, code[pc+5])
	s.bargs[2] = src(s, code[pc+6])
	s.nbargs = 3
	s.curLive = int32(code[pc+2])
	r := bifs[code[pc+3]].f(s, 3)
	s.nbargs = 0
	return bifDone(s, pc, r, code[pc+7], pc+8)
}

// bifDone stores a BIF's result, or goes to the fail label when it failed
// and there is one, and raises what it failed with when there is none.
func bifDone(s *sched, pc, r, dst, next uint32) uint32 {
	if r == nonValue {
		if fail := code[pc+1]; fail != 0 {
			return fail
		}
		return raise(s, mkAtom(s.bifClass), s.bifReason)
	}
	store(s, dst, r)
	return next
}

// Catching. try and catch put a tag with the handler's offset in a y
// register and count it; the normal way out, try_end or catch_end, clears
// it; the handler, try_case or catch_end after an exception, finds the class,
// the reason and the raw stacktrace in x1, x2 and x3 and x0 the non-value.

func hTry(s *sched, pc uint32) uint32 {
	store(s, code[pc+1], mkCatch(code[pc+2]))
	s.cur.catches++
	return pc + 3
}

func hCatch(s *sched, pc uint32) uint32 { return hTry(s, pc) }

func hTryEnd(s *sched, pc uint32) uint32 {
	store(s, code[pc+1], nilTerm)
	s.cur.catches--
	return pc + 2
}

// hTryCase begins a try's handler: the class, reason and stacktrace move
// down to x0, x1 and x2.
func hTryCase(s *sched, pc uint32) uint32 {
	store(s, code[pc+1], nilTerm)
	s.cur.catches--
	s.x[0] = s.x[1]
	s.x[1] = s.x[2]
	s.x[2] = s.x[3]
	return pc + 2
}

func hTryCaseEnd(s *sched, pc uint32) uint32 {
	return raiseTagged(s, atomError, atomTryClause, src(s, code[pc+1]))
}

// hCatchEnd ends a catch expression: after an exception its value is the
// thrown term, {'EXIT', Reason} of an exit, or {'EXIT', {Reason,
// Stacktrace}} of an error.
func hCatchEnd(s *sched, pc uint32) uint32 {
	store(s, code[pc+1], nilTerm)
	s.cur.catches--
	if s.x[0] != nonValue {
		return pc + 2
	}
	switch s.x[1] {
	case mkAtom(atomThrow):
		s.x[0] = s.x[2]
		return pc + 2
	case mkAtom(atomError):
		stk := stackList(s, s.x[3], 4)
		if stk == nonValue {
			return raiseAtom(s, atomError, atomSystemLimit)
		}
		s.x[3] = stk
		if !ensure(s, 6, 4) {
			return raiseAtom(s, atomError, atomSystemLimit)
		}
		i := s.cur.htop
		arena[i] = mkHeader(hdrTuple, 2)
		arena[i+1] = s.x[2]
		arena[i+2] = s.x[3]
		arena[i+3] = mkHeader(hdrTuple, 2)
		arena[i+4] = mkAtom(atomEXIT)
		arena[i+5] = mkBoxed(i)
		s.cur.htop += 6
		s.x[0] = mkBoxed(i + 3)
		return pc + 2
	}
	if !ensure(s, 3, 4) {
		return raiseAtom(s, atomError, atomSystemLimit)
	}
	i := s.cur.htop
	arena[i] = mkHeader(hdrTuple, 2)
	arena[i+1] = mkAtom(atomEXIT)
	arena[i+2] = s.x[2]
	s.cur.htop += 3
	s.x[0] = mkBoxed(i)
	return pc + 2
}

// hRaise raises again with a raw stacktrace and a reason, the class being
// the stacktrace's; given what is no raw stacktrace it answers badarg in x0
// and goes on.
func hRaise(s *sched, pc uint32) uint32 {
	raw := src(s, code[pc+1])
	reason := src(s, code[pc+2])
	if class, ok := rawClass(raw); ok {
		return throw(s, class, reason, raw)
	}
	s.x[0] = mkAtom(atomBadarg)
	return pc + 3
}

// hBuildStacktrace turns the raw stacktrace in x0 into Erlang's list.
func hBuildStacktrace(s *sched, pc uint32) uint32 {
	l := stackList(s, s.x[0], 1)
	if l == nonValue {
		return raiseAtom(s, atomError, atomSystemLimit)
	}
	s.x[0] = l
	return pc + 1
}

// hRawRaise is erlang:raise/3: the class in x0, the reason in x1 and the
// stacktrace, a list, in x2; a class that is none answers badarg in x0.
func hRawRaise(s *sched, pc uint32) uint32 {
	class := s.x[0]
	if !isClass(class) {
		s.x[0] = mkAtom(atomBadarg)
		return pc + 1
	}
	if !ensure(s, 3, 3) {
		return raiseAtom(s, atomError, atomSystemLimit)
	}
	i := s.cur.htop
	arena[i] = mkHeader(hdrTuple, 2)
	arena[i+1] = class
	arena[i+2] = s.x[2]
	s.cur.htop += 3
	return throw(s, class, s.x[1], mkBoxed(i))
}
