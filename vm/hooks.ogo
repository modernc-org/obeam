// What the board gives the VM: the locks, the clocks, a pause, the serial
// line and the pins, through OctoGo's p2 package. A lock taken through a
// function value cost 616 clocks a round, measured by make prof, and every
// message takes several; p2's TryLock is one instruction. Nothing here is a
// function value the VM calls: ogo sizes a goroutine's stack from the
// backend's listing, which cannot tell where a call through one goes and
// counts it as going to every function whose address is taken, the BIFs and
// handlers among them, so that a BIF writing through a hook made all of them
// one cycle whose frames the bound added up (DESIGN.md section 8). The
// twin, scripts/twin.sh, has this package import a Go shim of p2 instead,
// internal/p2twin, whose serial line is the test's buffer.

import "p2"

// CRLF says that a newline goes out as a carriage return and a line feed, as
// a terminal wants it; main sets it on the board.
var CRLF bool

// The VM's locks: the pool, the run queue, the table's free slots, the
// output, the ring of the pins, and four stripes of mailboxes and process states, a process's by
// its index. The order to take them in, where two are held, is a stripe,
// then the run queue or the pool; the pool is taken inside the table's.
const (
	lockPool = iota
	lockRun
	lockProcs
	lockOut
	lockPins
	lockStripe // the first of four
	nlocks     = lockStripe + 4
)

var (
	locks     [nlocks]int
	locksMade bool
)

// makeLocks takes the VM's locks from the board, once.
func makeLocks() {
	if locksMade {
		return
	}
	for i := range locks {
		locks[i] = p2.NewLock()
	}
	locksMade = true
}

// lock takes a lock, spinning until it has it; unlock gives it back.
func lock(k int) {
	l := locks[k]
	for !p2.TryLock(l) {
	}
}

func unlock(k int) { p2.Unlock(locks[k]) }

// stripe is the lock of a process's mailbox and state.
func stripe(p *Proc) int { return lockStripe + int(p.idx&3) }

// now is the time in milliseconds.
func now() uint32 { return p2.GetMs() }

// idle is what a scheduler does with nothing to run: a moment's wait.
func idle() { p2.WaitUs(20) }

// out writes a byte to the serial line, under lockOut.
func out(b byte) {
	if b == '\n' && CRLF {
		p2.WriteByte('\r')
	}
	p2.WriteByte(b)
}

func outString(str string) {
	for i := 0; i < len(str); i++ {
		out(str[i])
	}
}
