// What the board gives the VM. The locks, the clocks and a pause are the P2's
// own, through OctoGo's p2 package, whose TryLock is one instruction: a lock
// taken through a function value cost 616 clocks a round, measured by make
// prof, and every message takes several. The twin, scripts/twin.sh, has this
// package import a Go shim of them instead, internal/p2twin. Where output
// goes and the pins stay hooks, main's to set: the serial line is main's, and
// the pins are driven from main's cog. A hook that is nil does nothing, and a
// pin BIF then answers ok or 0.

import "p2"

var (
	Out       func(b byte)
	PinHigh   func(pin int)
	PinLow    func(pin int)
	PinToggle func(pin int)
	PinFloat  func(pin int)
	PinIn     func(pin int) int
	PinWrite  func(pin int, v int)
	ClockFreq func() uint32
	Rnd       func() uint32
)

// The VM's locks: the pool, the run queue, the table's free slots, the
// output, and four stripes of mailboxes and process states, a process's by
// its index. The order to take them in, where two are held, is a stripe,
// then the run queue or the pool; the pool is taken inside the table's.
const (
	lockPool = iota
	lockRun
	lockProcs
	lockOut
	lockStripe // the first of four
	nlocks     = lockStripe + 4
)

var (
	locks     [nlocks]int
	locksMade bool
)

// makeLocks takes the VM's locks from the board, once.
func makeLocks() {
	if locksMade {
		return
	}
	for i := range locks {
		locks[i] = p2.NewLock()
	}
	locksMade = true
}

// lock takes a lock, spinning until it has it; unlock gives it back.
func lock(k int) {
	l := locks[k]
	for !p2.TryLock(l) {
	}
}

func unlock(k int) { p2.Unlock(locks[k]) }

// stripe is the lock of a process's mailbox and state.
func stripe(p *Proc) int { return lockStripe + int(p.idx&3) }

// now is the time in milliseconds.
func now() uint32 { return p2.GetMs() }

// idle is what a scheduler does with nothing to run: a moment's wait.
func idle() { p2.WaitUs(20) }

func out(b byte) {
	if Out != nil {
		Out(b)
	}
}

func outString(str string) {
	for i := 0; i < len(str); i++ {
		out(str[i])
	}
}
