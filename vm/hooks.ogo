// What the board gives the VM and the host gives its twin: where output goes,
// the time, the locks, a pause, and the pins the p2 module's BIFs drive. A
// hook that is nil does nothing: without locks the VM runs on one scheduler,
// without pins a pin BIF answers ok or 0.
var (
	Out       func(b byte)
	Millis    func() uint32
	NewLock   func() int
	TryLock   func(l int) bool
	Unlock    func(l int)
	Idle      func()
	PinHigh   func(pin int)
	PinLow    func(pin int)
	PinToggle func(pin int)
	PinFloat  func(pin int)
	PinIn     func(pin int) int
	PinWrite  func(pin int, v int)
	GetCt     func() uint32
	ClockFreq func() uint32
	Rnd       func() uint32
)

// The VM's locks: the pool, the run queue, the process table's free slots,
// the output, and four stripes of mailboxes and process states, a process's
// by its index. The order to take them in, where two are held, is a stripe,
// then the run queue or the pool; the pool is taken inside the table's.
const (
	lockPool = iota
	lockRun
	lockProcs
	lockOut
	lockStripe // the first of four
	nlocks     = lockStripe + 4
)

var (
	locks     [nlocks]int
	locksMade bool
)

// makeLocks takes the VM's locks from the board, once.
func makeLocks() {
	if NewLock == nil || locksMade {
		return
	}
	for i := range locks {
		locks[i] = NewLock()
	}
	locksMade = true
}

// lock takes a lock, spinning until it has it; unlock gives it back. Without
// the hooks there is one scheduler and nothing to lock against.
func lock(k int) {
	if TryLock == nil {
		return
	}
	l := locks[k]
	for !TryLock(l) {
	}
}

func unlock(k int) {
	if Unlock == nil {
		return
	}
	Unlock(locks[k])
}

// stripe is the lock of a process's mailbox and state.
func stripe(p *Proc) int { return lockStripe + int(p.idx&3) }

func out(b byte) {
	if Out != nil {
		Out(b)
	}
}

func outString(s string) {
	for i := 0; i < len(s); i++ {
		out(s[i])
	}
}
