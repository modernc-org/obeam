// Package vm is the BEAM: the arena its terms live in, the processes, the
// schedulers, the interpreter, the collector and the BIFs. It imports nothing
// of the board's; what the board gives it, the serial line, the locks and the
// pins, comes in through the hooks of hooks.ogo, so that the package is Go
// once given a package clause, and is tested on the host as it is run on the
// board. DESIGN.md says how it is laid out; tags.ogo, opcodes.ogo, atoms.ogo
// and biftab.ogo are generated from the packer's tables by obeam gen and not
// edited by hand.

// The image, as Load found it at the bottom of the arena: what the packer's
// Region laid out there, and internal/pack/region.go says how.
var (
	code      []uint32 // the instruction stream
	atoms     []uint32 // the atoms' names, by index: a name's long, as nameLen and nameAt read it
	funcs     []uint32 // quads by code offset: offset, module, function, arity with bit 8 for an export
	funs      []uint32 // triples by index: code offset, arity, free variables
	lines     []uint32 // triples by code offset: offset, file, line
	files     []uint32 // the files' names, as atoms holds the atoms'
	exStructs []uint32 // pairs: an Elixir struct's module, an atom, and its fields in their order, a list
	litEnd    uint32   // the literals are arena[headerLongs:litEnd]
)

var entryProc *Proc

// table answers the table a pair of the header's slots describes.
func table(slot int) []uint32 {
	at, n := arena[slot], arena[slot+1]
	return arena[at : at+n]
}

// Load starts the VM afresh on the image at the bottom of the arena: the
// rest of the arena goes to the allocator, and the process table is emptied.
// It reports whether there is an image there, one packed for the VM's
// tables. The hooks are set before it.
func Load() bool {
	n := arena[imgLongs]
	if arena[imgMagic] != imageMagic || arena[imgTableID] != TableID || n < headerLongs || n > arenaLongs {
		return false
	}
	code = table(imgCode)
	atoms = table(imgAtoms)
	funcs = table(imgFuncs)
	funs = table(imgFuns)
	lines = table(imgLines)
	files = table(imgFiles)
	exStructs = table(imgStructs)
	litEnd = arena[imgLitEnd]
	makeLocks()
	arenaInit((n + minBlock - 1) &^ (minBlock - 1))
	procsInit()
	coreAddrs()
	entryProc = nil
	return true
}

// Entry answers the code offset of the image's entry function, and CodeLongs
// the length of its code.
func Entry() uint32  { return arena[imgEntry] }
func CodeLongs() int { return len(code) }

// WriteEntry writes the entry function's module, name and arity to the
// serial line, as m:f/a.
func WriteEntry() {
	outName(atoms[arena[imgEntryMod]])
	out(':')
	outName(atoms[arena[imgEntryFun]])
	out('/')
	a := arena[imgEntryArity]
	if a >= 10 {
		out(byte('0' + a/10))
	}
	out(byte('0' + a%10))
}

// Start starts a process at a function of no arguments at the code offset
// entry, and n schedulers, each a goroutine, so a cog, which run it and what
// it spawns until it ends. It reports whether the process could be made.
func Start(entry uint32, n int) bool {
	p := spawn(entry, 0, 0)
	if p == nil {
		return false
	}
	entryProc = p
	enqueue(p)
	running = uint32(n)
	for i := 0; i < n; i++ {
		go schedule(i)
	}
	return true
}

// Finished reports whether the entry process has ended, after which the
// schedulers stop.
func Finished() bool {
	lock(lockRun)
	f := stopping
	unlock(lockRun)
	return f
}

// Running answers how many schedulers have not stopped yet.
func Running() int {
	lock(lockRun)
	r := running
	unlock(lockRun)
	return int(r)
}

// Succeeded reports whether the entry process ended normally rather than with
// an exception.
func Succeeded() bool {
	lock(lockRun)
	d := entryDone
	unlock(lockRun)
	return d == procExited
}

// Steps counts the instructions the schedulers have interpreted since Load,
// and Collections the collections.
func Steps() uint32 {
	n := uint32(0)
	for i := range scheds {
		n += scheds[i].steps
	}
	return n
}

func Collections() uint32 {
	n := uint32(0)
	for i := range scheds {
		n += scheds[i].gcs
	}
	return n
}

// Run starts the entry on n schedulers and waits for it to end; it reports
// whether it ended normally.
func Run(entry uint32, n int) bool {
	if !Start(entry, n) {
		return false
	}
	for !Finished() {
		idle()
	}
	for Running() > 0 {
		idle()
	}
	return Succeeded()
}

// schedule is a scheduler: it takes processes off the run queue and runs
// each for its turn, until the entry process has ended.
func schedule(id int) {
	s := &scheds[id]
	for {
		wakeExpired()
		p, stop := dequeue()
		if stop {
			break
		}
		if p == nil {
			idle()
			continue
		}
		var ended bool
		if Profile {
			ended = runProfiled(s, p)
		} else {
			ended = run(s, p)
		}
		if ended && p == entryProc {
			lock(lockRun)
			stopping = true
			unlock(lockRun)
		}
	}
	lock(lockRun)
	running--
	unlock(lockRun)
}
