// Links, monitors, exit signals and registered names. A process keeps the
// pids it is linked to, the processes that monitor it and the ones it
// monitors in a list of records of a pool shared by all, under its stripe's
// lock. When it ends, each link gets an exit signal, a message
// of a kind of its own, {'EXIT', Pid, Reason}, and each monitor the message
// {'DOWN', Ref, process, Pid, Reason}. A receiver that traps exits reads a
// signal as a message; one that does not ends with the signal's reason, unless
// the reason is normal, when the signal is dropped. Signals are looked at
// when the receiver's turn begins and when it receives.

const (
	maxRels  = 512    // links and monitors, two records each, of all processes together
	noRel    = 0xffff // the end of a list
	maxNames = 16     // registered names

	relLink  = 0 // a link to pid
	relMon   = 1 // a monitor of this process, by pid, under ref
	relWatch = 2 // a monitor of pid, by this process, under ref

	kindMessage = 0 // a fragment's kind, in bits 24 and up of its order word
	kindExit    = 1 // an exit signal, {'EXIT', From, Reason}
)

// A rel is one end's record of a link or a monitor: a link between two
// processes is a record in the list of each, and so is a monitor, the
// watcher's relWatch and the watched one's relMon. A process's list runs
// from its rels through next, under its stripe; the free records are a list
// under lockPool. It was four links and four monitors each, in the process's
// slot, until the table outgrew the hub RAM it had (DESIGN.md section 8).
type rel struct {
	next uint16
	kind uint8
	pid  uint32 // the other end
	ref  uint32 // a monitor's reference
}

var (
	rels    [maxRels]rel
	relFree uint16 // under lockPool
)

func relsInit() {
	for i := range rels {
		rels[i].next = uint16(i + 1)
	}
	rels[maxRels-1].next = noRel
	relFree = 0
}

// relAdd puts a record at the head of a process's list, under its stripe;
// it reports false when the pool has none left.
func relAdd(p *Proc, kind uint8, pid, ref uint32) bool {
	lock(lockPool)
	r := relFree
	if r != noRel {
		relFree = rels[r].next
	}
	unlock(lockPool)
	if r == noRel {
		return false
	}
	rels[r].next = p.rels
	rels[r].kind = kind
	rels[r].pid = pid
	rels[r].ref = ref
	p.rels = r
	return true
}

// relHas reports whether a process's list has a record of a kind with a pid,
// under its stripe.
func relHas(p *Proc, kind uint8, pid uint32) bool {
	for r := p.rels; r != noRel; r = rels[r].next {
		if rels[r].kind == kind && rels[r].pid == pid {
			return true
		}
	}
	return false
}

// relDrop takes the first record of a kind out of a process's list, under
// its stripe, a link's by its pid and a monitor's by its ref, and gives it
// back to the pool; it answers the record's pid, or 0 when there is none.
func relDrop(p *Proc, kind uint8, pid, ref uint32) uint32 {
	prev := uint16(noRel)
	for r := p.rels; r != noRel; r = rels[r].next {
		if rels[r].kind != kind || kind == relLink && rels[r].pid != pid || kind != relLink && rels[r].ref != ref {
			prev = r
			continue
		}
		if prev == noRel {
			p.rels = rels[r].next
		} else {
			rels[prev].next = rels[r].next
		}
		pid = rels[r].pid
		lock(lockPool)
		rels[r].next = relFree
		relFree = r
		unlock(lockPool)
		return pid
	}
	return 0
}

// relDropFrom is relDrop in the list of the process a pid names, while it
// lives, under its stripe.
func relDropFrom(of uint32, kind uint8, pid, ref uint32) uint32 {
	q := procOf(of)
	lock(stripe(q))
	r := uint32(0)
	if q.alive(of) {
		r = relDrop(q, kind, pid, ref)
	}
	unlock(stripe(q))
	return r
}

// relRelease gives a list that no process has any more back to the pool.
func relRelease(r uint16) {
	if r == noRel {
		return
	}
	last := r
	for rels[last].next != noRel {
		last = rels[last].next
	}
	lock(lockPool)
	rels[last].next = relFree
	relFree = r
	unlock(lockPool)
}

// A name is a registered process.
type name struct {
	atom uint32 // the term, or 0 for a free entry
	pid  uint32
}

var names [maxNames]name // under lockProcs

func namesInit() {
	for i := range names {
		names[i].atom = 0
	}
}

// A fragment's second long holds its block's order in bits 0-7, the size of
// the message in longs in bits 8-23, and its kind above. fragKind, fragOrder
// and fragSize read them.
func fragKind(b uint32) uint32  { return arena[b+1] >> 24 }
func fragOrder(b uint32) uint32 { return arena[b+1] & 0xff }
func fragSize(b uint32) uint32  { return arena[b+1] >> 8 & 0xffff }

// deliver appends a term to a process's mailbox as a message of a kind,
// copied into a fragment, and wakes the receiver if it waits; it reports
// false when there is no room. A process that is gone gets nothing. The
// caller holds no stripe.
func deliver(s *sched, to, msg, kind uint32) bool {
	size := termSize(s, msg)
	if size < 0 {
		return false
	}
	order := orderFor(fragHead + uint32(size))
	if order == 0xff {
		return false
	}
	b, low := fragAlloc(s, order)
	if b == noBlock {
		return false
	}
	root, _ := copyTerm(s, msg, b+fragHead)
	arena[b] = noBlock
	arena[b+1] = order | uint32(size)<<8 | kind<<24
	arena[b+2] = root
	p := procOf(to)
	lock(stripe(p))
	if !p.alive(to) {
		unlock(stripe(p))
		fragFree(s, b, order)
		return true
	}
	if low {
		p.lowMem = true
	}
	if p.mboxTail == noBlock {
		p.mboxHead = b
	} else {
		arena[p.mboxTail] = b
	}
	if p.mboxCur == noBlock {
		p.mboxCur = b
		p.mboxPrev = p.mboxTail
	}
	p.mboxTail = b
	if kind == kindExit {
		p.signaled = true
	}
	woke := p.state == procWaiting
	if woke {
		p.state = procRunnable
		p.timed = false
	}
	unlock(stripe(p))
	if woke {
		enqueue(p)
	}
	return true
}

// signals deals with the exit signals in the running process's mailbox: a
// signal is made a message when the process traps exits, dropped when its
// reason is normal, and ends the process otherwise, with that reason, killed
// for kill. It reports whether the process goes on.
func signals(s *sched) bool {
	p := s.cur
	lock(stripe(p))
	p.signaled = false
	prev := uint32(noBlock)
	b := p.mboxHead
	reason := uint32(0)
	for b != noBlock {
		next := arena[b]
		if fragKind(b) != kindExit {
			prev = b
			b = next
			continue
		}
		r := tupleElem(arena[b+2], 3)
		if p.trapExit && r != mkAtom(atomKill) {
			arena[b+1] &^= 0xff000000 // a message now
			prev = b
			b = next
			continue
		}
		// Out of the mailbox, whether dropped or fatal.
		if prev == noBlock {
			p.mboxHead = next
		} else {
			arena[prev] = next
		}
		if p.mboxTail == b {
			p.mboxTail = prev
		}
		if p.mboxCur == b {
			p.mboxCur = next
			p.mboxPrev = prev
		}
		if r != mkAtom(atomNormal) {
			reason = r
			if r == mkAtom(atomKill) {
				reason = mkAtom(atomKilled)
			}
			arena[b] = p.pending
			p.pending = b
			p.npending++
			unlock(stripe(p))
			endProc(s, reason)
			s.left = leftFail
			return false
		}
		arena[b] = p.pending
		p.pending = b
		p.npending++
		b = next
	}
	unlock(stripe(p))
	return true
}

// endProc ends the running process with an exit reason: its links get the
// signal, its monitors the message, the processes it monitors forget it, its
// name is given up, and it is freed. It is dead to a linker or a monitor from
// the same locked step that takes its list, so that none is added after and
// never told; the list is then its own, walked without a lock.
func endProc(s *sched, reason uint32) {
	p := s.cur
	state := uint8(procFailed)
	if reason == mkAtom(atomNormal) {
		state = procExited
	}
	lock(stripe(p))
	p.state = state
	list := p.rels
	p.rels = noRel
	unlock(stripe(p))
	self := p.pid()
	lock(lockProcs)
	for i := range names {
		if names[i].atom != 0 && names[i].pid == self {
			names[i].atom = 0
		}
	}
	unlock(lockProcs)
	told := false
	for r := list; r != noRel; r = rels[r].next {
		if rels[r].kind != relWatch {
			told = true
		}
	}
	if told {
		s.bargs[0] = reason
		s.nbargs = 1
		told = ensure(s, 4+6, 0)
		reason = s.bargs[0]
		s.nbargs = 0
	}
	sig, down := uint32(0), uint32(0)
	if told {
		i := p.htop
		arena[i] = mkHeader(hdrTuple, 3)
		arena[i+1] = mkAtom(atomEXIT)
		arena[i+2] = self
		arena[i+3] = reason
		sig = mkBoxed(i)
		down = i + 4
		arena[down] = mkHeader(hdrTuple, 5)
		arena[down+1] = mkAtom(atomDOWN)
		arena[down+2] = 0
		arena[down+3] = mkAtom(atomProcess)
		arena[down+4] = self
		arena[down+5] = reason
		p.htop += 4 + 6
	}
	for r := list; r != noRel; r = rels[r].next {
		pid, ref := rels[r].pid, rels[r].ref
		switch rels[r].kind {
		case relLink:
			relDropFrom(pid, relLink, self, 0)
			if told {
				deliver(s, pid, sig, kindExit)
			}
		case relMon:
			relDropFrom(pid, relWatch, 0, ref)
			if told {
				arena[down+2] = ref
				deliver(s, pid, mkBoxed(down), kindMessage)
			}
		case relWatch:
			relDropFrom(pid, relMon, 0, ref)
		}
	}
	relRelease(list)
	p.exit(state)
}

// unlinkFrom takes a pid out of another process's links.
func unlinkFrom(of, pid uint32) {
	relDropFrom(of, relLink, pid, 0)
}

// linkTo adds a pid to a process's links, under the stripe; it reports
// whether the process lives, and whether there was room in the pool.
func linkTo(of, pid uint32) (alive, room bool) {
	q := procOf(of)
	lock(stripe(q))
	alive, room = q.alive(of), true
	if alive && !relHas(q, relLink, pid) {
		room = relAdd(q, relLink, pid, 0)
	}
	unlock(stripe(q))
	return alive, room
}

// exitReason answers what a process that raised an exception exits with:
// {Reason, Stacktrace} of an error, the reason of an exit, {nocatch, V} of a
// throw; it is built on the process's heap, or is the reason alone when
// there is no room.
func exitReason(s *sched, class, reason, raw uint32) uint32 {
	switch class {
	case mkAtom(atomExit):
		return reason
	case mkAtom(atomThrow):
		s.bargs[0] = reason
		s.nbargs = 1
		if !ensure(s, 3, 0) {
			s.nbargs = 0
			return reason
		}
		reason = s.bargs[0]
		s.nbargs = 0
		i := s.cur.htop
		arena[i] = mkHeader(hdrTuple, 2)
		arena[i+1] = mkAtom(atomNocatch)
		arena[i+2] = reason
		s.cur.htop += 3
		return mkBoxed(i)
	}
	s.bargs[0] = reason
	s.bargs[1] = raw
	s.nbargs = 2
	stk := stackList(s, s.bargs[1], 0)
	if stk == nonValue || !ensure(s, 3, 0) {
		s.nbargs = 0
		return reason
	}
	reason = s.bargs[0]
	s.nbargs = 0
	i := s.cur.htop
	arena[i] = mkHeader(hdrTuple, 2)
	arena[i+1] = reason
	arena[i+2] = stk
	s.cur.htop += 3
	return mkBoxed(i)
}

// whereis answers the pid registered under an atom.
func whereis(atom uint32) (uint32, bool) {
	lock(lockProcs)
	for i := range names {
		if names[i].atom == atom {
			pid := names[i].pid
			unlock(lockProcs)
			return pid, true
		}
	}
	unlock(lockProcs)
	return 0, false
}
