// Maps. A map is a header and its keys in map-key order, the order of terms
// with every integer before every float, then their values in the same
// order: the header's size is twice the pairs, and the collector and the
// copier pass over a map as over a tuple, every word a term.
// internal/pack/order.go lays the literal ones out in the same order. A key
// is found by a binary search, and every change makes a new map, built in
// place at the heap's top. A map of any size is one such array, where OTP
// keeps one of more than 32 keys in a hash trie: past a few hundred keys a
// change here costs more, and a map of more than 32 keys is printed and
// listed in another order than OTP's.

func isMap(t uint32) bool { return boxKind(t) == hdrMap }

func mapPairs(t uint32) uint32 { return hdrSize(arena[boxIdx(t)]) >> 1 }

func mapKey(t, i uint32) uint32 { return arena[boxIdx(t)+1+i] }

func mapVal(t, i uint32) uint32 {
	b := boxIdx(t)
	return arena[b+1+hdrSize(arena[b])>>1+i]
}

// mapFind answers where a key is in a map, and whether it is there; where it
// is not, the index is where it would go.
func mapFind(s *sched, m, k uint32) (uint32, bool) {
	return keysFind(s, boxIdx(m)+1, mapPairs(m), k)
}

// keysFind searches n keys in map-key order from arena index at.
func keysFind(s *sched, at, n, k uint32) (uint32, bool) {
	lo, hi := uint32(0), n
	for lo < hi {
		mid := (lo + hi) >> 1
		c := cmpExact(s, arena[at+mid], k)
		if c == 0 {
			return mid, true
		}
		if c < 0 {
			lo = mid + 1
		} else {
			hi = mid
		}
	}
	return lo, false
}

// A map being built is at the heap's top, at, with room made for max pairs:
// its keys from at+1 and its values from at+1+max, n of them so far. mapStart
// copies a map into it, mapPut puts a pair, and mapEnd closes it: the values
// move down to follow the keys, the heap's top goes past them, and the map
// is the answer. Nothing between may allocate.

func mapStart(m, at, max uint32) uint32 {
	n := mapPairs(m)
	b := boxIdx(m)
	for i := uint32(0); i < n; i++ {
		arena[at+1+i] = arena[b+1+i]
		arena[at+1+max+i] = arena[b+1+n+i]
	}
	return n
}

// mapPut puts a key and its value into a map being built and answers how
// many pairs it has then; with only set, a key it does not have is not put,
// and the answer is false.
func mapPut(s *sched, at, max, n, k, v uint32, only bool) (uint32, bool) {
	i, found := keysFind(s, at+1, n, k)
	if found {
		arena[at+1+max+i] = v
		return n, true
	}
	if only {
		return n, false
	}
	for j := n; j > i; j-- {
		arena[at+1+j] = arena[at+j]
		arena[at+1+max+j] = arena[at+max+j]
	}
	arena[at+1+i] = k
	arena[at+1+max+i] = v
	return n + 1, true
}

func mapEnd(s *sched, at, max, n uint32) uint32 {
	if n < max {
		for i := uint32(0); i < n; i++ {
			arena[at+1+n+i] = arena[at+1+max+i]
		}
	}
	arena[at] = mkHeader(hdrMap, 2*n)
	s.cur.htop = at + 1 + 2*n
	return mkBoxed(at)
}

// put_map_assoc and put_map_exact: Fail, Src, Dst, Live, and the pairs, a
// count and the keys and values in turn. exact puts only keys the map has.
func hPutMapAssoc(s *sched, pc uint32) uint32 { return putMap(s, pc, false) }
func hPutMapExact(s *sched, pc uint32) uint32 { return putMap(s, pc, true) }

func putMap(s *sched, pc uint32, exact bool) uint32 {
	m := src(s, code[pc+2])
	if !isMap(m) {
		if fail := code[pc+1]; fail != 0 {
			return fail
		}
		return raiseTagged(s, atomError, atomBadmap, m)
	}
	u := code[pc+5] / 2
	max := mapPairs(m)
	if !exact {
		max += u
	}
	if !ensure(s, 1+2*max, int32(code[pc+4])) {
		return raiseAtom(s, atomError, atomSystemLimit)
	}
	m = src(s, code[pc+2])
	at := s.cur.htop
	n := mapStart(m, at, max)
	for j := uint32(0); j < u; j++ {
		k := src(s, code[pc+6+2*j])
		ok := false
		n, ok = mapPut(s, at, max, n, k, src(s, code[pc+7+2*j]), exact)
		if !ok {
			if fail := code[pc+1]; fail != 0 {
				return fail
			}
			return raiseTagged(s, atomError, atomBadkey, k)
		}
	}
	store(s, code[pc+3], mapEnd(s, at, max, n))
	return pc + 6 + 2*u
}

// get_map_elements: Fail, Src, and a count and keys and destinations in
// turn; a key the map does not have is the fail label's, and so is no map.
func hGetMapElements(s *sched, pc uint32) uint32 {
	m := src(s, code[pc+2])
	n := code[pc+3]
	if !isMap(m) {
		return code[pc+1]
	}
	for j := uint32(0); j < n; j += 2 {
		i, ok := mapFind(s, m, src(s, code[pc+4+j]))
		if !ok {
			return code[pc+1]
		}
		store(s, code[pc+5+j], mapVal(m, i))
	}
	return pc + 4 + n
}

// has_map_fields: Fail, Src, and a count and keys.
func hHasMapFields(s *sched, pc uint32) uint32 {
	m := src(s, code[pc+2])
	n := code[pc+3]
	if !isMap(m) {
		return code[pc+1]
	}
	for j := uint32(0); j < n; j++ {
		if _, ok := mapFind(s, m, src(s, code[pc+4+j])); !ok {
			return code[pc+1]
		}
	}
	return pc + 4 + n
}

func bifIsMap(s *sched, n uint32) uint32 { return boolTerm(isMap(s.bargs[0])) }

// bifMapSize is map_size/1 and maps:size/1.
func bifMapSize(s *sched, n uint32) uint32 {
	m := s.bargs[0]
	if !isMap(m) {
		return failTagged(s, atomBadmap, m)
	}
	return mkSmall(int32(mapPairs(m)))
}

// bifIsMapKey is is_map_key(Key, Map) and maps:is_key/2.
func bifIsMapKey(s *sched, n uint32) uint32 {
	k, m := s.bargs[0], s.bargs[1]
	if !isMap(m) {
		return failTagged(s, atomBadmap, m)
	}
	_, ok := mapFind(s, m, k)
	return boolTerm(ok)
}

// bifMapGet is map_get(Key, Map) and maps:get/2.
func bifMapGet(s *sched, n uint32) uint32 {
	k, m := s.bargs[0], s.bargs[1]
	if !isMap(m) {
		return failTagged(s, atomBadmap, m)
	}
	i, ok := mapFind(s, m, k)
	if !ok {
		return failTagged(s, atomBadkey, k)
	}
	return mapVal(m, i)
}

// bifMapsGet3 is maps:get(Key, Map, Default).
func bifMapsGet3(s *sched, n uint32) uint32 {
	k, m := s.bargs[0], s.bargs[1]
	if !isMap(m) {
		return failTagged(s, atomBadmap, m)
	}
	i, ok := mapFind(s, m, k)
	if !ok {
		return s.bargs[2]
	}
	return mapVal(m, i)
}

// bifMapsFind is maps:find(Key, Map): {ok, Value} or error.
func bifMapsFind(s *sched, n uint32) uint32 {
	k, m := s.bargs[0], s.bargs[1]
	if !isMap(m) {
		return failTagged(s, atomBadmap, m)
	}
	i, ok := mapFind(s, m, k)
	if !ok {
		return mkAtom(atomError)
	}
	if !ensure(s, 3, s.curLive) {
		return nonValue
	}
	v := mapVal(s.bargs[1], i)
	at := s.cur.htop
	arena[at] = mkHeader(hdrTuple, 2)
	arena[at+1] = mkAtom(atomOk)
	arena[at+2] = v
	s.cur.htop += 3
	return mkBoxed(at)
}

// bifMapsPut is maps:put(Key, Value, Map), and bifMapsUpdate maps:update/3,
// which puts only a key the map has.
func bifMapsPut(s *sched, n uint32) uint32    { return mapsPut(s, false) }
func bifMapsUpdate(s *sched, n uint32) uint32 { return mapsPut(s, true) }

func mapsPut(s *sched, only bool) uint32 {
	m := s.bargs[2]
	if !isMap(m) {
		return failTagged(s, atomBadmap, m)
	}
	max := mapPairs(m) + 1
	if !ensure(s, 1+2*max, s.curLive) {
		return nonValue
	}
	at := s.cur.htop
	c := mapStart(s.bargs[2], at, max)
	c, ok := mapPut(s, at, max, c, s.bargs[0], s.bargs[1], only)
	if !ok {
		return failTagged(s, atomBadkey, s.bargs[0])
	}
	return mapEnd(s, at, max, c)
}

// bifMapsRemove is maps:remove(Key, Map).
func bifMapsRemove(s *sched, n uint32) uint32 {
	k, m := s.bargs[0], s.bargs[1]
	if !isMap(m) {
		return failTagged(s, atomBadmap, m)
	}
	i, ok := mapFind(s, m, k)
	if !ok {
		return m
	}
	c := mapPairs(m) - 1
	if !ensure(s, 1+2*c, s.curLive) {
		return nonValue
	}
	m = s.bargs[1]
	at := s.cur.htop
	w := uint32(0)
	for j := uint32(0); j <= c; j++ {
		if j != i {
			arena[at+1+w] = mapKey(m, j)
			arena[at+1+c+w] = mapVal(m, j)
			w++
		}
	}
	arena[at] = mkHeader(hdrMap, 2*c)
	s.cur.htop = at + 1 + 2*c
	return mkBoxed(at)
}

// What mapList lists.
const (
	listKeys = iota
	listValues
	listPairs
)

// bifMapsKeys, bifMapsValues and bifMapsToList are maps:keys/1, values/1 and
// to_list/1, in map-key order.
func bifMapsKeys(s *sched, n uint32) uint32   { return mapList(s, listKeys) }
func bifMapsValues(s *sched, n uint32) uint32 { return mapList(s, listValues) }
func bifMapsToList(s *sched, n uint32) uint32 { return mapList(s, listPairs) }

func mapList(s *sched, which int) uint32 {
	m := s.bargs[0]
	if !isMap(m) {
		return failTagged(s, atomBadmap, m)
	}
	c := mapPairs(m)
	per := uint32(2)
	if which == listPairs {
		per = 5
	}
	if !ensure(s, per*c, s.curLive) {
		return nonValue
	}
	m = s.bargs[0]
	at := s.cur.htop
	l := uint32(nilTerm)
	for j := c; j > 0; j-- {
		e := mapKey(m, j-1)
		switch which {
		case listValues:
			e = mapVal(m, j-1)
		case listPairs:
			arena[at] = mkHeader(hdrTuple, 2)
			arena[at+1] = mapKey(m, j-1)
			arena[at+2] = mapVal(m, j-1)
			e = mkBoxed(at)
			at += 3
		}
		arena[at] = e
		arena[at+1] = l
		l = mkCons(at)
		at += 2
	}
	s.cur.htop = at
	return l
}

// bifMapsFromList is maps:from_list/1 of {Key, Value} tuples, the later of
// two pairs with a key kept.
func bifMapsFromList(s *sched, n uint32) uint32 {
	c := uint32(0)
	for l := s.bargs[0]; l != nilTerm; l = arena[consIdx(l)+1] {
		if !isCons(l) {
			return badarg(s)
		}
		e := arena[consIdx(l)]
		if !isTuple(e) || tupleArity(e) != 2 {
			return badarg(s)
		}
		c++
	}
	if !ensure(s, 1+2*c, s.curLive) {
		return nonValue
	}
	at := s.cur.htop
	k := uint32(0)
	for l := s.bargs[0]; l != nilTerm; l = arena[consIdx(l)+1] {
		e := arena[consIdx(l)]
		k, _ = mapPut(s, at, c, k, tupleElem(e, 1), tupleElem(e, 2), false)
	}
	return mapEnd(s, at, c, k)
}

// bifMapsMerge is maps:merge/2, the second map's value kept for a key both
// have.
func bifMapsMerge(s *sched, n uint32) uint32 {
	a, b := s.bargs[0], s.bargs[1]
	if !isMap(a) {
		return failTagged(s, atomBadmap, a)
	}
	if !isMap(b) {
		return failTagged(s, atomBadmap, b)
	}
	max := mapPairs(a) + mapPairs(b)
	if !ensure(s, 1+2*max, s.curLive) {
		return nonValue
	}
	a, b = s.bargs[0], s.bargs[1]
	at := s.cur.htop
	c := mapStart(a, at, max)
	for j := uint32(0); j < mapPairs(b); j++ {
		c, _ = mapPut(s, at, max, c, mapKey(b, j), mapVal(b, j), false)
	}
	return mapEnd(s, at, max, c)
}

// bifMapsNew is maps:new/0.
func bifMapsNew(s *sched, n uint32) uint32 {
	if !ensure(s, 1, s.curLive) {
		return nonValue
	}
	at := s.cur.htop
	arena[at] = mkHeader(hdrMap, 0)
	s.cur.htop++
	return mkBoxed(at)
}
