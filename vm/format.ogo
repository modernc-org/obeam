// Writing terms and io:format, byte by byte and with no recursion: a compound
// term's parts wait on a stack of the scheduler's. What a directive writes
// goes through the scheduler's capture buffer first when it has a width, so
// that it can be padded.

const (
	writeDepth = 64
	capSize    = 256 // the most a padded directive can write
)

// A wframe is a compound term being written: a list, with what is left of it
// in t, a tuple, with its next element in i, counted from 1, or a map, with
// its next pair in i, counted from 0.
type wframe struct {
	t     uint32
	i     uint32
	list  bool
	first bool // of a list: nothing written after the bracket yet
	tail  bool // of a list: an improper tail has been written, the bracket is owed
	kw    bool // of a list Elixir writes as a keyword list, [a: 1]; of a map, as %{a: 1}
	isMap bool
	val   bool // of a map: the key of pair i has been written, its value is next
	st    bool // of a map Elixir writes as a struct: u is the fields left to write
	u     uint32
}

// emit writes a byte of output: into the capture buffer while one is open,
// else to the output hook.
func emit(s *sched, b byte) {
	if s.binAt != 0 {
		// Into a binary being made, its longs zeroed.
		arena[s.binAt+s.binPos/4] |= uint32(b) << (8 * (s.binPos % 4))
		s.binPos++
		return
	}
	if s.ncap >= 0 {
		if s.ncap < capSize {
			s.cap[s.ncap] = b
		}
		s.ncap++
		return
	}
	out(b)
}

func emits(s *sched, str string) {
	for i := 0; i < len(str); i++ {
		emit(s, str[i])
	}
}

// writeTerm writes a term as ~w does, or as ~p does when pretty is set: a
// list of printable characters as a string, a binary of them as <<"...">>.
func writeTerm(s *sched, t uint32, pretty bool) {
	sp := 0
	wpush(s, &sp, t, pretty)
	for sp > 0 {
		f := &s.wstack[sp-1]
		if f.isMap {
			if f.val {
				emits(s, " => ")
				f.val = false
				f.i++
				wpush(s, &sp, mapVal(f.t, f.i-1), pretty)
				continue
			}
			if f.i == mapPairs(f.t) {
				emit(s, '}')
				sp--
				continue
			}
			if f.i > 0 {
				emit(s, ',')
			}
			f.val = true
			wpush(s, &sp, mapKey(f.t, f.i), pretty)
			continue
		}
		if !f.list {
			if f.i > tupleArity(f.t) {
				emit(s, '}')
				sp--
				continue
			}
			if f.i > 1 {
				emit(s, ',')
			}
			e := tupleElem(f.t, f.i)
			f.i++
			wpush(s, &sp, e, pretty)
			continue
		}
		if f.tail || f.t == nilTerm {
			emit(s, ']')
			sp--
			continue
		}
		if !isCons(f.t) {
			emit(s, '|')
			f.tail = true
			wpush(s, &sp, f.t, pretty)
			continue
		}
		if !f.first {
			emit(s, ',')
		}
		f.first = false
		i := consIdx(f.t)
		f.t = arena[i+1]
		wpush(s, &sp, arena[i], pretty)
	}
}

// wpush writes a term that has no parts, or opens a compound one and puts it
// on the stack.
func wpush(s *sched, sp *int, t uint32, pretty bool) {
	switch {
	case isCons(t):
		if pretty && isString(t) {
			writeString(s, t)
			return
		}
		if *sp == writeDepth {
			panic("vm: a term nested too deeply to write")
		}
		emit(s, '[')
		s.wstack[*sp] = wframe{t: t, list: true, first: true}
		*sp++
	case isTuple(t):
		if *sp == writeDepth {
			panic("vm: a term nested too deeply to write")
		}
		emit(s, '{')
		s.wstack[*sp] = wframe{t: t, i: 1}
		*sp++
	case isMap(t):
		if *sp == writeDepth {
			panic("vm: a term nested too deeply to write")
		}
		emits(s, "#{")
		s.wstack[*sp] = wframe{t: t, isMap: true}
		*sp++
	default:
		writeFlat(s, t, pretty)
	}
}

// writeFlat writes a term that has no parts.
func writeFlat(s *sched, t uint32, pretty bool) {
	switch {
	case isSmall(t) || isInt64(t):
		writeInt(s, intVal(t))
	case isAtom(t):
		writeAtom(s, t)
	case t == nilTerm:
		emits(s, "[]")
	case isPid(t):
		emits(s, "<0.")
		writeInt(s, int64(pidIdx(t)))
		emit(s, '.')
		writeInt(s, int64(t>>(5+pidIndexBits)))
		emit(s, '>')
	case isRef(t):
		emits(s, "#Ref<0.")
		writeInt(s, int64(t>>5))
		emit(s, '>')
	case isFun(t):
		if funKind(t) == funExport {
			if m, f, a, ok := funcAt(funCode(t)); ok {
				emits(s, "fun ")
				writeAtom(s, m)
				emit(s, ':')
				writeAtom(s, f)
				emit(s, '/')
				writeInt(s, int64(a))
				return
			}
		}
		emits(s, "#Fun<")
		writeInt(s, int64(funCode(t)))
		emit(s, '.')
		writeInt(s, int64(funArity(t)))
		emit(s, '>')
	case isBinary(t):
		writeBinary(s, t, pretty)
	case isFloat(t):
		writeFloat(s, floatVal(t))
	default:
		emits(s, "#Term<")
		writeInt(s, int64(t))
		emit(s, '>')
	}
}

// writeInt writes an integer in decimal; writeIntBase in a base from 2 to
// 36, in capitals when upper is set.
func writeInt(s *sched, v int64) { writeIntBase(s, v, 10, true) }

func writeIntBase(s *sched, v int64, base int64, upper bool) {
	var buf [64]byte
	i := len(buf)
	neg := v < 0
	for {
		i--
		d := v % base
		if d < 0 {
			d = -d
		}
		if d < 10 {
			buf[i] = byte('0' + d)
		} else if upper {
			buf[i] = byte('A' + d - 10)
		} else {
			buf[i] = byte('a' + d - 10)
		}
		v /= base
		if v == 0 {
			break
		}
	}
	if neg {
		emit(s, '-')
	}
	for ; i < len(buf); i++ {
		emit(s, buf[i])
	}
}

// writeAtom writes an atom, quoted where Erlang quotes it.
func writeAtom(s *sched, t uint32) {
	name := atomName(t)
	if !atomNeedsQuotes(name) {
		emits(s, name)
		return
	}
	emit(s, '\'')
	for i := 0; i < len(name); i++ {
		writeChar(s, name[i], '\'')
	}
	emit(s, '\'')
}

func atomNeedsQuotes(name string) bool {
	if len(name) == 0 || isReserved(name) {
		return true
	}
	for i := 0; i < len(name); i++ {
		c := name[i]
		switch {
		case c >= 'a' && c <= 'z':
		case i > 0 && (c >= 'A' && c <= 'Z' || c >= '0' && c <= '9' || c == '_' || c == '@'):
		default:
			return true
		}
	}
	return false
}

var reserved = [29]string{
	"after", "and", "andalso", "band", "begin", "bnot", "bor", "bsl", "bsr", "bxor",
	"case", "catch", "cond", "div", "else", "end", "fun", "if", "let", "maybe",
	"not", "of", "or", "orelse", "receive", "rem", "try", "when", "xor",
}

func isReserved(name string) bool {
	for i := range reserved {
		if reserved[i] == name {
			return true
		}
	}
	return false
}

// writeChar writes a character inside quotes, escaped as Erlang escapes it.
func writeChar(s *sched, c byte, quote byte) {
	switch c {
	case quote, '\\':
		emit(s, '\\')
		emit(s, c)
	case '\n':
		emits(s, `\n`)
	case '\t':
		emits(s, `\t`)
	case '\r':
		emits(s, `\r`)
	case '\b':
		emits(s, `\b`)
	case '\f':
		emits(s, `\f`)
	case '\v':
		emits(s, `\v`)
	case 27:
		emits(s, `\e`)
	default:
		if c < 32 || c == 127 {
			emit(s, '\\')
			emit(s, '0'+c>>6)
			emit(s, '0'+c>>3&7)
			emit(s, '0'+c&7)
			return
		}
		emit(s, c)
	}
}

func printable(c uint32) bool {
	switch c {
	case '\n', '\t', '\r', '\b', '\f', '\v', 27:
		return true
	}
	return c >= 32 && c <= 126 || c >= 160 && c <= 255
}

// isString reports whether a list is one ~p prints as a string: not empty,
// every element a printable character.
func isString(t uint32) bool {
	if t == nilTerm {
		return false
	}
	for isCons(t) {
		i := consIdx(t)
		h := arena[i]
		if !isSmall(h) || smallVal(h) < 0 || !printable(uint32(smallVal(h))) {
			return false
		}
		t = arena[i+1]
	}
	return t == nilTerm
}

func writeString(s *sched, t uint32) {
	emit(s, '"')
	for isCons(t) {
		i := consIdx(t)
		writeChar(s, byte(smallVal(arena[i])), '"')
		t = arena[i+1]
	}
	emit(s, '"')
}

// writeBinary writes a binary as ~w does, its bytes, or as ~p does when
// pretty is set, as a string when every byte is printable.
func writeBinary(s *sched, t uint32, pretty bool) {
	emits(s, "<<")
	n := binaryLen(t)
	text := pretty && n > 0
	for k := uint32(0); k < n && text; k++ {
		text = printable(uint32(binaryByte(t, k)))
	}
	if text {
		emit(s, '"')
		for k := uint32(0); k < n; k++ {
			writeChar(s, binaryByte(t, k), '"')
		}
		emit(s, '"')
	} else {
		for k := uint32(0); k < n; k++ {
			if k > 0 {
				emit(s, ',')
			}
			writeInt(s, int64(binaryByte(t, k)))
		}
	}
	emits(s, ">>")
}

// floatVal returns a boxed float's value.
func floatVal(t uint32) float32 {
	return floatOf(arena[boxIdx(t)+1])
}

// writeChars writes a list of characters, a binary or an atom, and reports
// whether it was one; a list within the list, which io would take, is not
// taken, so that nothing here recurses.
func writeChars(s *sched, t uint32) bool {
	if isBinary(t) {
		n := binaryLen(t)
		for k := uint32(0); k < n; k++ {
			emit(s, binaryByte(t, k))
		}
		return true
	}
	if isAtom(t) {
		emits(s, atomName(t))
		return true
	}
	for isCons(t) {
		i := consIdx(t)
		h := arena[i]
		if !isSmall(h) {
			return false
		}
		emit(s, byte(smallVal(h)))
		t = arena[i+1]
	}
	return t == nilTerm
}

// format writes a format string with its arguments as io:format does: the
// directives ~w, ~p, ~s, ~c, ~B, ~b, ~e, ~f, ~g, ~n, ~i and ~~, each with a
// field width, negative for left justified, a precision and a padding
// character as Erlang writes them, ~F.P.PadC, * taking any of the three from
// the arguments. It reports whether the format and the arguments were well
// formed. ~p does not break a long term over lines as Erlang's does.
func format(s *sched, fmtT, args uint32) bool {
	n := formatString(s, fmtT)
	if n < 0 {
		return false
	}
	for k := 0; k < n; k++ {
		c := s.fbuf[k]
		if c != '~' {
			emit(s, c)
			continue
		}
		var ok bool
		k, args, ok = directive(s, k+1, n, args)
		if !ok {
			return false
		}
	}
	return args == nilTerm
}

// formatString copies the format, a list, a binary or an atom, into the
// scheduler's buffer and answers its length, or -1 for what is none.
func formatString(s *sched, t uint32) int {
	n := 0
	if isBinary(t) {
		for k := uint32(0); k < binaryLen(t) && n < len(s.fbuf); k++ {
			s.fbuf[n] = binaryByte(t, k)
			n++
		}
		return n
	}
	if isAtom(t) {
		name := atomName(t)
		for k := 0; k < len(name) && n < len(s.fbuf); k++ {
			s.fbuf[n] = name[k]
			n++
		}
		return n
	}
	if !isList(t) {
		return -1
	}
	for isCons(t) && n < len(s.fbuf) {
		i := consIdx(t)
		if !isSmall(arena[i]) {
			return -1
		}
		s.fbuf[n] = byte(smallVal(arena[i]))
		n++
		t = arena[i+1]
	}
	return n
}

// directive reads one directive from k, ~F.P.PadC, writes it, and answers
// where the format goes on, what is left of the arguments, and whether all
// was well.
func directive(s *sched, k, n int, args uint32) (int, uint32, bool) {
	width, prec := -1, -1
	left := false
	pad := byte(' ')
	if k < n && s.fbuf[k] == '-' {
		left = true
		k++
	}
	if k < n && s.fbuf[k] == '*' {
		v, rest, ok := nextInt(args)
		if !ok {
			return k, args, false
		}
		args = rest
		if v < 0 {
			left = true
			v = -v
		}
		width = v
		k++
	} else {
		width, k = digits(s, k, n)
	}
	if k < n && s.fbuf[k] == '.' {
		k++
		if k < n && s.fbuf[k] == '*' {
			v, rest, ok := nextInt(args)
			if !ok {
				return k, args, false
			}
			args = rest
			prec = v
			k++
		} else {
			prec, k = digits(s, k, n)
		}
		if k < n && s.fbuf[k] == '.' {
			k++
			if k < n && s.fbuf[k] == '*' {
				v, rest, ok := nextInt(args)
				if !ok {
					return k, args, false
				}
				args = rest
				pad = byte(v)
				k++
			} else if k < n {
				pad = s.fbuf[k]
				k++
			}
		}
	}
	for k < n && (s.fbuf[k] == 't' || s.fbuf[k] == 'l' || s.fbuf[k] == 'k' || s.fbuf[k] == 'K') {
		k++
	}
	if k >= n {
		return k, args, false
	}
	d := s.fbuf[k]
	switch d {
	case 'n':
		if width < 0 {
			width = 1
		}
		for ; width > 0; width-- {
			emit(s, '\n')
		}
		return k, args, true
	case '~':
		emit(s, '~')
		return k, args, true
	case 'i':
		if !isCons(args) {
			return k, args, false
		}
		return k, arena[consIdx(args)+1], true
	}
	if !isCons(args) {
		return k, args, false
	}
	a := arena[consIdx(args)]
	args = arena[consIdx(args)+1]
	s.ncap = 0
	ok := writeDirective(s, d, a, width, prec)
	got := s.ncap
	s.ncap = -1
	if !ok {
		return k, args, false
	}
	padded(s, got, width, left, pad)
	return k, args, true
}

// digits reads a number of the format, answering -1 and k for none.
func digits(s *sched, k, n int) (int, int) {
	v := -1
	for k < n && s.fbuf[k] >= '0' && s.fbuf[k] <= '9' {
		if v < 0 {
			v = 0
		}
		v = v*10 + int(s.fbuf[k]-'0')
		k++
	}
	return v, k
}

// writeDirective writes one argument as a directive says, into the capture
// buffer, and reports whether the argument was one the directive takes.
func writeDirective(s *sched, d byte, a uint32, width, prec int) bool {
	switch d {
	case 'w':
		writeTerm(s, a, false)
	case 'p':
		writeTerm(s, a, true)
	case 's':
		if !writeChars(s, a) {
			return false
		}
		if prec >= 0 && s.ncap > int32(prec) {
			s.ncap = int32(prec)
		}
	case 'c':
		if !isSmall(a) {
			return false
		}
		times := 1
		if prec >= 0 {
			times = prec
		} else if width >= 0 {
			times = width
		}
		for ; times > 0; times-- {
			emit(s, byte(smallVal(a)))
		}
	case 'B', 'b':
		if !isInteger(a) {
			return false
		}
		base := int64(10)
		if prec >= 2 && prec <= 36 {
			base = int64(prec)
		}
		writeIntBase(s, intVal(a), base, d == 'B')
	case 'e', 'f', 'g':
		if !isNumber(a) {
			return false
		}
		f := float32(numVal(a))
		if prec < 0 {
			prec = 6
		}
		switch d {
		case 'e':
			writeExp(s, f, prec)
		case 'f':
			writeFixed(s, f, prec)
		default:
			writeGeneral(s, f, prec)
		}
	default:
		return false
	}
	return true
}

// padded writes what the capture buffer holds, got bytes, in a field of a
// width, padded on the left, or on the right when left is set.
func padded(s *sched, got int32, width int, left bool, pad byte) {
	if got > capSize {
		got = capSize
	}
	if !left {
		for w := int32(width); w > got; w-- {
			out(pad)
		}
	}
	for i := int32(0); i < got; i++ {
		out(s.cap[i])
	}
	if left {
		for w := int32(width); w > got; w-- {
			out(pad)
		}
	}
}

// nextInt takes the next argument, which must be a small integer, and
// answers it with what is left of the arguments.
func nextInt(args uint32) (int, uint32, bool) {
	if !isCons(args) {
		return 0, args, false
	}
	a := arena[consIdx(args)]
	if !isSmall(a) {
		return 0, args, false
	}
	return int(smallVal(a)), arena[consIdx(args)+1], true
}
