// Processes and schedulers: the table, a process's block with its heap
// growing up and its stack down, its mailbox, the run queue, and what each
// scheduler keeps of its own.

const (
	maxProcs   = 1 << pidIndexBits
	maxX       = 64 // X registers
	maxSaveX   = maxArity
	initOrder  = 6 // a new process's block: 64 longs
	reductions = 2000
	maxPending = 4 // messages taken out of the mailbox and still in their fragments, before a collection is forced: a hundred processes with fifteen each ran a 96 KB arena dry
	noProc     = 0xffffffff
	nsched     = 7 // schedulers at most: the cogs besides main's

	procFree = iota
	procRunnable
	procRunning
	procWaiting
	procExited // ended normally
	procFailed // ended by an exception
)

// A Proc is a process: its slot of the table. Its state, mailbox and timer
// are read and written under its stripe's lock by whoever is not its
// scheduler; its heap and registers are its scheduler's alone.
type Proc struct {
	state uint8
	used  bool   // the slot is taken, under lockProcs; the state is the stripe's
	idx   uint32 // in the table
	gen   uint32 // of the slot, counted up when it is reused
	block uint32 // the heap block's arena index
	order uint32 // and its order
	htop  uint32 // the heap's top: the next free long
	stop  uint32 // the stack's top: its lowest used long; the stack is [stop, block end)
	pc    uint32 // where it continues
	cp    uint32 // the continuation: the code offset a return goes to, 0 for none
	reds  int32
	next  uint32 // the run queue's link: the next process's index, or noProc

	catches uint32 // catch tags on the stack

	// Links and monitors, under the stripe: the pids this process is linked
	// to, the processes that monitor it, and the ones it monitors.
	links    [maxLinks]uint32
	nlinks   uint32
	mons     [maxLinks]monitor
	nmons    uint32
	watching [maxLinks]monitor
	nwatch   uint32
	trapExit bool
	signaled bool // an exit signal waits in the mailbox

	// The X registers saved while it is not running: a call's arguments, or
	// nothing at a receive.
	xsave [maxSaveX]uint32
	nsave uint32

	// The mailbox: fragments linked through their first long, and the one a
	// receive is looking at, cur, with the one before it, prev, for taking
	// it out; cur is noBlock at the end.
	mboxHead, mboxTail uint32
	mboxCur, mboxPrev  uint32

	// The fragments of messages taken out and not yet copied to the heap,
	// which the next collection does.
	pending  uint32
	npending uint32
	forceGC  bool

	// A receive's timeout: when it ends, and where the process continues.
	deadline  uint32
	timed     bool
	timeoutPC uint32
}

// A sched is what a scheduler keeps of its own: the process it runs and its
// X registers, a BIF's arguments and its verdict, the collector's and the
// copier's pointers, the stacks of comparing and writing terms, a buffer for
// a format, and its counts. There is one for each scheduler cog, so that no
// cog shares any of it; every function that touches one is given it.
type sched struct {
	id      uint32
	cur     *Proc
	x       [maxX]uint32
	bargs   [4]uint32 // a BIF's arguments
	nbargs  uint32    // how many of them
	curLive int32     // how many X registers are live while a BIF runs, or -1 for a BIF that may not allocate

	// What a failing BIF failed with, for the handler to raise or to skip to
	// the fail label; and where a BIF that answers jumpValue has the process
	// go on, with how many X registers set.
	bifClass  uint32 // an atom index
	bifReason uint32 // a term
	bifTag    uint32 // an atom index when the reason is {Tag, bifReason}, else noTag
	bifJump   uint32
	bifLive   uint32

	gcTo    uint32 // the new block's allocation pointer while a collection runs
	gcFrom  uint32 // the old block
	gcFromE uint32 // and its end
	gcNew   uint32 // the new block
	gcNewE  uint32 // and its end
	cpTo    uint32 // where a copy writes next

	fr       [maxFR]float32 // the float registers
	dr, ds   nat            // the digit search's numbers, float.ogo's shortest
	dmp, dmm nat
	dt       nat
	msgStack [msgDepth]uint32
	cmpA     [cmpDepth]uint32
	cmpB     [cmpDepth]uint32
	wstack   [writeDepth]wframe
	fbuf     [256]byte     // a format string being written
	cap      [capSize]byte // what a padded directive wrote
	ncap     int32         // how much of it, or -1 while nothing is captured

	steps uint32 // instructions interpreted
	gcs   uint32 // collections
	refs  uint32 // references made
	left  uint8  // why the last turn ended: leftEnd, leftYield, leftWait or leftFail
}

const (
	leftEnd = iota
	leftYield
	leftWait
	leftFail
)

var (
	procs     [maxProcs]Proc
	scheds    [nsched]sched
	runHead   uint32 // the run queue, under lockRun
	runTail   uint32
	stopping  bool             // under lockRun: the entry process has ended
	entryDone uint8            // under lockRun: how it ended
	running   uint32           // under lockRun: schedulers in their loops
	timers    [maxProcs]uint32 // under lockRun: the processes waiting with a timeout, by index; an entry may be stale
	ntimers   uint32
	fakeMs    uint32 // the clock where there is no Millis hook: a tick a reading
)

func procsInit() {
	for i := range procs {
		procs[i].state = procFree
		procs[i].used = false
		procs[i].idx = uint32(i)
	}
	for i := range scheds {
		scheds[i].id = uint32(i)
		scheds[i].ncap = -1
		scheds[i].cur = nil
		scheds[i].steps = 0
		scheds[i].gcs = 0
		scheds[i].refs = 0
	}
	namesInit()
	runHead = noProc
	runTail = noProc
	stopping = false
	entryDone = procFree
	running = 0
	ntimers = 0
	fakeMs = 0
}

// now is the time in milliseconds.
func now() uint32 {
	if Millis == nil {
		fakeMs++
		return fakeMs
	}
	return Millis()
}

// spawn makes a process that begins at a code offset with nargs arguments,
// which the caller puts in its xsave, with a block large enough for them to
// be copied in, and returns nil when the table or the arena is full. It is
// not queued yet.
func spawn(entry, nargs, argLongs uint32) *Proc {
	order := orderFor(argLongs + 1<<initOrder)
	if order == 0xff {
		return nil
	}
	b := allocBlock(order)
	if b == noBlock {
		return nil
	}
	lock(lockProcs)
	var p *Proc
	for i := range procs {
		if !procs[i].used {
			p = &procs[i]
			p.used = true
			break
		}
	}
	unlock(lockProcs)
	if p == nil {
		freeBlock(b, order)
		return nil
	}
	lock(stripe(p))
	p.state = procRunnable
	p.gen++
	p.block = b
	p.order = order
	p.htop = b
	p.stop = b + 1<<order
	p.pc = entry
	p.cp = 0
	p.reds = reductions
	p.next = noProc
	p.catches = 0
	p.nlinks = 0
	p.nmons = 0
	p.nwatch = 0
	p.trapExit = false
	p.signaled = false
	p.nsave = nargs
	p.mboxHead = noBlock
	p.mboxTail = noBlock
	p.mboxCur = noBlock
	p.mboxPrev = noBlock
	p.pending = noBlock
	p.npending = 0
	p.forceGC = false
	p.timed = false
	unlock(stripe(p))
	return p
}

func (p *Proc) pid() uint32 { return mkPid(p.idx, p.gen) }

func (p *Proc) blockEnd() uint32 { return p.block + 1<<p.order }

// alive reports whether a pid names this process still, under its stripe's
// lock.
func (p *Proc) alive(pid uint32) bool {
	return p.gen == pid>>(5+pidIndexBits) && p.state != procFree && p.state != procExited && p.state != procFailed
}

// procOf returns the slot a pid names; whether the process is still there is
// alive's question.
func procOf(pid uint32) *Proc { return &procs[pidIdx(pid)] }

// enqueue puts a process at the end of the run queue; the caller has made it
// runnable under its stripe's lock.
func enqueue(p *Proc) {
	lock(lockRun)
	p.next = noProc
	if runTail == noProc {
		runHead = p.idx
	} else {
		procs[runTail].next = p.idx
	}
	runTail = p.idx
	unlock(lockRun)
}

// dequeue takes the process at the head of the run queue, or nil; it also
// says whether the schedulers are to stop.
func dequeue() (*Proc, bool) {
	lock(lockRun)
	if stopping {
		unlock(lockRun)
		return nil, true
	}
	if runHead == noProc {
		unlock(lockRun)
		return nil, false
	}
	p := &procs[runHead]
	runHead = p.next
	if runHead == noProc {
		runTail = noProc
	}
	unlock(lockRun)
	return p, false
}

// exit ends a process: its state is free under its stripe's lock and its slot
// under the table's, and its block and fragments go back to the pool. How
// the entry process ended is kept for Succeeded.
func (p *Proc) exit(state uint8) {
	lock(stripe(p))
	p.state = procFree
	p.timed = false
	mbox, pend := p.mboxHead, p.pending
	p.mboxHead = noBlock
	p.mboxTail = noBlock
	p.mboxCur = noBlock
	p.mboxPrev = noBlock
	p.pending = noBlock
	unlock(stripe(p))
	if p == entryProc {
		lock(lockRun)
		entryDone = state
		unlock(lockRun)
	}
	freeBlock(p.block, p.order)
	freeFragments(mbox)
	freeFragments(pend)
	lock(lockProcs)
	p.used = false
	unlock(lockProcs)
}

// yreg returns the arena index of y register i of the running process.
func yreg(s *sched, i uint32) uint32 { return s.cur.stop + 1 + i }

// src returns the value of a source operand: a term as it is, or the register
// a marker names.
func src(s *sched, v uint32) uint32 {
	if v&7 != 7 {
		return v
	}
	if v&8 == 0 {
		return s.x[v>>4]
	}
	return arena[s.cur.stop+1+v>>4]
}

// store writes a value to the register a marker names.
func store(s *sched, d, v uint32) {
	if d&8 == 0 {
		s.x[d>>4] = v
		return
	}
	arena[s.cur.stop+1+d>>4] = v
}

// ensure makes room for n longs on the running process's heap, collecting if
// it must, with live X registers as roots. It reports whether there is room;
// when there is not, the BIF fails with system_limit.
func ensure(s *sched, n uint32, live int32) bool {
	if s.cur.htop+n <= s.cur.stop && !s.cur.forceGC {
		return true
	}
	if live < 0 {
		panic("vm: a BIF allocated where none may")
	}
	if !gc(s, uint32(live), n, 0) {
		failAtom(s, atomSystemLimit)
		return false
	}
	return true
}

// yield ends the running process's turn at a call: its arguments, live
// X registers, are saved, and it goes to the end of the run queue, to go on
// at target.
func yield(s *sched, target, live uint32) uint32 {
	p := s.cur
	for i := uint32(0); i < live; i++ {
		p.xsave[i] = s.x[i]
	}
	p.nsave = live
	p.pc = target
	p.reds = reductions
	lock(stripe(p))
	p.state = procRunnable
	unlock(stripe(p))
	enqueue(p)
	s.left = leftYield
	return 0
}

// sleep puts the running process to wait for a message, to go on at the
// receive's label, and, when timed, at timeoutPC once the time has passed.
// A message that came since the receive looked is seen here, under the
// lock, and the process goes on at once instead.
func sleep(s *sched, label uint32, timed bool, ms uint32, timeoutPC uint32) uint32 {
	p := s.cur
	lock(stripe(p))
	if p.mboxCur != noBlock {
		unlock(stripe(p))
		return label
	}
	p.state = procWaiting
	p.nsave = 0
	p.pc = label
	p.timed = timed
	if timed {
		p.deadline = now() + ms
		p.timeoutPC = timeoutPC
		// On the timer list under the stripe still, so that a walker's
		// verdict on an entry of this process and the entry's removal
		// cannot come between the wait and its entry.
		lock(lockRun)
		if ntimers < maxProcs {
			timers[ntimers] = p.idx
			ntimers++
		}
		unlock(lockRun)
	}
	unlock(stripe(p))
	s.left = leftWait
	return 0
}

// wakeExpired queues every process whose timeout has passed, and forgets the
// entries of the timer list that no longer stand for a timed wait. The
// verdict on an entry and the entry's removal are one step under the
// process's stripe, the run queue's lock taken inside it, which the lock order
// allows; two walkers at once cannot otherwise remove a valid entry on a
// stale verdict. The run queue's lock is never held while a stripe is taken.
func wakeExpired() {
	t := now()
	for i := uint32(0); ; i++ {
		lock(lockRun)
		if i >= ntimers {
			unlock(lockRun)
			return
		}
		p := &procs[timers[i]]
		unlock(lockRun)
		lock(stripe(p))
		stale := p.state != procWaiting || !p.timed
		woke := !stale && int32(t-p.deadline) >= 0
		if woke {
			p.timed = false
			p.pc = p.timeoutPC
			p.state = procRunnable
		}
		if stale || woke {
			lock(lockRun)
			if i < ntimers && &procs[timers[i]] == p {
				ntimers--
				timers[i] = timers[ntimers]
				i--
			}
			unlock(lockRun)
		}
		unlock(stripe(p))
		if woke {
			enqueue(p)
		}
	}
}
