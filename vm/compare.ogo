// Comparing terms: exact equality, and Erlang's order of terms, number <
// atom < reference < fun < port < pid < tuple < map < nil < list < binary,
// with no recursion: the pairs still to compare wait on a stack of their own.
// Exact comparison is the order of a map's keys, every integer before every
// float, at any depth: 1 and 1.0 are two keys, and {1} =/= {1.0}. A map's
// keys compare exactly even under ==, #{1 => a} /= #{1.0 => a}, its values as
// the comparison does; each pair waiting on the stack has its own exactness.

const cmpDepth = 64

// order ranks a term's kind in the order of terms.
func order(t uint32) uint32 {
	switch t & 3 {
	case tagSmall:
		return 0
	case tagList:
		return 9
	case tagBoxed:
		switch hdrKind(arena[boxIdx(t)]) {
		case hdrFloat, hdrInt64:
			return 0
		case hdrFun:
			return 3
		case hdrTuple:
			return 6
		case hdrMap:
			return 7
		case hdrBinary:
			return 10
		}
		return 11
	}
	switch t & 0x1f {
	case immAtom:
		return 1
	case immRef:
		return 2
	case immPid:
		return 5
	}
	return 8 // []
}

// eqExact reports whether two terms are the same, =:=.
func eqExact(s *sched, a, b uint32) bool {
	if a == b {
		return true
	}
	if a&3 != tagBoxed && a&3 != tagList || a&3 != b&3 {
		return false
	}
	return cmpExact(s, a, b) == 0
}

// cmp compares two terms in the order of terms, numbers by value whatever
// their kind as == does: negative, zero or positive. cmpExact compares them
// in map-key order.
func cmp(s *sched, a, b uint32) int      { return cmpTerms(s, a, b, false) }
func cmpExact(s *sched, a, b uint32) int { return cmpTerms(s, a, b, true) }

func cmpTerms(s *sched, a, b uint32, exact bool) int {
	sp := 0
	for {
		if a != b {
			oa, ob := order(a), order(b)
			if oa != ob {
				return int(oa) - int(ob)
			}
			r := 0
			switch oa {
			case 0:
				if exact && isFloat(a) != isFloat(b) {
					if isFloat(a) {
						return 1
					}
					return -1
				}
				r = cmpNumbers(a, b)
			case 1:
				r = cmpAtoms(a, b)
			case 2, 5:
				r = cmpWords(a, b)
			case 3:
				r = cmpWords(funCode(a), funCode(b))
			case 6, 7:
				// A map's words are its keys, then its values: by size,
				// then by keys, then by values, as Erlang orders maps.
				na, nb := tupleArity(a), tupleArity(b)
				if na != nb {
					return int(na) - int(nb)
				}
				keys := uint32(0)
				if oa == 7 {
					keys = na / 2
				}
				// The elements wait, the last deepest.
				for i := na; i >= 1; i-- {
					if sp == cmpDepth {
						panic("vm: terms nested too deeply to compare")
					}
					s.cmpA[sp] = tupleElem(a, i)
					s.cmpB[sp] = tupleElem(b, i)
					s.cmpX[sp] = exact || i <= keys
					sp++
				}
			case 9:
				// Heads first; the tails take the place of the lists.
				ia, ib := consIdx(a), consIdx(b)
				if sp == cmpDepth {
					panic("vm: terms nested too deeply to compare")
				}
				s.cmpA[sp] = arena[ia+1]
				s.cmpB[sp] = arena[ib+1]
				s.cmpX[sp] = exact
				sp++
				a, b = arena[ia], arena[ib]
				continue
			case 10:
				r = cmpBinaries(a, b)
			}
			if r != 0 {
				return r
			}
		}
		if sp == 0 {
			return 0
		}
		sp--
		a, b, exact = s.cmpA[sp], s.cmpB[sp], s.cmpX[sp]
	}
}

func cmpWords(a, b uint32) int {
	if a < b {
		return -1
	}
	if a > b {
		return 1
	}
	return 0
}

func cmpNumbers(a, b uint32) int {
	if isFloat(a) || isFloat(b) {
		fa, fb := numFloat(a), numFloat(b)
		if fa < fb {
			return -1
		}
		if fa > fb {
			return 1
		}
		return 0
	}
	va, vb := intVal(a), intVal(b)
	if va < vb {
		return -1
	}
	if va > vb {
		return 1
	}
	return 0
}

// numFloat returns a number as a float.
func numFloat(t uint32) float32 {
	if isFloat(t) {
		return floatVal(t)
	}
	return float32(intVal(t))
}

func cmpAtoms(a, b uint32) int {
	sa, sb := atomName(a), atomName(b)
	for i := 0; i < len(sa) && i < len(sb); i++ {
		if sa[i] != sb[i] {
			return int(sa[i]) - int(sb[i])
		}
	}
	return len(sa) - len(sb)
}

func cmpBinaries(a, b uint32) int {
	na, nb := binaryLen(a), binaryLen(b)
	for i := uint32(0); i < na && i < nb; i++ {
		ca, cb := binaryByte(a, i), binaryByte(b, i)
		if ca != cb {
			return int(ca) - int(cb)
		}
	}
	return int(na) - int(nb)
}
