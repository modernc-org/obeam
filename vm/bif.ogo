import (
	"math"

	"p2"
)

// The BIFs. Each takes its arguments from bargs, as many as n says, and
// answers its result, or nonValue after failWith; one that allocates asks
// ensure first and reads its arguments again after, a collection having
// perhaps moved them. biftab.ogo, generated, numbers them.

type bif func(s *sched, n uint32) uint32

type bifEntry struct {
	f     bif
	arity uint8
}

// Arithmetic. A small result stays small; one that does not fit is a 64-bit
// integer on the heap, and one that does not fit that is system_limit.

func bifAdd(s *sched, n uint32) uint32 {
	a, b := s.bargs[0], s.bargs[1]
	if isSmall(a) && isSmall(b) {
		sum := a + b
		if (a^sum)&(b^sum)>>31 == 0 {
			return sum
		}
	}
	if !isInteger(a) || !isInteger(b) {
		if isNumber(a) && isNumber(b) {
			return floatResult(s, numVal(a)+numVal(b))
		}
		return badarith(s)
	}
	va, vb := intVal(a), intVal(b)
	r := va + vb
	if (va^r)&(vb^r) < 0 {
		return failAtom(s, atomSystemLimit)
	}
	return intResult(s, r)
}

func bifSub(s *sched, n uint32) uint32 {
	a, b := s.bargs[0], s.bargs[1]
	if isSmall(a) && isSmall(b) {
		d := a - b
		if (a^b)&(a^d)>>31 == 0 {
			return d
		}
	}
	if !isInteger(a) || !isInteger(b) {
		if isNumber(a) && isNumber(b) {
			return floatResult(s, numVal(a)-numVal(b))
		}
		return badarith(s)
	}
	va, vb := intVal(a), intVal(b)
	r := va - vb
	if (va^vb)&(va^r) < 0 {
		return failAtom(s, atomSystemLimit)
	}
	return intResult(s, r)
}

func bifMul(s *sched, n uint32) uint32 {
	a, b := s.bargs[0], s.bargs[1]
	if !isInteger(a) || !isInteger(b) {
		if isNumber(a) && isNumber(b) {
			return floatResult(s, numVal(a)*numVal(b))
		}
		return badarith(s)
	}
	va, vb := intVal(a), intVal(b)
	r := va * vb
	if va != 0 && (r/va != vb || va == -1 && vb == -1<<63) {
		return failAtom(s, atomSystemLimit)
	}
	return intResult(s, r)
}

func bifDiv(s *sched, n uint32) uint32 {
	a, b := s.bargs[0], s.bargs[1]
	if !isInteger(a) || !isInteger(b) {
		return badarith(s)
	}
	va, vb := intVal(a), intVal(b)
	if vb == 0 {
		return badarith(s)
	}
	if va == -1<<63 && vb == -1 {
		return failAtom(s, atomSystemLimit)
	}
	return intResult(s, va/vb)
}

func bifRem(s *sched, n uint32) uint32 {
	a, b := s.bargs[0], s.bargs[1]
	if !isInteger(a) || !isInteger(b) {
		return badarith(s)
	}
	va, vb := intVal(a), intVal(b)
	if vb == 0 {
		return badarith(s)
	}
	if vb == -1 {
		return mkSmall(0)
	}
	return intResult(s, va%vb)
}

func bifNeg(s *sched, n uint32) uint32 {
	a := s.bargs[0]
	if !isInteger(a) {
		if isFloat(a) {
			return floatResult(s, -numVal(a))
		}
		return badarith(s)
	}
	v := intVal(a)
	if v == -1<<63 {
		return failAtom(s, atomSystemLimit)
	}
	return intResult(s, -v)
}

func bifPlus(s *sched, n uint32) uint32 {
	if !isNumber(s.bargs[0]) {
		return badarith(s)
	}
	return s.bargs[0]
}

func bifAbs(s *sched, n uint32) uint32 {
	a := s.bargs[0]
	if !isInteger(a) {
		if isFloat(a) {
			return floatResult(s, math.Abs(numVal(a)))
		}
		return badarith(s)
	}
	v := intVal(a)
	if v >= 0 {
		return a
	}
	if v == -1<<63 {
		return failAtom(s, atomSystemLimit)
	}
	return intResult(s, -v)
}

func bifBand(s *sched, n uint32) uint32 { return bitwise(s, 0) }
func bifBor(s *sched, n uint32) uint32  { return bitwise(s, 1) }
func bifBxor(s *sched, n uint32) uint32 { return bitwise(s, 2) }

func bitwise(s *sched, op int) uint32 {
	a, b := s.bargs[0], s.bargs[1]
	if !isInteger(a) || !isInteger(b) {
		return badarith(s)
	}
	va, vb := intVal(a), intVal(b)
	switch op {
	case 0:
		return intResult(s, va&vb)
	case 1:
		return intResult(s, va|vb)
	}
	return intResult(s, va^vb)
}

func bifBnot(s *sched, n uint32) uint32 {
	if !isInteger(s.bargs[0]) {
		return badarith(s)
	}
	return intResult(s, ^intVal(s.bargs[0]))
}

func bifBsl(s *sched, n uint32) uint32 {
	a, b := s.bargs[0], s.bargs[1]
	if !isInteger(a) || !isSmall(b) {
		return badarith(s)
	}
	v, sh := intVal(a), smallVal(b)
	if sh < 0 {
		return shiftRight(s, v, -sh)
	}
	if v == 0 {
		return mkSmall(0)
	}
	if sh >= 63 {
		return failAtom(s, atomSystemLimit)
	}
	r := v << uint(sh)
	if r>>uint(sh) != v {
		return failAtom(s, atomSystemLimit)
	}
	return intResult(s, r)
}

func bifBsr(s *sched, n uint32) uint32 {
	a, b := s.bargs[0], s.bargs[1]
	if !isInteger(a) || !isSmall(b) {
		return badarith(s)
	}
	v, sh := intVal(a), smallVal(b)
	if sh < 0 {
		s.bargs[1] = mkSmall(-sh)
		return bifBsl(s, 2)
	}
	return shiftRight(s, v, sh)
}

func shiftRight(s *sched, v int64, sh int32) uint32 {
	if sh >= 63 {
		if v < 0 {
			return mkSmall(-1)
		}
		return mkSmall(0)
	}
	return intResult(s, v>>uint(sh))
}

// intResult makes an integer's term, on the heap where it is not small.
func intResult(s *sched, v int64) uint32 {
	if fitsSmall(v) {
		return mkSmall(int32(v))
	}
	if !ensure(s, 3, s.curLive) {
		return nonValue
	}
	return mkInt(s, v)
}

// Comparison and boolean operators.

func bifEq(s *sched, n uint32) uint32      { return boolTerm(cmp(s, s.bargs[0], s.bargs[1]) == 0) }
func bifNe(s *sched, n uint32) uint32      { return boolTerm(cmp(s, s.bargs[0], s.bargs[1]) != 0) }
func bifEqExact(s *sched, n uint32) uint32 { return boolTerm(eqExact(s, s.bargs[0], s.bargs[1])) }
func bifNeExact(s *sched, n uint32) uint32 { return boolTerm(!eqExact(s, s.bargs[0], s.bargs[1])) }
func bifLt(s *sched, n uint32) uint32      { return boolTerm(cmp(s, s.bargs[0], s.bargs[1]) < 0) }
func bifGt(s *sched, n uint32) uint32      { return boolTerm(cmp(s, s.bargs[0], s.bargs[1]) > 0) }
func bifLe(s *sched, n uint32) uint32      { return boolTerm(cmp(s, s.bargs[0], s.bargs[1]) <= 0) }
func bifGe(s *sched, n uint32) uint32      { return boolTerm(cmp(s, s.bargs[0], s.bargs[1]) >= 0) }

func bifNot(s *sched, n uint32) uint32 {
	if !isBool(s.bargs[0]) {
		return badarg(s)
	}
	return boolTerm(s.bargs[0] == falseTerm)
}

func bifAnd(s *sched, n uint32) uint32 {
	if !isBool(s.bargs[0]) || !isBool(s.bargs[1]) {
		return badarg(s)
	}
	return boolTerm(s.bargs[0] == trueTerm && s.bargs[1] == trueTerm)
}

func bifOr(s *sched, n uint32) uint32 {
	if !isBool(s.bargs[0]) || !isBool(s.bargs[1]) {
		return badarg(s)
	}
	return boolTerm(s.bargs[0] == trueTerm || s.bargs[1] == trueTerm)
}

func bifXor(s *sched, n uint32) uint32 {
	if !isBool(s.bargs[0]) || !isBool(s.bargs[1]) {
		return badarg(s)
	}
	return boolTerm(s.bargs[0] != s.bargs[1])
}

// Lists and tuples.

// listLen returns a list's length, or -1 for what is no proper list.
func listLen(t uint32) int32 {
	n := int32(0)
	for isCons(t) {
		n++
		t = arena[consIdx(t)+1]
	}
	if t != nilTerm {
		return -1
	}
	return n
}

func bifLength(s *sched, n uint32) uint32 {
	l := listLen(s.bargs[0])
	if l < 0 {
		return badarg(s)
	}
	return mkSmall(l)
}

func bifHd(s *sched, n uint32) uint32 {
	if !isCons(s.bargs[0]) {
		return badarg(s)
	}
	return arena[consIdx(s.bargs[0])]
}

func bifTl(s *sched, n uint32) uint32 {
	if !isCons(s.bargs[0]) {
		return badarg(s)
	}
	return arena[consIdx(s.bargs[0])+1]
}

func bifElement(s *sched, n uint32) uint32 {
	i, t := s.bargs[0], s.bargs[1]
	if !isSmall(i) || !isTuple(t) || smallVal(i) < 1 || uint32(smallVal(i)) > tupleArity(t) {
		return badarg(s)
	}
	return tupleElem(t, uint32(smallVal(i)))
}

func bifSetelement(s *sched, n uint32) uint32 {
	i, t := s.bargs[0], s.bargs[1]
	if !isSmall(i) || !isTuple(t) || smallVal(i) < 1 || uint32(smallVal(i)) > tupleArity(t) {
		return badarg(s)
	}
	a := tupleArity(t)
	if !ensure(s, a+1, s.curLive) {
		return nonValue
	}
	i, t = s.bargs[0], s.bargs[1]
	from := boxIdx(t)
	d := s.cur.htop
	for k := uint32(0); k <= a; k++ {
		arena[d+k] = arena[from+k]
	}
	arena[d+uint32(smallVal(i))] = s.bargs[2]
	s.cur.htop += a + 1
	return mkBoxed(d)
}

func bifTupleSize(s *sched, n uint32) uint32 {
	if !isTuple(s.bargs[0]) {
		return badarg(s)
	}
	return mkSmall(int32(tupleArity(s.bargs[0])))
}

// Type tests, as functions.

func bifIsAtom(s *sched, n uint32) uint32      { return boolTerm(isAtom(s.bargs[0])) }
func bifIsInteger(s *sched, n uint32) uint32   { return boolTerm(isInteger(s.bargs[0])) }
func bifIsNumber(s *sched, n uint32) uint32    { return boolTerm(isNumber(s.bargs[0])) }
func bifIsFloat(s *sched, n uint32) uint32     { return boolTerm(isFloat(s.bargs[0])) }
func bifIsList(s *sched, n uint32) uint32      { return boolTerm(isList(s.bargs[0])) }
func bifIsTuple(s *sched, n uint32) uint32     { return boolTerm(isTuple(s.bargs[0])) }
func bifIsBoolean(s *sched, n uint32) uint32   { return boolTerm(isBool(s.bargs[0])) }
func bifIsFunction1(s *sched, n uint32) uint32 { return boolTerm(isFun(s.bargs[0])) }
func bifIsPid(s *sched, n uint32) uint32       { return boolTerm(isPid(s.bargs[0])) }
func bifIsReference(s *sched, n uint32) uint32 { return boolTerm(isRef(s.bargs[0])) }
func bifIsBinary(s *sched, n uint32) uint32    { return boolTerm(isBinary(s.bargs[0])) }

func bifIsFunction2(s *sched, n uint32) uint32 {
	f, a := s.bargs[0], s.bargs[1]
	if !isSmall(a) || smallVal(a) < 0 {
		return badarg(s)
	}
	return boolTerm(isFun(f) && funArity(f) == uint32(smallVal(a)))
}

func bifIsRecord3(s *sched, n uint32) uint32 {
	t, tag, size := s.bargs[0], s.bargs[1], s.bargs[2]
	if !isAtom(tag) || !isSmall(size) || smallVal(size) < 1 {
		return badarg(s)
	}
	return boolTerm(isTuple(t) && tupleArity(t) == uint32(smallVal(size)) && tupleElem(t, 1) == tag)
}

// Conversions.

func bifIntegerToList(s *sched, n uint32) uint32 {
	if !isInteger(s.bargs[0]) {
		return badarg(s)
	}
	v := intVal(s.bargs[0])
	var buf [20]byte
	i := len(buf)
	neg := v < 0
	for {
		i--
		d := v % 10
		if d < 0 {
			d = -d
		}
		buf[i] = byte('0' + d)
		v /= 10
		if v == 0 {
			break
		}
	}
	if neg {
		i--
		buf[i] = '-'
	}
	return bytesToList(s, buf[i:])
}

// bytesToList makes a list of the bytes, on the heap.
func bytesToList(s *sched, b []byte) uint32 {
	if !ensure(s, 2*uint32(len(b)), s.curLive) {
		return nonValue
	}
	t := uint32(nilTerm)
	for k := len(b) - 1; k >= 0; k-- {
		i := s.cur.htop
		arena[i] = mkSmall(int32(b[k]))
		arena[i+1] = t
		s.cur.htop += 2
		t = mkCons(i)
	}
	return t
}

func bifListToInteger(s *sched, n uint32) uint32 {
	t := s.bargs[0]
	neg := false
	if isCons(t) {
		c := arena[consIdx(t)]
		if c == mkSmall('-') || c == mkSmall('+') {
			neg = c == mkSmall('-')
			t = arena[consIdx(t)+1]
		}
	}
	if !isCons(t) {
		return badarg(s)
	}
	v := int64(0)
	for isCons(t) {
		c := arena[consIdx(t)]
		if !isSmall(c) || smallVal(c) < '0' || smallVal(c) > '9' {
			return badarg(s)
		}
		if v > (1<<63-1)/10 {
			return failAtom(s, atomSystemLimit)
		}
		v = v*10 + int64(smallVal(c)-'0')
		t = arena[consIdx(t)+1]
	}
	if t != nilTerm {
		return badarg(s)
	}
	if neg {
		v = -v
	}
	return intResult(s, v)
}

func bifAtomToList(s *sched, n uint32) uint32 {
	if !isAtom(s.bargs[0]) {
		return badarg(s)
	}
	name := atomName(s.bargs[0])
	if !ensure(s, 2*uint32(nameLen(name)), s.curLive) {
		return nonValue
	}
	return nameList(s, name)
}

// bifAppend is ++: the first list copied, the second its tail.
func bifAppend(s *sched, n uint32) uint32 {
	l := listLen(s.bargs[0])
	if l < 0 {
		return badarg(s)
	}
	if l == 0 {
		return s.bargs[1]
	}
	if !ensure(s, 2*uint32(l), s.curLive) {
		return nonValue
	}
	return appendList(s, s.bargs[0], s.bargs[1])
}

// appendList copies a proper list onto the heap, giving it a tail; the room
// has been made.
func appendList(s *sched, from, tail uint32) uint32 {
	first := s.cur.htop
	prev := uint32(0)
	for isCons(from) {
		i := s.cur.htop
		arena[i] = arena[consIdx(from)]
		if prev != 0 {
			arena[prev+1] = mkCons(i)
		}
		prev = i
		s.cur.htop += 2
		from = arena[consIdx(from)+1]
	}
	arena[prev+1] = tail
	return mkCons(first)
}

// bifSubtract is --: every element of the second list takes the first
// element of the first that it equals. The second list is 256 elements at
// most.
func bifSubtract(s *sched, n uint32) uint32 {
	l := listLen(s.bargs[0])
	m := listLen(s.bargs[1])
	if l < 0 || m < 0 {
		return badarg(s)
	}
	if m > 256 {
		return failAtom(s, atomSystemLimit)
	}
	if !ensure(s, 2*uint32(l), s.curLive) {
		return nonValue
	}
	var taken [8]uint32 // a bit per element of the second list
	a, b := s.bargs[0], s.bargs[1]
	first := uint32(0)
	prev := uint32(0)
	for isCons(a) {
		e := arena[consIdx(a)]
		a = arena[consIdx(a)+1]
		k := uint32(0)
		found := false
		for t := b; isCons(t); t = arena[consIdx(t)+1] {
			if taken[k/32]>>(k%32)&1 == 0 && eqExact(s, e, arena[consIdx(t)]) {
				taken[k/32] |= 1 << (k % 32)
				found = true
				break
			}
			k++
		}
		if found {
			continue
		}
		i := s.cur.htop
		arena[i] = e
		arena[i+1] = nilTerm
		if prev != 0 {
			arena[prev+1] = mkCons(i)
		} else {
			first = i
		}
		prev = i
		s.cur.htop += 2
	}
	if prev == 0 {
		return nilTerm
	}
	return mkCons(first)
}

func bifMin(s *sched, n uint32) uint32 {
	if cmp(s, s.bargs[0], s.bargs[1]) <= 0 {
		return s.bargs[0]
	}
	return s.bargs[1]
}

func bifMax(s *sched, n uint32) uint32 {
	if cmp(s, s.bargs[0], s.bargs[1]) >= 0 {
		return s.bargs[0]
	}
	return s.bargs[1]
}

// Processes, exceptions, time.

func bifSelf(s *sched, n uint32) uint32 { return s.cur.pid() }

// bifMakeRef makes a reference: the scheduler's number and its count, so
// that no two schedulers make the same.
func bifMakeRef(s *sched, n uint32) uint32 {
	s.refs++
	return mkRef(s.id<<24 | s.refs&0xffffff)
}

func bifError1(s *sched, n uint32) uint32 { return failWith(s, atomError, s.bargs[0]) }
func bifError2(s *sched, n uint32) uint32 { return failWith(s, atomError, s.bargs[0]) }
func bifExit1(s *sched, n uint32) uint32  { return failWith(s, atomExit, s.bargs[0]) }
func bifThrow(s *sched, n uint32) uint32  { return failWith(s, atomThrow, s.bargs[0]) }

func bifDisplay(s *sched, n uint32) uint32 {
	lock(lockOut)
	writeTerm(s, s.bargs[0], false)
	emit(s, '\n')
	unlock(lockOut)
	return trueTerm
}

func millis() int64 { return int64(now()) }

func bifMonotonicTime0(s *sched, n uint32) uint32 { return intResult(s, millis()*1000000) }

func bifMonotonicTime1(s *sched, n uint32) uint32 {
	ms := millis()
	switch s.bargs[0] {
	case mkAtom(atomMillisecond):
		return intResult(s, ms)
	case mkAtom(atomMicrosecond):
		return intResult(s, ms*1000)
	case mkAtom(atomNanosecond), mkAtom(atomNative):
		return intResult(s, ms*1000000)
	case mkAtom(atomSecond):
		return intResult(s, ms/1000)
	}
	if isSmall(s.bargs[0]) && smallVal(s.bargs[0]) > 0 {
		return intResult(s, ms*int64(smallVal(s.bargs[0]))/1000)
	}
	return badarg(s)
}

// The lists module's BIFs.

func bifListsReverse1(s *sched, n uint32) uint32 {
	s.bargs[1] = nilTerm
	return bifListsReverse2(s, 2)
}

func bifListsReverse2(s *sched, n uint32) uint32 {
	l := listLen(s.bargs[0])
	if l < 0 {
		return badarg(s)
	}
	if !ensure(s, 2*uint32(l), s.curLive) {
		return nonValue
	}
	from, t := s.bargs[0], s.bargs[1]
	for isCons(from) {
		i := s.cur.htop
		arena[i] = arena[consIdx(from)]
		arena[i+1] = t
		s.cur.htop += 2
		t = mkCons(i)
		from = arena[consIdx(from)+1]
	}
	return t
}

func bifListsMember(s *sched, n uint32) uint32 {
	e, t := s.bargs[0], s.bargs[1]
	for isCons(t) {
		if eqExact(s, e, arena[consIdx(t)]) {
			return trueTerm
		}
		t = arena[consIdx(t)+1]
	}
	if t != nilTerm {
		return badarg(s)
	}
	return falseTerm
}

func bifListsKeyfind(s *sched, n uint32) uint32 {
	key, pos, t := s.bargs[0], s.bargs[1], s.bargs[2]
	if !isSmall(pos) || smallVal(pos) < 1 {
		return badarg(s)
	}
	k := uint32(smallVal(pos))
	for isCons(t) {
		e := arena[consIdx(t)]
		if isTuple(e) && tupleArity(e) >= k && cmp(s, tupleElem(e, k), key) == 0 {
			return e
		}
		t = arena[consIdx(t)+1]
	}
	if t != nilTerm {
		return badarg(s)
	}
	return falseTerm
}

// The io module's BIFs.

// The io BIFs write under the output's lock, so that a line is one process's.

func bifIoFormat1(s *sched, n uint32) uint32 {
	lock(lockOut)
	ok := format(s, s.bargs[0], nilTerm)
	unlock(lockOut)
	if !ok {
		return badarg(s)
	}
	return okTerm
}

func bifIoFormat2(s *sched, n uint32) uint32 {
	lock(lockOut)
	ok := format(s, s.bargs[0], s.bargs[1])
	unlock(lockOut)
	if !ok {
		return badarg(s)
	}
	return okTerm
}

func bifIoPutChars(s *sched, n uint32) uint32 {
	lock(lockOut)
	ok := writeChars(s, s.bargs[0])
	unlock(lockOut)
	if !ok {
		return badarg(s)
	}
	return okTerm
}

func bifIoNl(s *sched, n uint32) uint32 {
	lock(lockOut)
	emit(s, '\n')
	unlock(lockOut)
	return okTerm
}

// The p2 module's BIFs, through the hooks; a hook that is nil does nothing.

func pinArg(s *sched) (int, bool) {
	if !isSmall(s.bargs[0]) || smallVal(s.bargs[0]) < 0 || smallVal(s.bargs[0]) > 63 {
		return 0, false
	}
	return int(smallVal(s.bargs[0])), true
}

func bifP2PinHigh(s *sched, n uint32) uint32 {
	pin, ok := pinArg(s)
	if !ok {
		return badarg(s)
	}
	if PinsServed {
		postPin(PinHighOp, pin, 0)
	}
	return okTerm
}

func bifP2PinLow(s *sched, n uint32) uint32 {
	pin, ok := pinArg(s)
	if !ok {
		return badarg(s)
	}
	if PinsServed {
		postPin(PinLowOp, pin, 0)
	}
	return okTerm
}

func bifP2PinToggle(s *sched, n uint32) uint32 {
	pin, ok := pinArg(s)
	if !ok {
		return badarg(s)
	}
	if PinsServed {
		postPin(PinToggleOp, pin, 0)
	}
	return okTerm
}

func bifP2PinFloat(s *sched, n uint32) uint32 {
	pin, ok := pinArg(s)
	if !ok {
		return badarg(s)
	}
	if PinsServed {
		postPin(PinFloatOp, pin, 0)
	}
	return okTerm
}

func bifP2PinIn(s *sched, n uint32) uint32 {
	pin, ok := pinArg(s)
	if !ok {
		return badarg(s)
	}
	if !PinsServed {
		return mkSmall(0)
	}
	return mkSmall(int32(readPin(pin)))
}

func bifP2PinWrite(s *sched, n uint32) uint32 {
	pin, ok := pinArg(s)
	if !ok || !isSmall(s.bargs[1]) {
		return badarg(s)
	}
	if PinsServed {
		postPin(PinWriteOp, pin, int(smallVal(s.bargs[1])))
	}
	return okTerm
}

// bifP2Cog answers which scheduler the process runs on at the moment, 0 to
// 6; the cog's own number OctoGo does not tell.
func bifP2Cog(s *sched, n uint32) uint32 {
	return mkSmall(int32(s.id))
}

func bifP2GetCt(s *sched, n uint32) uint32 {
	return intResult(s, int64(p2.GetCt()))
}

func bifP2ClockFreq(s *sched, n uint32) uint32 {
	return intResult(s, int64(p2.ClockFreq()))
}

func bifP2Rnd(s *sched, n uint32) uint32 {
	return intResult(s, int64(p2.Rnd()))
}

// Processes: spawn, send, apply.

// findFunction returns the code offset of a function of the image by its
// module and function atoms and arity.
func findFunction(m, f, arity uint32) (uint32, bool) {
	for i := 0; i+3 < len(funcs); i += 4 {
		if mkAtom(funcs[i+1]) == m && mkAtom(funcs[i+2]) == f && funcs[i+3]&0xff == arity {
			return funcs[i], true
		}
	}
	return 0, false
}

// bifByName answers the number of the BIF a module, a function and an
// arity name, if there is one: one whose module and function are well-known
// atoms.
func bifByName(m, f, arity uint32) (uint32, bool) {
	for i := range bifs {
		b := bifNames[i]
		if uint32(bifs[i].arity) == arity && mkAtom(b.module) == m && mkAtom(b.function) == f {
			return uint32(i), true
		}
	}
	return 0, false
}

// listToArgs puts a list's elements in bargs and answers how many, or -1
// for what is no list of at most maxArity.
func listToX(s *sched, l uint32) int32 {
	n := int32(0)
	for isCons(l) {
		if n == maxArity {
			return -1
		}
		s.x[n] = arena[consIdx(l)]
		n++
		l = arena[consIdx(l)+1]
	}
	if l != nilTerm {
		return -1
	}
	return n
}

// spawnAt makes a process to run the code at entry with the n arguments in
// x0 and up, copied to its heap with their roots on its stack, and queues it.
func spawnAt(s *sched, entry, n uint32) uint32 {
	longs := uint32(0)
	for i := uint32(0); i < n; i++ {
		size := termSize(s, s.x[i])
		if size < 0 {
			return failAtom(s, atomSystemLimit)
		}
		longs += uint32(size)
	}
	p := spawn(entry, n, longs)
	if p == nil {
		return failAtom(s, atomSystemLimit)
	}
	p.stop -= n
	for i := uint32(0); i < n; i++ {
		root, end := copyTerm(s, s.x[i], p.htop)
		arena[p.stop+i] = root
		p.htop = end
	}
	enqueue(p)
	return p.pid()
}

// bifSpawn1 spawns a fun of no arguments: its environment is what the new
// process begins with.
func bifSpawn1(s *sched, n uint32) uint32 {
	f := s.bargs[0]
	if !isFun(f) || funArity(f) != 0 || funKind(f) == funBif {
		return badarg(s)
	}
	free := funFree(f)
	i := boxIdx(f) + 1 + funHeadLongs
	for k := uint32(0); k < free; k++ {
		s.x[k] = arena[i+k]
	}
	return spawnAt(s, funCode(f), free)
}

// bifSpawn3 spawns a function of the image by name, with a list of arguments.
func bifSpawn3(s *sched, n uint32) uint32 {
	m, f, args := s.bargs[0], s.bargs[1], s.bargs[2]
	if !isAtom(m) || !isAtom(f) {
		return badarg(s)
	}
	na := listToX(s, args)
	if na < 0 {
		return badarg(s)
	}
	entry, ok := findFunction(m, f, uint32(na))
	if !ok {
		return failAtom(s, atomUndef)
	}
	return spawnAt(s, entry, uint32(na))
}

func bifSend(s *sched, n uint32) uint32 {
	if !sendMsg(s, s.bargs[0], s.bargs[1]) {
		return nonValue
	}
	return s.bargs[1]
}

// bifApply3 calls a function of the image by name with a list of arguments:
// the arguments go to x0 and up and the handler jumps. A BIF's go to bargs
// and the handler calls it.
func bifApply3(s *sched, n uint32) uint32 {
	m, f, args := s.bargs[0], s.bargs[1], s.bargs[2]
	if !isAtom(m) || !isAtom(f) {
		return badarg(s)
	}
	na := listToX(s, args)
	if na < 0 {
		return badarg(s)
	}
	if entry, ok := findFunction(m, f, uint32(na)); ok {
		s.bifJump = entry
		s.bifLive = uint32(na)
		return jumpValue
	}
	if i, ok := bifByName(m, f, uint32(na)); ok {
		for k := int32(0); k < na; k++ {
			s.bargs[k] = s.x[k]
		}
		s.nbargs = uint32(na)
		s.bifJump = i
		return bifValue
	}
	// The stacktrace begins with the function that is not there.
	if ensure(s, 5, s.curLive) {
		i := s.cur.htop
		arena[i] = mkHeader(hdrTuple, 4)
		arena[i+1] = s.bargs[0]
		arena[i+2] = s.bargs[1]
		arena[i+3] = s.bargs[2]
		arena[i+4] = nilTerm
		s.cur.htop += 5
		s.head = mkBoxed(i)
	}
	return failAtom(s, atomUndef)
}

// bifApply2 calls a fun with a list of arguments.
func bifApply2(s *sched, n uint32) uint32 {
	f, args := s.bargs[0], s.bargs[1]
	if !isFun(f) {
		return failWith(s, atomError, f)
	}
	na := listToX(s, args)
	if na < 0 {
		return badarg(s)
	}
	if funArity(f) != uint32(na) {
		return failWith(s, atomError, f)
	}
	if funKind(f) == funBif {
		for k := int32(0); k < na; k++ {
			s.bargs[k] = s.x[k]
		}
		s.nbargs = uint32(na)
		s.bifJump = funCode(f)
		return bifValue
	}
	free := funFree(f)
	i := boxIdx(f) + 1 + funHeadLongs
	for k := uint32(0); k < free; k++ {
		s.x[uint32(na)+k] = arena[i+k]
	}
	s.bifJump = funCode(f)
	s.bifLive = uint32(na) + free
	return jumpValue
}

func bifIsProcessAlive(s *sched, n uint32) uint32 {
	pid := s.bargs[0]
	if !isPid(pid) {
		return badarg(s)
	}
	p := procOf(pid)
	lock(stripe(p))
	alive := p.alive(pid)
	unlock(stripe(p))
	return boolTerm(alive)
}

// bifFunctionExported is erlang:function_exported/3: whether a function of
// the image is exported, or a BIF is, as OTP's answers for one implemented
// in C. A function the packer left out, as unreachable, is not there.
func bifFunctionExported(s *sched, n uint32) uint32 {
	m, f, a := s.bargs[0], s.bargs[1], s.bargs[2]
	if !isAtom(m) || !isAtom(f) || !isSmall(a) || smallVal(a) < 0 {
		return badarg(s)
	}
	arity := uint32(smallVal(a))
	for k := 0; k+3 < len(funcs); k += 4 {
		if funcs[k+1] == atomIdx(m) && funcs[k+2] == atomIdx(f) && funcs[k+3]&0xff == arity {
			return boolTerm(funcs[k+3]&0x100 != 0)
		}
	}
	_, ok := bifByName(m, f, arity)
	return boolTerm(ok)
}

// A bifName is a BIF's module and function, as indexes of well-known atoms.
type bifName struct {
	module, function uint32
}

const noAtom = 0xffffffff

// bifRaise3 is erlang:raise/3 called by name rather than compiled to
// raw_raise: the class and the reason are raised, with the stack as it is.
func bifRaise3(s *sched, n uint32) uint32 {
	if !isClass(s.bargs[0]) {
		return mkAtom(atomBadarg)
	}
	s.raiseRaw = s.bargs[2]
	return failWith(s, atomIdx(s.bargs[0]), s.bargs[1])
}

// Links, monitors, signals and names.

// bifSpawnLink1 and bifSpawnLink3 spawn as spawn does and link the new process
// with the caller. With the pool of links out of records, which Erlang would
// make system_limit before spawning, the new process runs unlinked.
func bifSpawnLink1(s *sched, n uint32) uint32 {
	pid := bifSpawn1(s, n)
	if pid != nonValue {
		linkBoth(s, pid)
	}
	return pid
}

func bifSpawnLink3(s *sched, n uint32) uint32 {
	pid := bifSpawn3(s, n)
	if pid != nonValue {
		linkBoth(s, pid)
	}
	return pid
}

// linkBoth links the running process and another, each to the other; it
// reports whether the other lives, and whether the pool had room for both
// ends, the link being made in full or not at all.
func linkBoth(s *sched, pid uint32) (alive, room bool) {
	self := s.cur.pid()
	alive, room = linkTo(pid, self)
	if !alive || !room {
		return alive, room
	}
	if _, room = linkTo(self, pid); !room {
		unlinkFrom(pid, self)
	}
	return true, room
}

// bifLink links to a process; one that is gone is noproc, an error, or
// {'EXIT', Pid, noproc} for a process that traps exits.
func bifLink(s *sched, n uint32) uint32 {
	pid := s.bargs[0]
	if !isPid(pid) {
		return badarg(s)
	}
	if pid == s.cur.pid() {
		return trueTerm
	}
	alive, room := linkBoth(s, pid)
	if !room {
		return failAtom(s, atomSystemLimit)
	}
	if alive {
		return trueTerm
	}
	if !s.cur.trapExit {
		return failAtom(s, atomNoproc)
	}
	if !ensure(s, 4, s.curLive) {
		return nonValue
	}
	pid = s.bargs[0]
	i := s.cur.htop
	arena[i] = mkHeader(hdrTuple, 3)
	arena[i+1] = mkAtom(atomEXIT)
	arena[i+2] = pid
	arena[i+3] = mkAtom(atomNoproc)
	s.cur.htop += 4
	deliver(s, s.cur.pid(), mkBoxed(i), kindExit)
	return trueTerm
}

func bifUnlink(s *sched, n uint32) uint32 {
	pid := s.bargs[0]
	if !isPid(pid) {
		return badarg(s)
	}
	self := s.cur.pid()
	unlinkFrom(pid, self)
	unlinkFrom(self, pid)
	return trueTerm
}

// bifExit2 sends an exit signal: to the running process itself it is the
// exception, or a message when it traps exits; to another it is delivered as
// a signal.
func bifExit2(s *sched, n uint32) uint32 {
	pid, reason := s.bargs[0], s.bargs[1]
	if !isPid(pid) {
		return badarg(s)
	}
	self := s.cur.pid()
	if pid == self && (!s.cur.trapExit || reason == mkAtom(atomKill)) {
		if reason == mkAtom(atomKill) {
			reason = mkAtom(atomKilled)
		}
		return failWith(s, atomExit, reason)
	}
	if !ensure(s, 4, s.curLive) {
		return nonValue
	}
	pid, reason = s.bargs[0], s.bargs[1]
	i := s.cur.htop
	arena[i] = mkHeader(hdrTuple, 3)
	arena[i+1] = mkAtom(atomEXIT)
	arena[i+2] = self
	arena[i+3] = reason
	s.cur.htop += 4
	if !deliver(s, pid, mkBoxed(i), kindExit) {
		return failAtom(s, atomSystemLimit)
	}
	return trueTerm
}

// bifProcessFlag sets trap_exit and answers the old value; other flags are
// not here.
func bifProcessFlag(s *sched, n uint32) uint32 {
	if s.bargs[0] != mkAtom(atomTrapExit) || !isBool(s.bargs[1]) {
		return badarg(s)
	}
	p := s.cur
	lock(stripe(p))
	old := p.trapExit
	p.trapExit = s.bargs[1] == trueTerm
	unlock(stripe(p))
	return boolTerm(old)
}

func bifRegister(s *sched, n uint32) uint32 {
	atom, pid := s.bargs[0], s.bargs[1]
	if !isAtom(atom) || atom == mkAtom(atomUndefined) || !isPid(pid) {
		return badarg(s)
	}
	q := procOf(pid)
	lock(stripe(q))
	alive := q.alive(pid)
	unlock(stripe(q))
	if !alive {
		return badarg(s)
	}
	lock(lockProcs)
	free := -1
	for i := range names {
		if names[i].atom == atom || names[i].atom != 0 && names[i].pid == pid {
			unlock(lockProcs)
			return badarg(s)
		}
		if names[i].atom == 0 && free < 0 {
			free = i
		}
	}
	if free < 0 {
		unlock(lockProcs)
		return failAtom(s, atomSystemLimit)
	}
	names[free].atom = atom
	names[free].pid = pid
	unlock(lockProcs)
	return trueTerm
}

func bifUnregister(s *sched, n uint32) uint32 {
	atom := s.bargs[0]
	lock(lockProcs)
	for i := range names {
		if names[i].atom == atom {
			names[i].atom = 0
			unlock(lockProcs)
			return trueTerm
		}
	}
	unlock(lockProcs)
	return badarg(s)
}

func bifWhereis(s *sched, n uint32) uint32 {
	if !isAtom(s.bargs[0]) {
		return badarg(s)
	}
	if pid, ok := whereis(s.bargs[0]); ok {
		return pid
	}
	return mkAtom(atomUndefined)
}

// bifMonitor2 monitors a process: {'DOWN', Ref, process, Pid, Reason} comes
// when it ends, at once with noproc when it is gone.
func bifMonitor2(s *sched, n uint32) uint32 {
	pid := s.bargs[1]
	if s.bargs[0] != mkAtom(atomProcess) || !isPid(pid) {
		return badarg(s)
	}
	s.refs++
	ref := mkRef(s.id<<24 | s.refs&0xffffff)
	self := s.cur.pid()
	// The watcher's end first: a process that ends between the two steps
	// finds it, and takes it out as it sends the DOWN.
	p := s.cur
	lock(stripe(p))
	room := relAdd(p, relWatch, pid, ref)
	unlock(stripe(p))
	if !room {
		return failAtom(s, atomSystemLimit)
	}
	q := procOf(pid)
	lock(stripe(q))
	alive := q.alive(pid)
	if alive {
		room = relAdd(q, relMon, self, ref)
	}
	unlock(stripe(q))
	if !alive || !room {
		lock(stripe(p))
		relDrop(p, relWatch, 0, ref)
		unlock(stripe(p))
	}
	if !room {
		return failAtom(s, atomSystemLimit)
	}
	if !alive {
		if !ensure(s, 6, s.curLive) {
			return nonValue
		}
		i := p.htop
		arena[i] = mkHeader(hdrTuple, 5)
		arena[i+1] = mkAtom(atomDOWN)
		arena[i+2] = ref
		arena[i+3] = mkAtom(atomProcess)
		arena[i+4] = s.bargs[1]
		arena[i+5] = mkAtom(atomNoproc)
		p.htop += 6
		deliver(s, self, mkBoxed(i), kindMessage)
	}
	return ref
}

// bifDemonitor1 ends a monitor; a {'DOWN', ...} already in the mailbox stays,
// as without the flush option.
func bifDemonitor1(s *sched, n uint32) uint32 {
	ref := s.bargs[0]
	if !isRef(ref) {
		return badarg(s)
	}
	p := s.cur
	lock(stripe(p))
	pid := relDrop(p, relWatch, 0, ref)
	unlock(stripe(p))
	if pid != 0 {
		relDropFrom(pid, relMon, 0, ref)
	}
	return trueTerm
}

func bifDemonitor2(s *sched, n uint32) uint32 { return bifDemonitor1(s, 1) }
